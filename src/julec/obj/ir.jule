use "julec/env"
use "std/jule"
use "std/jule/ast"
use "std/jule/importer"
use "std/jule/log"
use "std/jule/sema"
use "std/jule/token"
use "std/slices"
use "std/strings"

const (
	// Globals always have dependencies from their own packages or used packages.
	// So analysis is easy to predict. But structures, since they can be generic,
	// may refer to hard to analysis things. This occurs because we have
	// internally imported packages such as runtime. And the runtime package
	// may refer to any define of the program, without dependency.
	// So declare them first, then implement all of them after all types.
	// This is decent because all generic runtime implementations
	// referred by pointers, no risk for incomplate type errors.
	// To detect generic runtime implementations, use this custom flag.
	F_GENERIC_RUNTIME_IMPL = 1 << (ast::F_CUSTOMS_IOTA + iota)
)

// Intermediate representation of the code for compiler.
struct IR {
	Root:      string            // Directory of the root package.
	Passes:    [][]string        // All unique pass directives.
	Runtime:   &sema::ImportInfo // ImportInfo instance of the "std/runtime" package.
	Intrinsic: &sema::ImportInfo // ImportInfo instance of the "std/intrinsic" package.
	Ordered:   OrderedDefines    // Ordered defines, nil by default. Initialized by the Order method.

	// The importer of the IR.
	Importer: sema::Importer

	// The main package. Not including in the Used.
	// The Last dependency of the program, root package of the program.
	Main: &sema::Package

	// Imported packages for whole program.
	// Ordered by first-to-last package.
	// So, deeply the first use declaration is 0-indexed, then comes others.
	Used: []&sema::ImportInfo
}

impl IR {
	// Returns compiler IR of source code.
	// Returned IR is lexed, parsed, and analyzed.
	//
	// - Returns (nil, nil) logs if path has not any Jule file.
	// - Returns (nil, logs) if exist any log.
	// - Returns IR and nil logs if everything is fine.
	//
	// The pass directives will not be handled.
	// To handle them properly, use the [CollectPasses].
	fn Build(path: string, flags: int): (&IR, []log::Log) {
		mut ir := &IR{
			Root: path,
		}

		// Setup importer.
		ir.Importer = importer::New(buildCompileInfo())

		const UpdateMod = true // Detect and use the root module for the main package if exist.
		mut files, mut logs := ir.Importer.ImportPackage(path, UpdateMod)
		if len(logs) > 0 {
			return nil, logs
		}

		if len(files) == 0 {
			return nil, nil
		}

		// Register the main module, if exist.
		ir.Importer.RegisterMod()
		ir.Importer.SetMainPackagePath(path)

		// Push runtime package to first file.
		// Each Jule program should import this standard package.
		mut firstFile := files[0]
		pushInternalRuntimeBuiltinToAST(firstFile)
		pushRuntimeToAST(firstFile) // Must be the last import.

		mut pkg, logs := sema::AnalyzePackage(files, ir.Importer, flags)
		if len(logs) > 0 {
			return nil, logs
		}

		// Collect data.
		ir.Used = ir.Importer.AllPackages()

		// Set up special packages.
		ir.Main = pkg
		ir.Runtime = pkg.Files[0].Imports[0] // runtime package
		ir.Intrinsic = SelectImport(ir.Used, "std/intrinsic")

		return ir, nil
	}
}

impl IR {
	// Collects all pass directives of the IR and stores them in [Passes].
	// Eliminates duplicated directives.
	// Appending custom directives before this function is allowed.
	fn CollectPasses(mut *self) {
		pushPasses(self.Main, &self.Passes)
		for (_, mut u) in self.Used {
			if !u.Extern {
				pushPasses(u.Package, &self.Passes)
			}
		}
	}

	fn appendStructs(*self, mut p: &sema::Package, mut &buffer: *[]&sema::Struct) {
		for (_, mut f) in p.Files {
			for (_, mut s) in f.Structs {
				match p {
				| self.Runtime.Package:
					if len(s.AST.Generics) > 0 {
						s.AST.Flags |= F_GENERIC_RUNTIME_IMPL
					}
				| self.Intrinsic.Package:
					// Skip intrinsics.
					continue
				}
				if s.AST.Flags&ast::F_EXTERN == 0 {
					*buffer = append(*buffer, s)
				}
			}
			for (_, mut ta) in f.TypeAliases {
				if ta.AST.Flags&ast::F_EXTERN == 0 &&
					ta.AST.Flags&ast::F_STRICT != 0 {
					match p {
					| self.Runtime.Package:
						if len(ta.AST.Generics) > 0 {
							ta.AST.Flags |= F_GENERIC_RUNTIME_IMPL
						}
					| self.Intrinsic.Package:
						// Skip intrinsics.
						continue
					}
					*buffer = append(*buffer, ta.Type.Kind.(&sema::StructIns).Decl)
				}
			}
		}
	}

	// Returns all structures of main package and used packages.
	// Ignores external declarations, but appends strict type alias structures also.
	// If orderDefs is true, orders defines of each package.
	// Appends used packages first, then the main package.
	// Appends range data to the Ordered data.
	fn getAllStructures(mut *self, orderDefs: bool): []&sema::Struct {
		// For ordering, all structures should be easy to predict.
		// They must only have dependency from their own package or used packages.
		//
		// Structures, since they can be generic, may refer to hard to analysis things.
		// This occurs because we have internally imported packages such as runtime.
		// And the runtime package may refer to any define of the program, without dependency.
		// So we should import all and order them for correct ordering.
		// However, we can not do this but it is fine.
		// Because any runtime structure will not use types directly,
		// they use pointers to types, which is will not cause any
		// C++ back-end compiler error.
		//
		// Another issue is the dependent types to runtime.
		// If any dependency package, referred by the runtime package,
		// should not use runtime-implemented types.
		// It may introduce ordering issues and cause compile errors.
		let mut buffer: []&sema::Struct = nil
		mut n := len(buffer)
		for (_, mut u) in self.Used {
			if !u.Extern {
				self.appendStructs(u.Package, &buffer)
				if orderDefs {
					order(self.Importer, buffer[n:], true)
				}
				mut ranges := self.Ordered.Ranges[u.Package]
				ranges[0] = [n, len(buffer)]
				self.Ordered.Ranges[u.Package] = ranges
				n = len(buffer)
			}
		}
		self.appendStructs(self.Main, &buffer)
		if orderDefs {
			order(self.Importer, buffer[n:], true)
		}
		mut ranges := self.Ordered.Ranges[self.Main]
		ranges[0] = [n, len(buffer)]
		self.Ordered.Ranges[self.Main] = ranges
		return buffer
	}

	fn appendGlobals(*self, mut p: &sema::Package, mut &buffer: *[]&sema::Var) {
		for (_, mut f) in p.Files {
			for (_, mut v) in f.Vars {
				if v.AST.Token != nil &&
					v.AST.Flags&(ast::F_CONST|ast::F_EXTERN) == 0 {
					*buffer = append(*buffer, v)
				}
			}
		}
	}

	// Returns all globals of main package and used packages.
	// Ignores external declarations and constants.
	// If orderDefs is true, orders defines of each package.
	// Appends used packages first, then the main package.
	// Appends range data to the Ordered data.
	fn GetAllGlobals(mut *self, orderDefs: bool): []&sema::Var {
		// For ordering, all variables should be easy to predict.
		// They must only have dependency from their own package or used packages.
		// So, appending globals by used (should be deeply ordered already,
		// from deeply first dependency to last dependency which is root package)
		// should be enough. Therefore, perform partial ordering, just for package.
		// Also globals should be initialized before other packages, by use order.
		// So, non-partial ordering may break this initialization order.
		// This order strategy keeps also the package initialization order.
		let mut buffer: []&sema::Var = nil
		mut n := len(buffer)
		for (_, mut u) in self.Used {
			if !u.Extern {
				self.appendGlobals(u.Package, &buffer)
				if orderDefs {
					order(self.Importer, buffer[n:], true)
				}
				mut ranges := self.Ordered.Ranges[u.Package]
				ranges[1] = [n, len(buffer)]
				self.Ordered.Ranges[u.Package] = ranges
				n = len(buffer)
			}
		}
		self.appendGlobals(self.Main, &buffer)
		if orderDefs {
			order(self.Importer, buffer[n:], true)
		}
		mut ranges := self.Ordered.Ranges[self.Main]
		ranges[1] = [n, len(buffer)]
		self.Ordered.Ranges[self.Main] = ranges
		return buffer
	}

	// Orders defines for initialization by dependencies.
	fn Order(mut *self) {
		// Initialize ranges map.
		self.Ordered.Ranges = make(map[&sema::Package][2][2]int)
		// Get globals with internal ordering enabled.
		// See the GetAllGlobals for the ordering details.
		self.Ordered.Globals = self.GetAllGlobals(true)
		// Get structures with internal ordering enabled.
		// See the GetAllStructures for the ordering details.
		self.Ordered.Structs = self.getAllStructures(true)
	}
}

// Package-based implementation of the [IR.CollectPasses].
fn pushPasses(mut p: &sema::Package, mut &passes: *[][]string) {
	for (_, mut f) in p.Files {
	Iter:
		for (_, mut pass) in f.Passes {
			for _, cpass in *passes {
				if slices::Equal(cpass, pass.Args) {
					continue Iter
				}
			}
			*passes = append(*passes, pass.Args)
		}
	}
}

fn buildCompileInfo(): importer::CompileInfo {
	mut info := importer::CompileInfo{
		Prod: env::Production,
		Test: env::Test,
		Tags: env::Tags,
	}

	match env::Compiler {
	| importer::Compiler.Clang:
		info.Compiler = importer::Compiler.Clang
	| importer::Compiler.GCC:
		info.Compiler = importer::Compiler.GCC
	}

	match env::CppStd {
	| importer::CppStd.Cpp20:
		info.CppStd = importer::CppStd.Cpp20
	}

	return info
}

// See "std/jule" developer reference (8).
fn pushRuntimeToAST(mut f: &ast::AST) {
	mut decl := &ast::Use{
		Token: nil, // Nil token is a flag for implicit declaration.
		Path: &token::Token{
			ID:   token::STRING,
			Kind: `"std/runtime"`,
		},
		Alias: nil,
	}
	f.UseDecls = slices::Insert(f.UseDecls, 0, decl)
}

// See "std/jule" developer reference (8).
fn pushInternalRuntimeBuiltinToAST(mut f: &ast::AST) {
	mut decl := &ast::Use{
		Token: nil, // Nil token is a flag for implicit declaration.
		Path: &token::Token{
			ID:   token::STRING,
			Kind: `"std/internal/runtime/builtin"`,
		},
		Alias: nil,
	}
	f.UseDecls = slices::Insert(f.UseDecls, 0, decl)
}