use "std/jule/ast"
use "std/jule/build"
use "std/jule/log"
use "std/jule/token"
use "std/slices"

fn newScope(): &ast::Scope {
	return new(ast::Scope)
}

struct scopeParser {
	p:    &parser
	s:    &ast::Scope
	scan: scanner
	stmt: stmt
}

impl scopeParser {
	fn pushErr(mut *self, token: &token::Token, fmt: string, args: ...any) {
		self.p.pushErr(token, fmt, args...)
	}

	// Push suggestion to last log.
	fn pushSuggestion(mut *self, fmt: string, args: ...any) {
		self.p.pushSuggestion(fmt, args...)
	}

	fn buildScope(mut *self, mut tokens: []&token::Token, mut end: &token::Token): &ast::Scope {
		mut s := newScope()
		s.Parent = self.s
		s.End = end
		mut ssp := scopeParser{
			p: self.p,
		}
		ssp.build(tokens, s)
		return s
	}

	fn buildVarStmt(mut *self, mut tokens: []&token::Token): &ast::Var {
		mut v := self.p.buildVar(tokens)
		if v != nil {
			v.Scope = self.s
		}
		return v
	}

	fn buildReturnStmt(mut *self, mut tokens: []&token::Token): &ast::Return {
		mut st := &ast::Return{
			Token: tokens[0],
		}
		if len(tokens) > 1 {
			tokens = tokens[1:] // Remove return keyword.
			st.X = self.p.buildExpr(tokens)
		}
		return st
	}

	fn buildWhileNextIter(mut *self, mut &stmt: *stmt): &ast::Iter {
		mut it := &ast::Iter{
			Token: stmt.tokens[0],
		}
		mut tokens := stmt.tokens[1:] // Skip "iter" keyword.
		mut kind := new(ast::WhileKind)

		if len(tokens) > 0 {
			kind.X = self.p.buildExpr(tokens)
			if kind.X == nil {
				return nil
			}
			_, ok := kind.X.Data.(&ast::TupleExpr)
			if ok {
				self.pushErr(kind.X.Token, "expected 1 expression")
				return nil
			}
		}

		if !self.scan.next(&self.stmt) {
			self.pushErr(it.Token, "invalid syntax")
			return nil
		}

		tokens = self.stmt.tokens
		mut stmtTokens := getBlockExpr(tokens)
		if len(stmtTokens) > 0 {
			mut stmt2 := stmt{
				tokens:     stmtTokens,
				terminated: stmt.terminated,
			}
			kind.NextToken = stmtTokens[0]
			kind.Next = self.buildStmt(&stmt2)
		}

		mut i := len(stmtTokens)
		mut blockTokens := range(&i, token::LBRACE, token::RBRACE, tokens)
		if blockTokens == nil {
			self.pushErr(it.Token, "missing iteration body")
			self.scan.stop()
			return nil
		}
		if i < len(tokens) {
			self.pushErr(tokens[i], "invalid syntax")
		}

		it.Scope = self.buildScope(blockTokens, tokens[i-1])
		it.Kind = kind

		return it
	}

	fn buildWhileIterKind(mut *self, mut tokens: []&token::Token): &ast::WhileKind {
		mut x := self.p.buildExpr(tokens)
		if x == nil {
			return nil
		}
		_, ok := x.Data.(&ast::TupleExpr)
		if ok {
			self.pushErr(x.Token, "expected 1 expression")
			return nil
		}
		return &ast::WhileKind{
			X: x,
		}
	}

	fn getRangeKindKeysTokens(mut *self, mut toks: []&token::Token): [][]&token::Token {
		mut vars, errs := self.p.parts(toks, token::COMMA, true, "expected variable after ,")
		self.p.errors = append(self.p.errors, errs...)
		return vars
	}

	fn buildRangeKindKey(mut *self, mut tokens: []&token::Token): &ast::Var {
		if len(tokens) == 0 {
			return nil
		}
		mut key := &ast::Var{
			Token: tokens[0],
			Op:    tokens[0],
		}
		if key.Token.ID == token::MUT {
			key.Flags |= ast::F_MUTABLE
			if len(tokens) == 1 {
				self.pushErr(key.Token, "invalid syntax")
			}
			key.Token = tokens[1]
		} else if len(tokens) > 1 {
			self.pushErr(tokens[1], "invalid syntax")
		}
		if key.Token.ID != token::NAME {
			self.pushErr(key.Token, "invalid syntax")
			self.pushSuggestion("give an identifier because identifier expected")
			return nil
		}
		key.Name = key.Token.Kind
		return key
	}

	fn buildRangeKindKeys(mut *self, mut parts: [][]&token::Token): []&ast::Var {
		mut keys := ([]&ast::Var)(nil)
		for (_, mut tokens) in parts {
			keys = append(keys, self.buildRangeKindKey(tokens))
		}
		return keys
	}

	fn setupRangeKindKeysPlain(mut *self, mut rng: &ast::RangeKind, mut tokens: []&token::Token) {
		mut keyTokens := self.getRangeKindKeysTokens(tokens)
		if len(keyTokens) == 0 {
			return
		}
		if len(keyTokens) > 2 {
			self.pushErr(rng.InToken, "range variables out of range (ironically)")
			self.pushSuggestion("most iterations takes (0, 2) variables")
		}
		mut keys := self.buildRangeKindKeys(keyTokens)
		rng.A = keys[0]
		if len(keys) > 1 {
			rng.B = keys[1]
		}
	}

	fn setupRangeKindKeysExplicit(mut *self, mut rng: &ast::RangeKind, mut tokens: []&token::Token) {
		mut i := 0
		mut rang := range(&i, token::LPAREN, token::RPAREN, tokens)
		if i < len(tokens) {
			self.pushErr(rng.InToken, "invalid syntax")
		}
		self.setupRangeKindKeysPlain(rng, rang)
	}

	fn setupRangeKindKeys(mut *self, mut rng: &ast::RangeKind, mut tokens: []&token::Token) {
		if tokens[0].ID == token::LPAREN {
			self.setupRangeKindKeysExplicit(rng, tokens)
			return
		}
		self.setupRangeKindKeysPlain(rng, tokens)
	}

	fn buildRangeIterKind(mut *self, mut varTokens: []&token::Token,
		mut exprTokens: []&token::Token, mut inToken: &token::Token): &ast::RangeKind {
		mut rng := &ast::RangeKind{
			InToken: inToken,
		}
		if len(exprTokens) == 0 {
			self.pushErr(rng.InToken, "missing iteration expression")
			return rng
		}
		rng.X = self.p.buildExpr(exprTokens)
		if len(varTokens) > 0 {
			self.setupRangeKindKeys(rng, varTokens)
		}
		return rng
	}

	fn buildCommonIterKind(mut *self, mut tokens: []&token::Token, errTok: &token::Token): ast::IterKind {
		mut braceN := 0
		for (i, mut tok) in tokens {
			match tok.ID {
			| token::LBRACE
			| token::LBRACK
			| token::LPAREN:
				braceN++
				continue
			| token::RBRACE
			| token::RBRACK
			| token::RPAREN:
				braceN--
			}
			if braceN != 0 {
				continue
			}
			match tok.ID {
			| token::IN:
				mut declTokens := tokens[:i]
				mut exprTokens := tokens[i+1:]
				return self.buildRangeIterKind(declTokens, exprTokens, tok)
			}
		}
		return self.buildWhileIterKind(tokens)
	}

	fn buildCommonIter(mut *self, mut tokens: []&token::Token): &ast::Iter {
		mut it := &ast::Iter{
			Token: tokens[0],
		}
		tokens = tokens[1:] // Skip "iter" keyword.
		if len(tokens) == 0 {
			self.pushErr(it.Token, "missing iteration body")
			self.scan.stop()
			return nil
		}
		mut exprTokens := getBlockExpr(tokens)
		if len(exprTokens) > 0 {
			it.Kind = self.buildCommonIterKind(exprTokens, it.Token)
		}
		mut i := len(exprTokens)
		mut scopeTokens := range(&i, token::LBRACE, token::RBRACE, tokens)
		if scopeTokens == nil {
			self.pushErr(it.Token, "missing iteration body")
			self.scan.stop()
			return nil
		}
		if i < len(tokens) {
			self.pushErr(tokens[i], "invalid syntax")
		}
		it.Scope = self.buildScope(scopeTokens, tokens[i-1])
		return it
	}

	fn buildIterStmt(mut *self, mut &stmt: *stmt): &ast::Iter {
		if stmt.terminated {
			return self.buildWhileNextIter(stmt)
		}
		return self.buildCommonIter(stmt.tokens)
	}

	fn buildBreak(mut *self, mut tokens: []&token::Token): &ast::Break {
		mut brk := &ast::Break{
			Token: tokens[0],
		}
		if len(tokens) > 1 {
			if tokens[1].ID != token::NAME {
				self.pushErr(tokens[1], "invalid syntax")
				self.pushSuggestion("give a label identifier because label expected")
			} else {
				brk.Label = tokens[1]
				if len(tokens) > 2 {
					self.pushErr(tokens[1], "invalid syntax")
				}
			}
		}
		return brk
	}

	fn buildContStmt(mut *self, mut tokens: []&token::Token): &ast::Continue {
		mut cont := &ast::Continue{
			Token: tokens[0],
		}
		if len(tokens) > 1 {
			if tokens[1].ID != token::NAME {
				self.pushErr(tokens[1], "invalid syntax")
				self.pushSuggestion("give a label identifier because label expected")
			} else {
				cont.Label = tokens[1]
				if len(tokens) > 2 {
					self.pushErr(tokens[1], "invalid syntax")
				}
			}
		}
		return cont
	}

	fn buildIf(mut *self, mut &tokens: *[]&token::Token): &ast::If {
		mut model := &ast::If{
			Token: (*tokens)[0],
		}
		*tokens = (*tokens)[1:]
		mut exprTokens := getBlockExpr(*tokens)
		mut i := 0
		if len(exprTokens) == 0 {
			self.pushErr(model.Token, "missing condition expression of if statement")
		} else {
			i = len(exprTokens)
		}
		mut scopeTokens := range(&i, token::LBRACE, token::RBRACE, *tokens)
		if scopeTokens == nil {
			self.pushErr(model.Token, "missing if statement body")
			self.scan.stop()
			return nil
		}
		mut end := (*tokens)[i-1]
		if i < len(*tokens) {
			if (*tokens)[i].ID == token::ELSE {
				*tokens = (*tokens)[i:]
			} else {
				self.pushErr((*tokens)[i], "invalid syntax")
				*tokens = nil
			}
		}
		model.X = self.p.buildExpr(exprTokens)
		model.Scope = self.buildScope(scopeTokens, end)
		return model
	}

	fn buildElse(mut *self, mut &tokens: *[]&token::Token): &ast::Else {
		mut els := &ast::Else{
			Token: (*tokens)[0],
		}
		*tokens = (*tokens)[1:] // Remove "else" keyword.
		mut i := 0
		mut scopeTokens := range(&i, token::LBRACE, token::RBRACE, *tokens)
		if scopeTokens == nil {
			if i < len(*tokens) {
				self.pushErr(els.Token, "else statement cannot have expression")
			} else {
				self.pushErr(els.Token, "missing else statement body")
				self.scan.stop()
			}
			return nil
		}
		if i < len(*tokens) {
			self.pushErr((*tokens)[i], "invalid syntax")
		}
		els.Scope = self.buildScope(scopeTokens, (*tokens)[i-1])
		return els
	}

	fn buildIfElseChain(mut *self, mut tokens: []&token::Token): &ast::Conditional {
		mut chain := new(ast::Conditional)
		chain.Tail = append(chain.Tail, self.buildIf(&tokens))
		if len(chain.Tail) == 0 || chain.Tail[0] == nil {
			return nil
		}
		for len(tokens) != 0 {
			if tokens[0].ID != token::ELSE {
				break
			}
			if len(tokens) > 1 && tokens[1].ID == token::IF {
				tokens = tokens[1:] // Remove else token
				mut elif := self.buildIf(&tokens)
				chain.Tail = append(chain.Tail, elif)
				continue
			}
			chain.Default = self.buildElse(&tokens)
			break
		}
		return chain
	}

	fn buildSpawnCallStmt(mut *self, mut tokens: []&token::Token): &ast::Expr {
		token := tokens[0]
		tokens = tokens[1:] // Start 1 to skip "spawn" token.
		if len(tokens) == 0 {
			self.pushErr(token, "invalid syntax")
			return nil
		}
		mut e := self.p.buildExpr(tokens)
		if e == nil {
			return e
		}
		match type e.Data {
		| &ast::CallExpr:
			e.Data.(&ast::CallExpr).Flags |= ast::F_SPAWN
		|:
			self.pushErr(token, "co statement must have function call expression")
		}
		return e
	}

	fn buildGoto(mut *self, mut tokens: []&token::Token): &ast::Goto {
		mut gt := &ast::Goto{
			Token: tokens[0],
		}
		if len(tokens) == 1 {
			self.pushErr(gt.Token, "missing label identifier for goto statement")
			return nil
		} else if len(tokens) > 2 {
			self.pushErr(tokens[2], "invalid syntax")
		}
		mut identToken := tokens[1]
		if identToken.ID != token::NAME {
			self.pushErr(identToken, "invalid syntax")
			self.pushSuggestion("give an identifier because identifier expected")
			return gt
		}
		gt.Label = identToken
		return gt
	}

	fn buildFall(mut *self, mut tokens: []&token::Token): &ast::Fall {
		mut fll := &ast::Fall{
			Token: tokens[0],
		}
		if len(tokens) > 1 {
			self.pushErr(tokens[1], "invalid syntax")
		}
		return fll
	}

	fn buildTypeAliasStmt(mut *self, mut tokens: []&token::Token): &ast::TypeAlias {
		mut tad := self.p.buildTypeAliasDecl(tokens)
		tad.Scope = self.s
		return tad
	}

	fn pushCaseExpr(mut *self, mut tokens: []&token::Token, mut token: &token::Token,
		typeMatch: bool, mut &exprs: *[]&ast::Expr) {
		if len(tokens) == 0 {
			return
		}
		if typeMatch {
			mut i := 0
			mut t, ok := self.p.buildType(tokens, &i, true)
			if ok {
				*exprs = append(*exprs, t)
				if i < len(tokens) {
					self.pushErr(tokens[i], "invalid syntax")
				}
			}
			return
		}
		*exprs = append(*exprs, self.p.buildExpr(tokens))
	}

	fn buildCaseExprs(mut *self, mut &tokens: *[]&token::Token, mut &colon: *&token::Token, typeMatch: bool): ([]&ast::Expr, bool) {
		mut exprs := make([]&ast::Expr, 0, 1)
		mut braceN := 0
		mut j := 0
		for (i, mut tok) in *tokens {
			match tok.ID {
			| token::LPAREN
			| token::LBRACE
			| token::LBRACK:
				braceN++
				continue
			| token::RPAREN
			| token::RBRACE
			| token::RBRACK:
				braceN--
				continue
			}

			if braceN != 0 {
				continue
			}
			match {
			| tok.ID == token::OR:
				mut exprTokens := (*tokens)[j:i]
				if len(exprTokens) == 0 {
					self.pushErr(tok, "missing case expression for match statement")
				} else {
					self.pushCaseExpr(exprTokens, tok, typeMatch, &exprs)
				}
				j = i + 1
			| tok.ID == token::COLON:
				*colon = tok
				mut exprTokens := (*tokens)[j:i]
				if len(exprTokens) == 0 && j != 0 {
					// If we have expression already for this case,
					// disallow expressionless case. For default case,
					// allow this, if case is just completely empty.
					self.pushErr(tok, "missing case expression for match statement")
				}
				self.pushCaseExpr(exprTokens, tok, typeMatch, &exprs)
				*tokens = (*tokens)[i+1:]
				return exprs, i-j == 0 || len(exprs) != 0
			}
		}
		self.pushErr((*tokens)[0], "invalid syntax")
		*tokens = nil
		return nil, false
	}

	fn buildCaseScope(mut *self, mut &tokens: *[]&token::Token): &ast::Scope {
		let mut scan: scanner
		let mut next: stmt
		mut n := 0
		for {
			scan.init((*tokens)[n:])
			if !scan.next(&next) || len(next.tokens) == 0 {
				break
			}
			token := next.tokens[0]
			if token.ID != token::OR {
				n += scan.pos
				continue
			}
			mut scopeTokens := (*tokens)[:n]
			let mut end: &token::Token
			if len(scopeTokens) > 0 {
				end = (scopeTokens)[len(scopeTokens)-1]
			} else {
				// It will be colon token, handled by [buildCase].
				end = nil
			}
			mut scope := self.buildScope(scopeTokens, end)
			*tokens = (*tokens)[n:]
			return scope
		}
		let mut end: &token::Token
		if len(*tokens) > 0 {
			end = (*tokens)[len(*tokens)-1]
		}
		mut scope := self.buildScope(*tokens, end)
		*tokens = nil
		return scope
	}

	fn buildCase(mut *self, mut &tokens: *[]&token::Token, typeMatch: bool): (&ast::Case, bool) {
		mut c := &ast::Case{
			Token: (*tokens)[0],
		}
		*tokens = (*tokens)[1:] // Remove case prefix.
		let mut colon: &token::Token = nil
		if len(*tokens) == 0 {
			self.pushErr(c.Token, "invalid syntax")
			return nil, false
		}
		c.X, ok := self.buildCaseExprs(tokens, &colon, typeMatch)
		c.Scope = self.buildCaseScope(tokens)
		if c.Scope.End == nil {
			c.Scope.End = colon
		}
		isDefault := ok && len(c.X) == 0
		return c, isDefault
	}

	fn buildCases(mut *self, mut tokens: []&token::Token, typeMatch: bool): ([]&ast::Case, &ast::Else) {
		let mut cases: []&ast::Case = nil
		let mut def: &ast::Else = nil
		mut defNotLast := false
		for len(tokens) > 0 {
			mut tok := tokens[0]
			if tok.ID != token::OR {
				self.pushErr(tok, "invalid syntax")
				break
			}
			mut c, isDefault := self.buildCase(&tokens, typeMatch)
			if isDefault {
				c.Token = tok
				if def == nil {
					def = &ast::Else{
						Token: c.Token,
						Scope: c.Scope,
					}
				} else {
					self.pushErr(tok, "invalid syntax")
				}
			} else {
				defNotLast = defNotLast || def != nil
				cases = append(cases, c)
			}
		}

		if defNotLast {
			self.pushErr(def.Token, "default case of math statement must be the last case")
		}

		return cases, def
	}

	fn buildMatch(mut *self, mut tokens: []&token::Token): &ast::Match {
		mut m := &ast::Match{
			Token: tokens[0],
		}
		tokens = tokens[1:] // Remove "match" keyword.

		if len(tokens) > 0 && tokens[0].ID == token::TYPE {
			m.Flags |= ast::F_TYPE
			tokens = tokens[1:] // Skip "type" keyword
		}

		mut exprTokens := getBlockExpr(tokens)
		if len(exprTokens) > 0 {
			m.X = self.p.buildExpr(exprTokens)
		} else if m.Flags&ast::F_TYPE != 0 {
			self.pushErr(m.Token, "missing type-match statement expression")
		}

		mut i := len(exprTokens)
		mut blockToks := range(&i, token::LBRACE, token::RBRACE, tokens)
		if blockToks == nil {
			self.pushErr(m.Token, "missing type-match statement body")
			self.scan.stop()
			return nil
		} else if i < len(tokens) {
			self.pushErr(tokens[i], "invalid syntax")
		}
		m.End = tokens[i-1]
		m.Cases, m.Default = self.buildCases(blockToks, m.Flags&ast::F_TYPE != 0)
		return m
	}

	fn buildSelectCaseExpr(mut *self, mut &tokens: *[]&token::Token, mut &colon: *&token::Token): ([]&ast::Expr, ast::StmtData, &token::Token, bool) {
		mut exprs := make([]&ast::Expr, 0, 1)
		mut stmt := ast::StmtData(nil)
		mut stmtToken := (&token::Token)(nil)
		mut braceN := 0
		mut j := 0
		for (i, mut tok) in *tokens {
			match tok.ID {
			| token::LPAREN
			| token::LBRACE
			| token::LBRACK:
				braceN++
				continue
			| token::RPAREN
			| token::RBRACE
			| token::RBRACK:
				braceN--
				continue
			}

			if braceN != 0 {
				continue
			}
			match {
			| tok.ID == token::OR:
				self.pushErr(tok, "missing expression after |")
				*tokens = nil
				return nil, nil, nil, false
			| tok.ID == token::COLON:
				*colon = tok
				mut exprTokens := (*tokens)[j:i]
				if len(exprTokens) > 0 {
					mut assignStmt, ok := self.buildAssignStmt(exprTokens)
				StmtCheck:
					match {
					| ok:
						match type assignStmt {
						| &ast::Expr:
							mut expr := assignStmt.(&ast::Expr)
							exprs = append(exprs, expr)
							break StmtCheck
						| &ast::Var: // Catch inline variables, like; x := <-chan
							mut v := assignStmt.(&ast::Var)
							if v.X == nil || v.Op == nil || v.Op.ID != token::DEFINE {
								self.pushErr(v.Token, "must be single short variable declaration")
								return nil, nil, nil, false
							}
							stmt = v
							stmtToken = exprTokens[0]
							break StmtCheck
						| &ast::Assign: // Catch inline assignments, like; x = <-chan
							mut assign := assignStmt.(&ast::Assign)
							if assign.Decl || assign.Op.ID != token::ASSIGN || len(assign.X) != 1 {
								self.pushErr(assign.Op, "must be single short variable declaration or assignment")
								return nil, nil, nil, false
							}
							stmt = assign
							stmtToken = exprTokens[0]
							break StmtCheck
						|:
							break
						}
						fall
					|:
						mut e := self.p.buildExpr(exprTokens)
						if e != nil {
							exprs = append(exprs, e)
						}
					}
				}
				*tokens = (*tokens)[i+1:]
				return exprs, stmt, stmtToken, i-j == 0 || len(exprs) != 0
			}
		}
		self.pushErr((*tokens)[0], "expected chan send or chan receive expression")
		*tokens = nil
		return nil, nil, nil, false
	}

	fn buildSelectCase(mut *self, mut &tokens: *[]&token::Token): (&ast::Case, bool) {
		mut c := &ast::Case{
			Token: (*tokens)[0],
		}
		*tokens = (*tokens)[1:] // Remove case prefix.
		let mut colon: &token::Token = nil
		if len(*tokens) == 0 {
			self.pushErr(c.Token, "invalid syntax")
			return nil, false
		}
		c.X, c.Stmt, c.StmtToken, ok := self.buildSelectCaseExpr(tokens, &colon)
		c.Scope = self.buildCaseScope(tokens)
		if c.Scope.End == nil {
			c.Scope.End = colon
		}
		isDefault := ok && len(c.X) == 0
		return c, isDefault
	}

	fn buildSelectCases(mut *self, mut tokens: []&token::Token): ([]&ast::Case, &ast::Else) {
		let mut cases: []&ast::Case = nil
		let mut def: &ast::Else = nil
		mut defNotLast := false
		for len(tokens) > 0 {
			mut tok := tokens[0]
			if tok.ID != token::OR {
				self.pushErr(tok, "invalid syntax")
				break
			}
			mut c, isDefault := self.buildSelectCase(&tokens)
			if isDefault {
				c.Token = tok
				if def == nil {
					def = &ast::Else{
						Token: c.Token,
						Scope: c.Scope,
					}
				} else {
					self.pushErr(tok, "invalid syntax")
				}
			} else {
				defNotLast = defNotLast || def != nil
				cases = append(cases, c)
			}
		}
		if defNotLast {
			self.pushErr(def.Token, "default case of select statement must be the last case")
		}
		return cases, def
	}

	fn buildSelect(mut *self, mut tokens: []&token::Token): &ast::Select {
		mut m := &ast::Select{
			Token: tokens[0],
		}
		mut i := 1 // Start at 1 to skip the "select" keyword.
		mut blockToks := range(&i, token::LBRACE, token::RBRACE, tokens)
		if blockToks == nil {
			self.pushErr(m.Token, "missing select statement body")
			self.scan.stop()
			return nil
		} else if i < len(tokens) {
			self.pushErr(tokens[i], "invalid syntax")
		}
		m.End = tokens[i-1]
		m.Cases, m.Default = self.buildSelectCases(blockToks)
		return m
	}

	fn buildThrow(mut *self, mut tokens: []&token::Token, flags: ast::Flag): &ast::Throw {
		if len(tokens) == 1 {
			self.pushErr(tokens[0], "throw statement needs an error expression")
			self.pushSuggestion("write like; throw myError")
			return nil
		}
		mut x := self.p.buildExpr(tokens[1:])
		if x == nil {
			return nil
		}
		return &ast::Throw{
			Token: tokens[0],
			Error: x,
			Flags: flags,
		}
	}

	fn buildScopeStmt(mut *self, mut tokens: []&token::Token): &ast::Scope {
		mut flags := ast::Flag(0)
		mut token := tokens[0]
		if token.ID == token::UNSAFE {
			flags |= ast::F_UNSAFE
			tokens = tokens[1:]
			if len(tokens) == 0 {
				self.pushErr(token, "invalid syntax")
				return nil
			}
			token = tokens[0]
			if token.ID == token::DEFER {
				flags |= ast::F_DEFER
				tokens = tokens[1:]
				if len(tokens) == 0 {
					self.pushErr(token, "invalid syntax")
					return nil
				}
			}
		} else if token.ID == token::DEFER {
			flags |= ast::F_DEFER
			tokens = tokens[1:]
			if len(tokens) == 0 {
				self.pushErr(token, "invalid syntax")
				return nil
			}
		}

		mut i := 0
		mut scopeTokens := range(&i, token::LBRACE, token::RBRACE, tokens)
		if scopeTokens == nil {
			self.pushErr(token, "invalid syntax")
			return nil
		} else if i < len(tokens) {
			self.pushErr(tokens[i], "invalid syntax")
		}
		mut scope := self.buildScope(scopeTokens, tokens[i-1])
		scope.Flags |= flags
		return scope
	}

	fn buildLabel(mut *self, mut tokens: []&token::Token): &ast::Label {
		mut lbl := &ast::Label{
			Token: tokens[0],
			Name:  tokens[0].Kind,
		}

		// Save followed statement
		if len(tokens) > 2 {
			tokens = tokens[2:] // Remove label identifier and colon.
			self.scan.insertAsNext(&self.stmt, tokens)
		}

		return lbl
	}

	fn buildIdStmt(mut *self, mut tokens: []&token::Token): (ast::StmtData, ok: bool) {
		if len(tokens) == 1 {
			return
		}

		mut token := tokens[1]
		match token.ID {
		| token::COLON:
			return self.buildLabel(tokens), true
		}

		return
	}

	fn buildAssignInfo(mut *self, mut tokens: []&token::Token): &assignInfo {
		mut info := &assignInfo{
			ok: true,
		}
		mut braceN := 0
		for (i, mut token) in tokens {
			match token.ID {
			| token::LBRACE
			| token::LBRACK
			| token::LPAREN:
				braceN++
			| token::RBRACE
			| token::RBRACK
			| token::RPAREN:
				braceN--
			}
			match {
			| braceN > 0:
				continue
			| !token::IsAssign(token.ID) &&
				token.ID != token::DEFINE && token.ID != token::ARROW:
				continue
			}

			info.l = tokens[:i]
			if len(info.l) == 0 {
				info.ok = false
			}
			info.setter = token
			if i+1 >= len(tokens) {
				info.r = nil
				// Expression is missing.
				// If the setter token is a postfix operator, accept it.
				if token::IsPostfix(info.setter.ID) {
					info.ok = true
					break
				}
				// The setter token is not a postfix operator.
				// Probably the following statement is the expression.
				// We must try to handle next statement as expression.
				if !self.scan.next(&self.stmt) {
					self.pushErr(info.setter, "expected expression")
					break
				}
				info.r = self.stmt.tokens
				break
			}
			info.r = tokens[i+1:]
			if token::IsPostfix(info.setter.ID) {
				if len(info.r) > 0 {
					self.pushErr(info.r[0], "invalid syntax")
					info.r = nil
				}
			}
			break
		}
		return info
	}

	fn buildAssignL(mut *self, mut tokens: []&token::Token): &ast::AssignLeft {
		mut l := &ast::AssignLeft{
			Token: tokens[0],
		}
		if tokens[0].ID == token::NAME {
			l.Name = l.Token.Kind
		}
		l.X = self.p.buildExpr(tokens)
		return l
	}

	fn buildAssignLs(mut *self, mut parts: [][]&token::Token): []&ast::AssignLeft {
		let mut lefts: []&ast::AssignLeft = nil
		for (_, mut part) in parts {
			mut l := self.buildAssignL(part)
			lefts = append(lefts, l)
		}
		return lefts
	}

	fn buildChanSend(mut *self, mut info: &assignInfo): (ast::StmtData, bool) {
		mut ch := self.p.buildExpr(info.l)
		if ch == nil {
			return nil, false
		}
		mut data := self.p.buildExpr(info.r)
		if data == nil {
			return nil, false
		}
		return &ast::Expr{
			Token: info.l[0],
			End:   info.r[len(info.r)-1],
			Data:  &ast::ChanSend{Chan: ch, X: data},
		}, true
	}

	fn buildPlainAssign(mut *self, mut tokens: []&token::Token): (ast::StmtData, bool) {
		mut info := self.buildAssignInfo(tokens)
		if !info.ok {
			return nil, false
		}

		// Catch channel data send statements.
		if info.setter.ID == token::ARROW {
			return self.buildChanSend(info)
		}

		mut assign := &ast::Assign{
			Op: info.setter,
		}

		// Catch declaration assignments.
		if info.setter.ID == token::DEFINE {
			assign.Decl = true
			assign.Y = self.p.buildExpr(info.r)
			ok := self.buildDeclAssign1(info.l, assign)
			if !ok {
				// Return with true to avoid duplicate error.
				return nil, true
			}
			if len(assign.X) > 1 {
				return assign, true
			}
			// Single left, use &Var instead if possible.
			mut left := assign.X[0]
			_, isIdent := left.X.Data.(&ast::NameExpr)
			if isIdent {
				mut decl := &ast::Var{
					Token: left.Token,
					Op:    assign.Op,
					Name:  left.Name,
					Scope: self.s,
					X:     assign.Y,
					Flags: left.Flags & (ast::F_MUTABLE | ast::F_REFERENCE),
				}
				return decl, true
			}
			return assign, true
		}

		mut parts, errs := self.p.parts(info.l, token::COMMA, true, "expected expression after ,")
		if len(errs) > 0 {
			self.p.errors = append(self.p.errors, errs...)
			return nil, false
		}
		if len(parts) > 1 && assign.Op.ID != token::ASSIGN {
			self.pushErr(assign.Op, "assignment operation @ requires single-valued expressions", assign.Op.Kind)
		}

		assign.X = self.buildAssignLs(parts)
		if info.r != nil {
			assign.Y = self.p.buildExpr(info.r)
		}

		return assign, true
	}

	fn buildDeclAssign1(mut *self, mut lefts: []&token::Token, mut assign: &ast::Assign): bool {
		// Lefts
		mut parts, errs := self.p.parts(lefts, token::COMMA, true, "expected expression after ,")
		if len(errs) > 0 {
			self.p.errors = append(self.p.errors, errs...)
			return false
		}

		for (_, mut part) in parts {
			mut flags := ast::Flag(0)

			token := part[0]
			if token.ID == token::MUT {
				flags |= ast::F_MUTABLE
				part = part[1:]
				if len(part) == 0 {
					self.pushErr(token, "invalid syntax")
					return false
				}
			}

			if part[0].ID == token::AND {
				flags |= ast::F_REFERENCE
				part = part[1:]
				if len(part) == 0 {
					self.pushErr(token, "invalid syntax")
					return false
				}
			}

			if part[0].ID != token::NAME && part[0].ID != token::LPAREN {
				self.pushErr(token, "invalid syntax")
				return false
			}

			mut x := self.buildAssignL(part)
			if x.X == nil {
				return false
			}
			x.Flags |= flags
			assign.X = append(assign.X, x)
		}

		return true
	}

	fn buildDeclAssign(mut *self, mut tokens: []&token::Token): (&ast::Assign, bool) {
		if len(tokens) < 1 {
			return nil, false
		}

		tokens = tokens[1:] // Skip "let" keyword
		mut token := tokens[0]
		if token.ID != token::LPAREN {
			return nil, false
		}

		mut assign := &ast::Assign{
			Decl: true,
		}

		mut i := 0
		mut rang := range(&i, token::LPAREN, token::RPAREN, tokens)
		if rang == nil {
			self.pushErr(token, "invalid syntax")
			return nil, false
		} else if i+1 < len(tokens) {
			// Expression is in the same statement,
			// following the assignment operator.
			assign.Op = tokens[i]
			if assign.Op.ID != token::ASSIGN {
				self.pushErr(assign.Op, "assignment operation @ requires single-valued expressions", assign.Op.Kind)
			}
			i++
			mut exprTokens := tokens[i:]
			assign.Y = self.p.buildExpr(exprTokens)
		} else {
			// The assignment operator exist, but expression is not.
			// Probably the following statement is the expression.
			// We must try to handle next statement as expression.
			assign.Op = tokens[i]
			if assign.Op.ID != token::ASSIGN {
				self.pushErr(assign.Op, "assignment operation @ requires single-valued expressions", assign.Op.Kind)
			}
			if !self.scan.next(&self.stmt) {
				self.pushErr(assign.Op, "expected expression")
				return nil, false
			}
			mut exprTokens := self.stmt.tokens
			assign.Y = self.p.buildExpr(exprTokens)
		}

		ok := self.buildDeclAssign1(rang, assign)
		return assign, ok
	}

	fn buildAssignStmt(mut *self, mut tokens: []&token::Token): (stmt: ast::StmtData, ok: bool) {
		if !checkAssignTokens(tokens) {
			return nil, false
		}
		match tokens[0].ID {
		| token::LET:
			stmt, ok = self.buildDeclAssign(tokens)
		|:
			stmt, ok = self.buildPlainAssign(tokens)
		}
		return
	}

	fn buildUseExpr(mut *self, mut tokens: []&token::Token): &ast::UseExpr {
		if len(tokens) == 1 {
			self.pushErr(tokens[0], "missing use statement expression")
			return nil
		}
		mut ue := &ast::UseExpr{
			Token: tokens[0],
		}
		tokens = tokens[1:] // Ignore "use" keyword.
		ue.X = self.p.buildExpr(tokens)
		return ue
	}

	fn buildConstStmt(mut *self, mut &stmt: *stmt): ast::StmtData {
		if len(stmt.tokens) == 1 {
			self.pushErr(stmt.tokens[0], "invalid syntax")
			return nil
		}
		match stmt.tokens[1].ID {
		| token::FOR:
			stmt.tokens = stmt.tokens[1:]
			mut iter := self.buildIterStmt(stmt)
			if iter != nil {
				iter.Flags |= ast::F_CONST
			}
			return iter
		| token::MATCH:
			stmt.tokens = stmt.tokens[1:]
			mut mt := self.buildMatch(stmt.tokens)
			if mt != nil {
				mt.Flags |= ast::F_CONST
			}
			return mt
		|:
			return self.buildVarStmt(stmt.tokens)
		}
	}

	fn buildStmt(mut *self, mut &stmt: *stmt): ast::StmtData {
		if len(stmt.tokens) == 0 {
			// Empty statement, skip immediately.
			// Typically caused by empty statements explicitly terminated by semicolon.
			return nil
		}
		mut token := stmt.tokens[0]
		if token.ID == token::NAME {
			mut s, ok := self.buildIdStmt(stmt.tokens)
			if ok {
				return s
			}
		}

		mut s, ok := self.buildAssignStmt(stmt.tokens)
		if ok {
			return s
		}

		match token.ID {
		| token::USE:
			return self.buildUseExpr(stmt.tokens)
		| token::CONST:
			return self.buildConstStmt(stmt)
		| token::LET
		| token::MUT:
			return self.buildVarStmt(stmt.tokens)
		| token::RETURN:
			return self.buildReturnStmt(stmt.tokens)
		| token::FOR:
			return self.buildIterStmt(stmt)
		| token::BREAK:
			return self.buildBreak(stmt.tokens)
		| token::CONTINUE:
			return self.buildContStmt(stmt.tokens)
		| token::IF:
			return self.buildIfElseChain(stmt.tokens)
		| token::SPAWN:
			return self.buildSpawnCallStmt(stmt.tokens)
		| token::GOTO:
			return self.buildGoto(stmt.tokens)
		| token::FALL:
			return self.buildFall(stmt.tokens)
		| token::TYPE:
			return self.buildTypeAliasStmt(stmt.tokens)
		| token::MATCH:
			return self.buildMatch(stmt.tokens)
		| token::SELECT:
			return self.buildSelect(stmt.tokens)
		| token::THROW:
			return self.buildThrow(stmt.tokens, 0)
		| token::UNSAFE:
			if len(stmt.tokens) < 1 {
				break
			}
			tok1 := stmt.tokens[1]
			match tok1.ID {
			| token::DEFER | token::LBRACE: // Scope.
				return self.buildScopeStmt(stmt.tokens)
			| token::THROW: // Throw statement.
				stmt.tokens = stmt.tokens[1:] // Trim unsafe keyword.
				return self.buildThrow(stmt.tokens, ast::F_UNSAFE)
			}
		| token::DEFER:
			return self.buildScopeStmt(stmt.tokens)
		| token::LBRACE:
			return self.buildScopeStmt(stmt.tokens)
		}
		mut expr := self.p.buildExpr(stmt.tokens)
		// Return expression if not nil, otherwise return nil StmtData.
		// Avoid to return StmtData with nil &ast::Expr.
		if expr != nil {
			return expr
		}
		// Do not log any error. Expression parsing will log error, if any.
		return nil
	}

	fn build(mut *self, mut tokens: []&token::Token, mut s: &ast::Scope) {
		if s == nil {
			return
		}
		self.s = s
		self.scan.init(tokens)
		mut &stmt := &self.stmt
		for !self.scan.stopped() && self.scan.next(stmt) {
			mut data := self.buildStmt(stmt)
			if data != nil {
				self.s.Stmts = append(self.s.Stmts, ast::Stmt{
					Token: stmt.tokens[0],
					End:   stmt.tokens[len(stmt.tokens)-1],
					Data:  data,
				})
			}
		}
	}
}