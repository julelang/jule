use "std/jule/ast"
use "std/jule/token"

// Symbol table.
// Builds by semantic analyzer.
struct SymTab {
	File:        &token::FileSet // Owner fileset of this symbol table.
	Passes:      []Pass          // All passed flags with jule:pass directive.
	Imports:     []&ImportInfo   // Imported packages.
	Vars:        []&Var          // Variables.
	TypeAliases: []&TypeAlias    // Type aliases.
	Structs:     []&Struct       // Structures.
	Funcs:       []&Func         // Functions.
	Traits:      []&Trait        // Traits.
	Enums:       []&Enum         // Enums.
	TypeEnums:   []&TypeEnum     // Type enums.
	Impls:       []&ast::Impl    // Implementations.
}

impl Lookup for SymTab {
	// Returns imported package by selector.
	// Returns nil if selector returns false for all packages.
	// Returns nil if selector is nil.
	fn SelectPackage(mut *self, selector: fn(&ImportInfo): bool): &ImportInfo {
		if selector == nil {
			return nil
		}
		for (_, mut pkg) in self.Imports {
			if selector(pkg) {
				return pkg
			}
		}
		return nil
	}

	// Returns variable by identifier and external state.
	// Returns nil if refenrece not exist any variable in this identifier.
	fn FindVar(mut *self, name: string, _extern: bool): &Var {
		return self.findVar(name, _extern, false)
	}

	// Returns type alias by identifier and external state.
	// Returns nil if not exist any type alias in this identifier.
	fn FindTypeAlias(mut *self, name: string, _extern: bool): &TypeAlias {
		return self.findTypeAlias(name, _extern, false)
	}

	// Returns struct by identifier and external state.
	// Returns nil if not exist any struct in this identifier.
	fn FindStruct(mut *self, name: string, _extern: bool): &Struct {
		for (_, mut s) in self.Structs {
			if s.AST.Name == name && (s.AST.Flags&ast::F_EXTERN != 0) == _extern {
				return s
			}
		}
		return nil
	}

	// Returns function by identifier and external state.
	// Returns nil if not exist any function in this identifier.
	fn FindFunc(mut *self, name: string, _extern: bool): &Func {
		for (_, mut f) in self.Funcs {
			if f.AST.Name == name && (f.AST.Flags&ast::F_EXTERN != 0) == _extern {
				return f
			}
		}
		return nil
	}

	// Returns trait by identifier.
	// Returns nil if not exist any trait in this identifier.
	fn FindTrait(mut *self, name: string): &Trait {
		for (_, mut t) in self.Traits {
			if t.AST.Name == name {
				return t
			}
		}
		return nil
	}

	// Returns enum by identifier.
	// Returns nil if not exist any enum in this identifier.
	fn FindEnum(mut *self, name: string): &Enum {
		for (_, mut e) in self.Enums {
			if e.AST.Name == name {
				return e
			}
		}
		return nil
	}

	// Returns type enum by identifier.
	// Returns nil if not exist any type enum in this identifier.
	fn FindTypeEnum(mut *self, name: string): &TypeEnum {
		for (_, mut e) in self.TypeEnums {
			if e.AST.Name == name {
				return e
			}
		}
		return nil
	}
}

impl SymTab {
	fn findVar1(mut *self, v: &Var): int {
		for i in self.Vars {
			if self.Vars[i] == v {
				return i
			}
		}
		return -1
	}

	fn findVar(mut *self, name: string, _extern: bool, reverse: bool): &Var {
		if reverse {
			mut i := len(self.Vars) - 1
			for i >= 0; i-- {
				mut v := self.Vars[i]
				if v.AST.Name == name && (v.AST.Flags&ast::F_EXTERN != 0) == _extern {
					return v
				}
			}
		} else {
			for (_, mut v) in self.Vars {
				if v.AST.Name == name && (v.AST.Flags&ast::F_EXTERN != 0) == _extern {
					return v
				}
			}
		}
		return nil
	}

	fn findTypeAlias(mut *self, name: string, _extern: bool, reverse: bool): &TypeAlias {
		if reverse {
			mut i := len(self.TypeAliases) - 1
			for i >= 0; i-- {
				mut ta := self.TypeAliases[i]
				if ta.AST.Name == name && (ta.AST.Flags&ast::F_EXTERN != 0) == _extern {
					return ta
				}
			}
		} else {
			for (_, mut ta) in self.TypeAliases {
				if ta.AST.Name == name && (ta.AST.Flags&ast::F_EXTERN != 0) == _extern {
					return ta
				}
			}
		}
		return nil
	}

	// Returns define by identifier.
	// Returns nil if not exist any define in this identifier.
	fn defByIdent(mut *self, name: string, _extern: bool): any {
		for (_, mut v) in self.Vars {
			if v.AST.Name == name && (v.AST.Flags&ast::F_EXTERN != 0) == _extern {
				return v
			}
		}

		for (_, mut ta) in self.TypeAliases {
			if ta.AST.Name == name && (ta.AST.Flags&ast::F_EXTERN != 0) == _extern {
				return ta
			}
		}

		for (_, mut s) in self.Structs {
			if s.AST.Name == name && (s.AST.Flags&ast::F_EXTERN != 0) == _extern {
				return s
			}
		}

		for (_, mut f) in self.Funcs {
			if f.AST.Name == name && (f.AST.Flags&ast::F_EXTERN != 0) == _extern {
				return f
			}
		}

		if _extern {
			return nil
		}

		for (_, mut t) in self.Traits {
			if t.AST.Name == name {
				return t
			}
		}

		for (_, mut e) in self.Enums {
			if e.AST.Name == name {
				return e
			}
		}

		for (_, mut te) in self.TypeEnums {
			if te.AST.Name == name {
				return te
			}
		}

		return nil
	}

	// Reports this identifier duplicated in symbol table.
	// The "itself" parameter represents address of exception identifier.
	// If founded identifier address equals to "itself", it will be skipped.
	fn isDuplicatedName(*self, itself: uintptr, name: string, _extern: bool): bool {
		for _, v in self.Vars {
			if uintptr(v) != itself && v.AST.Name == name && (v.AST.Flags&ast::F_EXTERN != 0) == _extern {
				return true
			}
		}

		for _, ta in self.TypeAliases {
			if uintptr(ta) != itself && ta.AST.Name == name && (ta.AST.Flags&ast::F_EXTERN != 0) == _extern {
				return true
			}
		}

		for _, s in self.Structs {
			if uintptr(s) != itself && s.AST.Name == name && (s.AST.Flags&ast::F_EXTERN != 0) == _extern {
				return true
			}
		}

		for _, f in self.Funcs {
			if uintptr(f) != itself && f.AST.Name == name && (f.AST.Flags&ast::F_EXTERN != 0) == _extern {
				return true
			}
		}

		if _extern {
			return false
		}

		for _, t in self.Traits {
			if uintptr(t) != itself && t.AST.Name == name {
				return true
			}
		}

		for _, e in self.Enums {
			if uintptr(e) != itself && e.AST.Name == name {
				return true
			}
		}

		for _, te in self.TypeEnums {
			if uintptr(te) != itself && te.AST.Name == name {
				return true
			}
		}

		return false
	}
}