use "std/conv"
use "std/jule"
use "std/jule/ast"
use "std/jule/build"
use "std/jule/directive"
use "std/jule/log"
use "std/jule/mod"
use "std/jule/token"
use "std/os"
use "std/os/filepath"
use "std/strings"
use "std/unicode"
use "std/unicode/utf8"

// Stack for symbol references.
// It used by Sema to store necessary references.
//
// List of necessary references;
//	- &FuncIns
//	- &StructIns
//	- &Trait
//	- &Var -> Only global and non-constant ones.
struct ReferenceStack {
	buffer: []any
}

impl ReferenceStack {
	// Returns new reference stack instance.
	fn new(): &ReferenceStack {
		return &ReferenceStack{
			buffer: make([]any, 0, 10),
		}
	}
}

impl ReferenceStack {
	// Returns count of references.
	fn Len(*self): int {
		return len(self.buffer)
	}

	// Returns reference by index.
	fn At(mut *self, i: int): any {
		return self.buffer[i]
	}

	// Push new reference to stack.
	fn Push(mut *self, mut ref: any) {
		self.buffer = append(self.buffer, ref)
	}

	fn clear(mut *self) {
		self.buffer = self.buffer[:0]
	}

	// Reports whether reference is exist.
	fn Exist[T](*self, t: T): bool {
		for _, ref in self.buffer {
			if ref == t {
				return true
			}
		}
		return false
	}
}

// Directive pass.
struct Pass {
	Token: &token::Token
	Args:  []string
}

fn buildTypeAlias(mut decl: &ast::TypeAlias): &TypeAlias {
	return &TypeAlias{
		AST:      decl,
		Scope:    decl.Scope,
		Generics: decl.Generics,
	}
}

fn buildField(mut decl: &ast::Field): &Field {
	return &Field{
		AST: decl,
	}
}

fn buildFields(mut decls: []&ast::Field): []&Field {
	mut fields := make([]&Field, 0, len(decls))
	for (_, mut decl) in decls {
		fields = append(fields, buildField(decl))
	}
	return fields
}

fn buildStruct(mut decl: &ast::Struct): &Struct {
	return &Struct{
		AST:    decl,
		Fields: buildFields(decl.Fields),
	}
}

fn buildParam(mut decl: &ast::Param): &Param {
	return &Param{
		AST: decl,
	}
}

fn buildParams(mut decls: []&ast::Param): []&Param {
	mut params := make([]&Param, 0, len(decls))
	for (_, mut decl) in decls {
		params = append(params, buildParam(decl))
	}
	return params
}

fn buildReturnType(mut decl: &ast::ReturnType): &ReturnType {
	if decl.Names == nil && decl.Type == nil {
		return nil // Void type.
	}
	return &ReturnType{
		AST: decl,
	}
}

fn buildFunc(mut decl: &ast::Func): &Func {
	return &Func{
		AST:    decl,
		Result: buildReturnType(decl.Result),
		Params: buildParams(decl.Params),
	}
}

fn buildMethods(mut decls: []&ast::Func): []&Func {
	mut methods := make([]&Func, 0, len(decls))
	for (_, mut decl) in decls {
		methods = append(methods, buildFunc(decl))
	}
	return methods
}

fn buildTrait(mut decl: &ast::Trait): &Trait {
	return &Trait{
		AST:     decl,
		Methods: buildMethods(decl.Methods),
	}
}

fn buildEnumItems(mut decls: []&ast::EnumItem): []&Var {
	mut items := make([]&Var, len(decls)+1)
	for (i, mut decl) in decls {
		items[i] = &Var{
			AST: &ast::Var{
				Name:  decl.Name,
				Token: decl.Token,
				X:     decl.X,
				Flags: ast::F_PUBLIC | ast::F_CONST,
			},
			Group:      items,
			GroupIndex: i,
			Refers:     ReferenceStack.new(),
		}
	}
	// Set the last element to nil.
	// See developer reference (14).
	items[len(decls)] = nil
	return items[: len(items)-1 : len(items)-1] // return with no trailing nil variable
}

fn buildEnum(mut decl: &ast::Enum): &Enum {
	return &Enum{
		AST:   decl,
		Items: buildEnumItems(decl.Items),
	}
}

fn buildTypeEnumItem(mut decl: &ast::TypeEnumItem): &TypeEnumItem {
	return &TypeEnumItem{
		AST: decl,
	}
}

fn buildTypeEnumItems(mut decls: []&ast::TypeEnumItem): []&TypeEnumItem {
	mut items := make([]&TypeEnumItem, 0, len(decls))
	for (_, mut decl) in decls {
		items = append(items, buildTypeEnumItem(decl))
	}
	return items
}

fn buildTypeEnum(mut decl: &ast::TypeEnum): &TypeEnum {
	return &TypeEnum{
		AST:   decl,
		Items: buildTypeEnumItems(decl.Items),
	}
}

fn buildVar(mut decl: &ast::Var): &Var {
	mut v := &Var{
		AST: decl,
	}
	// Initialize referencer for global variables.
	if v.AST.Scope == nil {
		v.Refers = ReferenceStack.new()
	}
	return v
}

// Symbol table builder.
// Just builds symbols, not analyze metadata
// like struct's implemented traits.
struct symBuilder {
	owner:      &symBuilder
	modID:      mod::ID
	importPath: string // Import path, this symBuilder created for.
	importer:   Importer
	errors:     []log::Log
	ast:        &ast::AST
	table:      &SymTab
}

impl symBuilder {
	fn getRoot(mut &self): &symBuilder {
		mut root := self
		for root.owner != nil {
			root = root.owner
		}
		return root
	}

	fn pushErr(mut *self, token: &token::Token, fmt: string, args: ...any) {
		self.errors = append(self.errors, compilerErr(self.ast.File, token, true, fmt, args...))
	}

	fn pushErrText(mut *self, token: &token::Token, fmt: string, args: ...any) {
		self.errors = append(self.errors, compilerErr(self.ast.File, token, false, fmt, args...))
	}

	// Push suggestion to last log.
	fn pushSuggestion(mut *self, fmt: string, args: ...any) {
		unsafe { pushSuggestion(&self.errors[len(self.errors)-1], fmt, args...) }
	}

	// Checks and returns absolute path of import filepath.
	// Designed for non-std package paths.
	// Returns empty string if error occurs.
	fn checkAbsPath(mut &self, mut filepath: string, mut decl: &ast::Use, mod: &mod::Mod): string {
		// Join filepath with the absolute module path and
		// make sure we have an absolute path to the package.
		filepath = filepath::Join(mod.Path, filepath)
		filepath = filepath::Abs(filepath) else {
			self.pushErr(decl.Path, "path not found or cannot be accessed: "+decl.Path.Kind)
			return ""
		}

		return filepath
	}

	// Same as the [checkAbsPath] method but designed for std package paths.
	fn checkStdAbsPath(mut &self, mut filepath: string, mut decl: &ast::Use): string {
		if filepath == "" {
			self.pushErr(decl.Path, "invalid import path: "+decl.Path.Kind)
			return ""
		}
		filepath = filepath::Join(build::PathStdlib(), filepath)
		filepath = filepath::Abs(filepath) else {
			self.pushErr(decl.Path, "path not found or cannot be accessed: "+decl.Path.Kind)
			return ""
		}

		return filepath
	}

	// Checks import path and returns as filepath if no error exist.
	fn checkImpPath(mut &self, mut decl: &ast::Use): (std: bool, filepath: string) {
		path := decl.Path.Kind[1 : len(decl.Path.Kind)-1] // remove quotes
		if decl.Flags&ast::F_EXTERN != 0 {
			if build::IsStdHeaderPath(path) {
				// Check for reserved aliases.
				if decl.Alias != nil && !isExternUseScopeLink(decl.Alias.Kind) {
					self.pushErr(decl.Alias, "extern use path must be module relative for reserved scope: "+conv::Quote(decl.Alias.Kind))
					return false, ""
				}
				return false, path
			}
			if decl.Alias != nil {
				if !isValidExternUseScope(decl.Alias.Kind) {
					self.pushErr(decl.Alias, "invalid scope for extern use: "+conv::Quote(decl.Alias.Kind))
					return false, ""
				}
				// Do not check for path.
				if isExternUseScopeLink(decl.Alias.Kind) {
					return false, path
				}
			}
		}

		// Take module name and submodule path from the import path.
		pathModName, submodulePath := splitModuleNameFromFilepath(path)
		std = pathModName == build::ModStdlib().Name

		// Check submodule path, if exist.
		if submodulePath != "" {
			filepath = checkImportPathValidity(submodulePath)
			if filepath == "" {
				self.pushErr(decl.Path, "invalid import path: "+decl.Path.Kind)
				return false, ""
			}
		}

		// build absolute path
		if std {
			filepath = self.checkStdAbsPath(filepath, decl)
		} else {
			// If there is no module, no common directories.
			// For the local packages, the root package needs a module.
			mut mod := self.importer.GetMod()
			if mod == nil {
				self.pushErr(decl.Path, "module not found")
				self.pushSuggestion(`run "julec mod init <modulename>" to initialize a module in the current directory`)
				return false, ""
			}

			// All import filepaths are must be start with module name.
			if mod.Name != pathModName {
				self.pushErr(decl.Path, "import path must use the root name of the module")
				self.pushSuggestion("module name of this package is: " + conv::Quote(mod.Name))
				return false, ""
			}

			filepath = self.checkAbsPath(filepath, decl, mod)
		}

		// Path must be directory.
		mustDir := decl.Flags&ast::F_EXTERN == 0 || decl.Alias != nil

		if decl.Flags&ast::F_EXTERN != 0 && !mustDir {
			ext := filepath::Ext(filepath)
			if !build::IsValidHeaderExt(ext) &&
				!build::IsValidCppExt(ext) &&
				!build::IsValidAssemblyExt(ext) {
				self.pushErr(decl.Token, "invalid C/C++/Assembly extension: "+conv::Quote(ext))
				return false, ""
			}
		}

		// Exist?
		info := os::Stat(filepath) else {
			self.pushErr(decl.Token, "path not found or cannot be accessed: "+decl.Path.Kind)
			return false, ""
		}
		exist := mustDir && info.IsDir() ||
			!mustDir && info.Mode().IsRegular()
		if !exist {
			self.pushErr(decl.Token, "path not found or cannot be accessed: "+decl.Path.Kind)
			return false, ""
		}

		return
	}

	// Assigns an alias to import.
	fn assignAlias(mut &self, mut imp: &ImportInfo) {
		mut i := strings::LastIndex(imp.LinkPath, jule::ImportPathSep)
		i++ // skip separator and also if -1 it takes full path
		path := imp.LinkPath[i:]
		imp.Alias = path
	}

	fn buildImport(mut &self, mut decl: &ast::Use): &ImportInfo {
		std, filepath := self.checkImpPath(decl)
		if filepath == "" { // error occurred
			return nil
		}

		mut imp := &ImportInfo{
			Decl:     decl,
			Path:     filepath,
			LinkPath: decl.Path.Kind[1 : len(decl.Path.Kind)-1],
			Std:      std,
		}

		if decl.Flags&ast::F_EXTERN != 0 {
			imp.Extern = true
			imp.Package = nil // Cpp headers haven't symbol table.
			if decl.Alias != nil {
				imp.Alias = decl.Alias.Kind
			}
			return imp
		}

		imp.Package = &Package{
			Files: nil, // Appends by import algorithm.
		}
		if decl.Alias != nil {
			imp.Alias = decl.Alias.Kind
		} else if !isImplicitImport(imp) {
			self.assignAlias(imp)
		}
		return imp
	}

	fn findUseDecl(mut *self, pkg: &ImportInfo): &ImportInfo {
		// Find package by path to detect external header imports.
		// Ignore implicit imports, see developer reference (6).
		return self.table.SelectPackage(fn|spkg| !isImplicitImport(spkg) &&
			pkg.Extern == spkg.Extern &&
			(!pkg.Extern || pkg.Alias == spkg.Alias) &&
			pkg.Path == spkg.Path)
	}

	fn checkDuplicateUseDecl(mut *self, mut pkg: &ImportInfo): (ok: bool) {
		mut lpkg := self.findUseDecl(pkg)
		if lpkg == nil {
			return true
		}
		self.pushErr(pkg.Decl.Token, "package @ is already imported", pkg.LinkPath)
		self.pushSuggestion("remove duplicate use declarations for to the same package")
		return false
	}

	fn pushCycleError(mut &self, sb: &symBuilder, path: string, mut &message: *strings::Builder) {
		const Padding = 7
		refersTo := log::Logf("@ refers to @", conv::Quote(sb.importPath), conv::Quote(path))
		message.WriteString(strings::Repeat(" ", Padding))!
		message.WriteString(refersTo)!
		message.WriteByte('\n')!
	}

	fn pushCrossCycleError(mut &self, target: &symBuilder, imp: &ImportInfo, errorToken: &token::Token) {
		mut message := strings::Builder{}
		self.pushCycleError(self, imp.LinkPath, &message)
		mut owner, mut old := self.owner, self
		for owner != nil; owner, old = owner.owner, owner {
			self.pushCycleError(old.owner, old.importPath, &message)
			if owner == target {
				break
			}
		}
		self.pushErr(errorToken, "illegal cross cycle in use declarations:\n"+message.String())
	}

	fn checkImportCycles(mut &self, imp: &ImportInfo, decl: &ast::Use): bool {
		if imp.Path == self.table.File.Dir() {
			self.pushErr(decl.Token, "package @ cannot refer to itself", imp.LinkPath)
			return false
		}
		if self.owner == nil {
			return true
		}
		mut owner := self
		for owner != nil; owner = owner.owner {
			if owner.table.File.Dir() == imp.Path {
				self.pushCrossCycleError(owner, imp, decl.Token)
				return false
			}
		}
		return true
	}

	// Checks internal packages or etc. for accessibility.
	//
	// Parameters:
	//	- decl: relevant use declaration.
	//	- mod: module that imports relevant package.
	//	- path: path of package that importing.
	fn checkPackageAccessibility(mut *self, decl: &ast::Use, mod: &mod::Mod, path: string) {
		if self.importer.GetMod().Equal(mod) {
			return
		}
		const InternalName = "internal"
		i := strings::Index(path, InternalName)
		if i == -1 {
			return
		}
		if i == 0 {
			// "internal" or "internal/" ?
			if len(path)-len(InternalName) == 0 ||
				strings::HasPrefix(path, InternalName+jule::ImportPathSep) {
				self.pushErr(decl.Token, "internal packages cannot be accessed")
			}
			return
		}
		// "/internal" ?
		if path[i-1:] == jule::ImportPathSep+InternalName {
			self.pushErr(decl.Token, "internal packages cannot be accessed")
			return
		}
		// "/internal/" ?
		n := i + len(InternalName) + 1
		if n < len(path) && path[i-1:n] == jule::ImportPathSep+InternalName+jule::ImportPathSep {
			self.pushErr(decl.Token, "internal packages cannot be accessed")
			return
		}
	}

	fn importPackage(mut &self, mut imp: &ImportInfo, mut decl: &ast::Use): (ok: bool) {
		if imp.Extern {
			return true
		}

		mut port := self.importer.GetImport(imp.Path)
		if port != nil {
			imp.Package = port.Package
			imp.Duplicate = true

			mut oldMod := self.importer.GetMod()
			self.importer.SetMod(self.importer.ModByID(port.ModID))
			if !isImplicitImport(imp) && !isRuntimeInternal(imp) {
				self.checkPackageAccessibility(decl, oldMod, port.Path)
			}
			self.importer.SetMod(oldMod)
		} else {
			if !self.checkImportCycles(imp, decl) {
				return false
			}

			mut oldMod := self.importer.GetMod()
			defer { self.importer.SetMod(oldMod) }
			if imp.Std {
				self.importer.SetMod(build::ModStdlib())
			}
			mut asts, mut errors := self.importer.ImportPackage(imp.Path, !imp.Std)
			if len(errors) > 0 {
				self.errors = append(self.errors, errors...)
				return false
			}

			if !isImplicitImport(imp) && !isRuntimeInternal(imp) {
				self.checkPackageAccessibility(decl, oldMod, imp.Path)
			}

			for (_, mut ast) in asts {
				mut table := (&SymTab)(nil)
				mut modID := mod::InvalidID
				mod := self.importer.GetMod()
				if mod != nil {
					modID = mod.ID
				}
				table, errors = buildSymbols(modID, imp.LinkPath, ast, self.importer, self)
				// Break import if file has error(s).
				if len(errors) > 0 {
					self.errors = append(self.errors, errors...)
					return false
				}
				imp.Package.Files = append(imp.Package.Files, table)
			}
		}
		return true
	}

	fn importUseDecl(mut &self, mut decl: &ast::Use): &ImportInfo {
		mut imp := self.buildImport(decl)
		// Break analysis if error occurs.
		if imp == nil {
			return nil
		}
		mut ok := self.checkDuplicateUseDecl(imp)
		if !ok {
			return nil
		}
		ok = self.importPackage(imp, decl)
		self.table.Imports = append(self.table.Imports, imp)
		if ok {
			self.importer.Imported(imp)
			return imp
		}
		return nil
	}

	fn importUseDecls(mut &self) {
		for (_, mut decl) in self.ast.UseDecls {
			self.importUseDecl(decl)
			// Break analysis if error occurs.
			if len(self.errors) > 0 {
				break
			}
		}
	}

	// Returns [FullName] and [Name] values according to module and package.
	// See developer reference (16) to learn about these values.
	fn getFullName(mut *self, astName: string, token: &token::Token): (fullName: string, name: string) {
		// Find our module.
		mod := self.importer.ModByID(self.modID)
		// If we do not have a module, then return AST name.
		// It should be the main package.
		// Because imported packages (including stdlib) should have a module.
		if mod == nil {
			return astName, astName
		}
		// Get the main package path.
		mainPackagePath := self.importer.GetMainPackagePath()
		// Get the package path of the AST name's owner declaration.
		file := self.importer.GetFileSet(token.FileSetID)
		packageDir := file.Dir()
		// If declaration is declared in the main package,
		// do not use a package name.
		// Return AST name instead.
		if mainPackagePath == packageDir {
			return astName, astName
		}
		// Use a string builder to build a string efficiently and
		// use single memory allocation for both values.
		let mut buf: strings::Builder
		// If our module's path is equal to the declaration's package path,
		// do no use name of the package. Because this package is the root
		// package of the module. Like the import paths, use module name.
		// Otherwise write the package name.
		// Thus we can use package name for sub-packages of the module.
		if mod.Path == packageDir {
			// Allocate the string memory once with the exact required size.
			buf.Grow(len(mod.Name) + len(astName) + 2)
			// Write module name.
			buf.WriteString(mod.Name)!
		} else {
			// Get package name.
			packageName := filepath::Base(packageDir)
			// Allocate the string memory once with the exact required size.
			buf.Grow(len(packageName) + len(astName) + 2)
			// Write package name.
			buf.WriteString(packageName)!
		}
		buf.WriteString("::")!
		// Save the module/package name prefix length to slice
		// pure AST name from the same string allocation.
		prefixLen := buf.Len()
		// Write AST name.
		buf.WriteString(astName)!
		fullName = buf.String()
		// Get slice AST name from the same allocation.
		// Thus we can avoid to making a separate allocation.
		name = fullName[prefixLen:]
		return
	}

	fn appendNode(mut *self, mut node: ast::Node) {
		match type node.Data {
		| &ast::Impl:
			self.table.Impls = append(self.table.Impls, node.Data.(&ast::Impl))
		| &ast::TypeAlias:
			mut ta := buildTypeAlias(node.Data.(&ast::TypeAlias))
			if ta.Scope == nil {
				ta.FullName, ta.AST.Name = self.getFullName(ta.AST.Name, ta.AST.Token)
			} else {
				// For local type alias, use name as full name.
				// Because it may be confusing due to it is an internal detail.
				ta.FullName = ta.AST.Name
			}
			self.table.TypeAliases = append(self.table.TypeAliases, ta)
		| &ast::Struct:
			mut srct := buildStruct(node.Data.(&ast::Struct))
			srct.FullName, srct.AST.Name = self.getFullName(srct.AST.Name, srct.AST.Token)
			self.table.Structs = append(self.table.Structs, srct)
		| &ast::Func:
			mut f := buildFunc(node.Data.(&ast::Func))
			self.table.Funcs = append(self.table.Funcs, f)
		| &ast::Trait:
			mut t := buildTrait(node.Data.(&ast::Trait))
			t.FullName, t.AST.Name = self.getFullName(t.AST.Name, t.AST.Token)
			self.table.Traits = append(self.table.Traits, t)
		| &ast::Var:
			mut astv := node.Data.(&ast::Var)
			// Grouped variables represented by the root variable of group.
			// See developer reference (12).
			// In the HIR, all variables of the group should be in the HIR.
			// See developer reference (13).
			if astv.Group == nil {
				mut v := buildVar(astv)
				self.table.Vars = append(self.table.Vars, v)
			} else {
				n := len(self.table.Vars)
				for (_, mut gv) in astv.Group {
					self.table.Vars = append(self.table.Vars, buildVar(gv))
				}
				mut group := self.table.Vars[n:len(self.table.Vars):len(self.table.Vars)]
				for (i, mut v) in group {
					v.GroupIndex = i
					v.Group = group
				}
			}
		| &ast::Enum:
			mut e := buildEnum(node.Data.(&ast::Enum))
			e.FullName, e.AST.Name = self.getFullName(e.AST.Name, e.AST.Token)
			self.table.Enums = append(self.table.Enums, e)
		| &ast::TypeEnum:
			mut e := buildTypeEnum(node.Data.(&ast::TypeEnum))
			e.FullName, e.AST.Name = self.getFullName(e.AST.Name, e.AST.Token)
			self.table.TypeEnums = append(self.table.TypeEnums, e)
		|:
			self.pushErr(node.Token, "invalid syntax")
		}
	}

	fn appendNodes(mut *self) {
		for (_, mut node) in self.ast.Nodes {
			self.appendNode(node)
		}
	}

	fn pushDirectivePass(mut *self, mut d: &ast::Directive) {
		if len(d.Args) == 0 {
			self.pushErr(d.Tag, "missing expression")
			self.pushSuggestion(`use like; #pass "-arg"`)
			return
		}

		mut args := make([]string, len(d.Args))
		for i, arg in d.Args {
			if arg.ID != token::STRING || arg.Kind[0] != '"' {
				self.pushErr(arg, "invalid syntax")
				return
			}
			args[i] = arg.Kind[1 : len(arg.Kind)-1] // Remove literal quotes.
		}

		self.table.Passes = append(self.table.Passes, Pass{
			Token: d.Tag,
			Args:  args,
		})
	}

	fn appendTopDirectives(mut *self) {
		for (_, mut d) in self.ast.TopDirectives {
			match d.Tag.Kind {
			| directive::Pass:
				self.pushDirectivePass(d)
			}
		}
	}

	fn build(mut &self) {
		self.table = &SymTab{
			File: self.ast.File,
		}

		self.appendTopDirectives()

		self.importUseDecls()
		// Break analysis if use declarations has error.
		if len(self.errors) > 0 {
			return
		}

		self.appendNodes()
		// Break analysis if declarations has error.
		if len(self.errors) > 0 {
			return
		}
	}
}

// Reports whether imp is implicitly imported.
// See developer reference (6).
fn isImplicitImport(imp: &ImportInfo): bool {
	return imp.Decl.Token == nil
}

// Reports whether imp is runtime internal package.
fn isRuntimeInternal(imp: &ImportInfo): bool {
	return strings::HasPrefix(imp.LinkPath, "std/internal/runtime")
}

// Takes filepath and returns module name from the path and submodule path if exist.
// For example: "std/jule/sema" -> ("std", "jule/sema")
// Returns empty if there is no submodule path.
fn splitModuleNameFromFilepath(filepath: string): (modName: string, submodulePath: string) {
	i := strings::IndexByte(filepath, '/')
	if i > 0 {
		modName = filepath[:i]
		// Remove the module name from the import filepath.
		// The module name will be replaced with module path.
		// The following path is submodule path, must remain.
		submodulePath = filepath[i+1:]
	} else {
		// The filepath is entirely is the module name.
		// The module name will be replaced with module path.
		// There is no submodules in the path, so set to empty string.
		modName = filepath
		submodulePath = ""
	}
	return
}

// Checks validity of the import path and returns it as filepath.
// Returns empty string if path is invalid.
fn checkImportPathValidity(path: string): (filepath: string) {
	if strings::HasSuffix(path, jule::ImportPathSep) {
		return ""
	}
	parts := strings::Split(path, jule::ImportPathSep)
	if len(parts) == 0 {
		return ""
	}
	for _, part in parts {
		if part == "" || jule::IsBlank(part) || strings::ContainsAny(part, "\\") {
			return ""
		}
		filepath = filepath::Join(filepath, part)
	}
	return filepath
}

// Reports whether scope is a valid extern use statement scope (alias).
fn isValidExternUseScope(scope: string): bool {
	return scope == "include" || // -I (for all targets)
		scope == "libraries" || // -L (for all targets)
		scope == "frameworks" || // -F (for darwin)
		scope == "library" || // -l (for all targets)
		scope == "framework" // -framework (for darwin)
}

// Reports whether scope is links a library or a framework.
fn isExternUseScopeLink(scope: string): bool {
	return scope == "library" ||
		scope == "framework"
}