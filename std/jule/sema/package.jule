use "std/jule/build"
use "std/os/filepath"
use "std/strings"

// Package.
struct Package {
	// Symbol table for each package's file.
	Files: []&SymTab
}

impl Lookup for Package {
	// Returns always nil.
	fn SelectPackage(mut *self, fn(&ImportInfo): bool): &ImportInfo { return nil }

	// Returns variable by identifier and external state.
	// Returns nil if not exist any variable in this identifier.
	fn FindVar(mut *self, name: string, _extern: bool): &Var {
		return findVarInPackage(self.Files, name, _extern)
	}

	// Returns type alias by identifier and external state.
	// Returns nil if not exist any type alias in this identifier.
	fn FindTypeAlias(mut *self, name: string, _extern: bool): &TypeAlias {
		return findTypeAliasInPackage(self.Files, name, _extern)
	}

	// Returns struct by identifier and external state.
	// Returns nil if not exist any struct in this identifier.
	fn FindStruct(mut *self, name: string, _extern: bool): &Struct {
		return findStructInPackage(self.Files, name, _extern)
	}

	// Returns function by identifier and external state.
	// Returns nil if not exist any function in this identifier.
	fn FindFunc(mut *self, name: string, _extern: bool): &Func {
		return findFuncInPackage(self.Files, name, _extern)
	}

	// Returns trait by identifier.
	// Returns nil if not exist any trait in this identifier.
	fn FindTrait(mut *self, name: string): &Trait {
		return findTraitInPackage(self.Files, name)
	}

	// Returns enum by identifier.
	// Returns nil if not exist any enum in this identifier.
	fn FindEnum(mut *self, name: string): &Enum {
		return findEnumInPackage(self.Files, name)
	}

	// Returns type enum by identifier.
	// Returns nil if not exist any type enum in this identifier.
	fn FindTypeEnum(mut *self, name: string): &TypeEnum {
		return findTypeEnumInPackage(self.Files, name)
	}
}

// Reports whether f is standard library package p.
// Example use:
//	isStdPackage(f, "") for determine the whether f is standard library package
//	isStdPackage(f, "math") for "std/math"
//	isStdPackage(f, "math/big") for "std/math/big"
fn isStdPackage(f: string, p: string): bool {
	// Do not handle '/' separators of p, because it
	// valid path separator for all supported platforms.
	return strings::HasPrefix(f, filepath::Join(build::PathStdlib(), p))
}

fn findVarFileInPackage(mut files: []&SymTab, v: &Var): &SymTab {
	for (_, mut f) in files {
		if f.findVar1(v) != -1 {
			return f
		}
	}
	return nil
}

// Returns variable by identifier and external state.
// Returns nil if not exist any variable in this identifier.
fn findVarInPackage(mut files: []&SymTab, name: string, _extern: bool): &Var {
	for (_, mut f) in files {
		mut v := f.FindVar(name, _extern)
		if v != nil {
			return v
		}
	}
	return nil
}

// Returns type alias by identifier and external state.
// Returns nil if not exist any type alias in this identifier.
fn findTypeAliasInPackage(mut files: []&SymTab, name: string, _extern: bool): &TypeAlias {
	for (_, mut f) in files {
		mut ta := f.FindTypeAlias(name, _extern)
		if ta != nil {
			return ta
		}
	}
	return nil
}

// Returns struct by identifier and external state.
// Returns nil if not exist any struct in this identifier.
fn findStructInPackage(mut files: []&SymTab, name: string, _extern: bool): &Struct {
	for (_, mut f) in files {
		mut s := f.FindStruct(name, _extern)
		if s != nil {
			return s
		}
	}
	return nil
}

// Returns function by identifier and external state.
// Returns nil if not exist any function in this identifier.
fn findFuncInPackage(mut files: []&SymTab, name: string, _extern: bool): &Func {
	for (_, mut file) in files {
		mut f := file.FindFunc(name, _extern)
		if f != nil {
			return f
		}
	}
	return nil
}

// Returns trait by identifier.
// Returns nil if not exist any trait in this identifier.
fn findTraitInPackage(mut files: []&SymTab, name: string): &Trait {
	for (_, mut f) in files {
		mut t := f.FindTrait(name)
		if t != nil {
			return t
		}
	}
	return nil
}

// Returns enum by identifier.
// Returns nil if not exist any enum in this identifier.
fn findEnumInPackage(mut files: []&SymTab, name: string): &Enum {
	for (_, mut f) in files {
		mut e := f.FindEnum(name)
		if e != nil {
			return e
		}
	}
	return nil
}

// Returns enum by identifier.
// Returns nil if not exist any type enum in this identifier.
fn findTypeEnumInPackage(mut files: []&SymTab, name: string): &TypeEnum {
	for (_, mut f) in files {
		mut e := f.FindTypeEnum(name)
		if e != nil {
			return e
		}
	}
	return nil
}

// Lookups tables with [SymTab.defByIdent] method.
fn defByIdentPackage(mut files: []&SymTab, name: string, _extern: bool): any {
	for (_, mut file) in files {
		mut def := file.defByIdent(name, _extern)
		if def != nil {
			return def
		}
	}
	return nil
}