use "std/integ"
use "std/integ/c"
use "std/internal/os/filepathlite"
use "std/internal/sys/windows"
use "std/mem"
use "std/strings"
use "std/sys"
use "std/unicode/utf16"

#typedef
extern struct STARTUPINFOW{}

#typedef
extern struct PROCESS_INFORMATION{}

extern unsafe fn CreateProcessW(*c::Wchar, *c::Wchar, *unsafe, *unsafe, c::Int, integ: extern.DWORD, *unsafe, *c::Wchar, *extern.STARTUPINFOW, *extern.PROCESS_INFORMATION): int
extern unsafe fn ZeroMemory(*unsafe, uint)
extern unsafe fn TerminateProcess(pid: extern.HANDLE, code: int): bool
extern unsafe fn GetExitCodeProcess(extern.HANDLE, mut *c::LongLong): bool
extern unsafe fn WaitForSingleObject(extern.HANDLE, u32)

struct startupInfo {
	cb:              u32
	lpReserved:      *u16
	lpDesktop:       *u16
	lpTitle:         *u16
	dwX:             u32
	dwY:             u32
	dwXSize:         u32
	dwYSize:         u32
	dwXCountChars:   u32
	dwYCountChars:   u32
	dwFillAttribute: u32
	dwFlags:         u32
	wShowWindow:     u16
	cbReserved2:     u16
	lpReserved2:     *byte
	hStdInput:       sys::Handle
	hStdOutput:      sys::Handle
	hStdError:       sys::Handle
}

struct processInformation {
	hProcess:    sys::Handle
	hThread:     sys::Handle
	dwProcessId: u32
	dwThreadId:  u32
}

const (
	_CREATE_UNICODE_ENVIRONMENT = 0x00000400
	_HANDLE_FLAG_INHERIT        = 0x00000001
	_STARTF_USESTDHANDLES       = 0x00000100
	_DUPLICATE_CLOSE_SOURCE     = 0x00000001
	_DUPLICATE_SAME_ACCESS      = 0x00000002
)

struct cmdAttrs {
	hProcess: sys::Handle
}

impl Cmd {
	fn spawn(*self, path: string, stdin: &File, stdout: &File, stderr: &File)! {
		utf16path := integ::UTF16FromString(path)
		argv := integ::UTF16FromString(makeCmdLine(self.args()))

		mut env := self.env()?
		envblock := createEnvBlock(env)?
		mut envp := &envblock[0]

		mut utf16dir := []u16(nil)
		mut dirp := (*u16)(nil)
		if self.Dir != "" {
			utf16dir = integ::UTF16FromString(self.Dir)
			dirp = &utf16dir[0]
		}

		proc := sys::GetCurrentProcess()

		mut hStdin := sys::InvalidHandle
		mut hStdout := sys::InvalidHandle
		mut hStderr := sys::InvalidHandle
		if unsafe { !sys::DuplicateHandle(proc, sys::Handle(stdin.fd.File), proc, &hStdin, 0, true, _DUPLICATE_SAME_ACCESS) } {
			throw sys::GetLastErrno()
		}
		unsafe defer { sys::DuplicateHandle(proc, hStdin, 0, nil, 0, false, _DUPLICATE_CLOSE_SOURCE) }
		if unsafe { !sys::DuplicateHandle(proc, sys::Handle(stdout.fd.File), proc, &hStdout, 0, true, _DUPLICATE_SAME_ACCESS) } {
			throw sys::GetLastErrno()
		}
		unsafe defer { sys::DuplicateHandle(proc, hStdout, 0, nil, 0, false, _DUPLICATE_CLOSE_SOURCE) }
		if unsafe { !sys::DuplicateHandle(proc, sys::Handle(stderr.fd.File), proc, &hStderr, 0, true, _DUPLICATE_SAME_ACCESS) } {
			throw sys::GetLastErrno()
		}
		unsafe defer { sys::DuplicateHandle(proc, hStderr, 0, nil, 0, false, _DUPLICATE_CLOSE_SOURCE) }

		mut si := startupInfo{}
		unsafe { extern.ZeroMemory(&si, mem::Sizeof(si)) }
		si.cb = u32(mem::Sizeof(si))
		si.dwFlags |= _STARTF_USESTDHANDLES
		si.hStdInput = hStdin
		si.hStdOutput = hStdout
		si.hStdError = hStderr

		mut pi := processInformation{}
		unsafe { extern.ZeroMemory(&pi, mem::Sizeof(pi)) }

		flags := u32(_CREATE_UNICODE_ENVIRONMENT)
		willInheritHandles := unsafe { c::Int(1) } // True
		unsafe {
			if extern.CreateProcessW((*c::Wchar)(&utf16path[0]),
				(*c::Wchar)(&argv[0]), nil, nil, willInheritHandles,
				extern.DWORD(flags), envp, (*c::Wchar)(dirp),
				(*extern.STARTUPINFOW)(&si),
				(*extern.PROCESS_INFORMATION)(&pi)) == 0 {
				throw sys::GetLastErrno()
			}
		}
		self.attrs.hProcess = pi.hProcess
		sys::CloseHandle(pi.hThread)?
	}

	fn kill(*self)! {
		if unsafe { extern.TerminateProcess(extern.HANDLE(self.attrs.hProcess), 0) } {
			sys::CloseHandle(sys::Handle(self.attrs.hProcess))?
			self.attrs.hProcess = 0
			return
		}
		throw sys::GetLastErrno()
	}

	fn wait(*self)!: int {
		unsafe { extern.WaitForSingleObject(extern.HANDLE(self.attrs.hProcess), windows::INFINITE) }
		mut exitCode := unsafe { c::LongLong(0) }
		unsafe {
			extern.GetExitCodeProcess(extern.HANDLE(self.attrs.hProcess), &exitCode)
			sys::CloseHandle(sys::Handle(self.attrs.hProcess))?
		}
		self.attrs.hProcess = 0
		return unsafe { int(exitCode) }
	}
}

// Escapes the string s, as per escapeArg, appends the result to s.
fn appendEscapeArg(mut &s: *strings::Builder, arg: string) {
	if len(arg) == 0 {
		s.WriteString(`""`)!
		return
	}

	mut needsBackslash := false
	mut hasSpace := false
	mut i := 0
	for i < len(arg); i++ {
		match arg[i] {
		| '"' | '\\':
			needsBackslash = true
		| ' ' | '\t':
			hasSpace = true
		}
	}

	if !needsBackslash && !hasSpace {
		// No special handling required; normal case.
		s.WriteString(arg)!
		return
	}
	if !needsBackslash {
		// hasSpace is true, so we need to quote the string.
		s.WriteByte('"')!
		s.WriteString(arg)!
		s.WriteByte('"')!
		return
	}

	if hasSpace {
		s.WriteByte('"')!
	}
	mut slashes := 0
	i = 0
	for i < len(arg); i++ {
		c := arg[i]
		match c {
		| '\\':
			slashes++
		| '"':
			for slashes > 0; slashes-- {
				s.WriteByte('\\')!
			}
			s.WriteByte('\\')!
		|:
			slashes = 0
		}
		s.WriteByte(c)!
	}
	if hasSpace {
		for slashes > 0; slashes-- {
			s.WriteByte('\\')!
		}
		s.WriteByte('"')!
	}
}

// Builds a command line out of args by escaping "special"
// characters and joining the arguments with spaces.
fn makeCmdLine(args: []string): string {
	mut s := strings::Builder{}
	s.Grow(1 << 4)
	for _, arg in args {
		if s.Len() > 0 {
			s.WriteByte(' ')!
		}
		appendEscapeArg(&s, arg)
	}
	return s.String()
}

// Converts an array of environment strings into
// the representation required by CreateProcess: a sequence of NULL
// terminated strings followed by a nil.
// Last bytes are two UCS-2 NULLs, or four NULL bytes.
// If any string contains a NULL, it returns (nil, EINVAL).
fn createEnvBlock(env: []string)!: []u16 {
	if len(env) == 0 {
		return utf16::Encode([]rune("\x00\x00"))
	}
	mut n := 0
	for _, s in env {
		if strings::IndexByte(s, 0) != -1 {
			throw sys::EINVAL
		}
		n += len(s) + 1
	}
	n++
	mut b := make([]u16, 0, n)
	for _, s in env {
		for _, c in s {
			b = utf16::AppendRune(b, c)
		}
		b = utf16::AppendRune(b, 0)
	}
	b = utf16::AppendRune(b, 0)
	return b
}

fn chkStat(file: string)! {
	d := Stat(file)?
	if d.IsDir() {
		throw sys::Errno(sys::ERROR_ACCESS_DENIED)
	}
}

fn hasExt(file: string): bool {
	i := strings::LastIndex(file, ".")
	if i < 0 {
		return false
	}
	return strings::LastIndexAny(file, `:\/`) < i
}

fn findExecutable(file: string, exts: []string)!: string {
	if len(exts) == 0 {
		chkStat(file)?
		return file
	}
	if hasExt(file) {
		chkStat(file) else { goto Keep }
		return file
	Keep:
		// Keep checking exts below, so that programs with weird names
		// like "foo.bat.exe" will resolve instead of failing.
	}
	for _, e in exts {
		f := file + e
		chkStat(f) else { continue }
		return f
	}
	if hasExt(file) {
		throw sys::Errno(sys::ERROR_FILE_NOT_FOUND)
	}
	throw errNotFound
}

fn pathExt(): (exts: []string) {
	x := Getenv(`PATHEXT`)
	if x != "" {
		for (_, mut e) in strings::Split(strings::ToLower(x), `;`) {
			if e == "" {
				continue
			}
			if e[0] != '.' {
				e = "." + e
			}
			exts = append(exts, e)
		}
	} else {
		exts = [".com", ".exe", ".bat", ".cmd"]
	}
	return exts
}

// Finds windows executable by its dir and path.
// It uses lookPath to try appropriate extensions.
// It does not search PATH, instead it converts `prog` into `.\prog`.
//
// If the path already has an extension found in PATHEXT,
// it returns it directly without searching
// for additional extensions. For example,
// "C:\foo\example.com" would be returned as-is even if the
// program is actually "C:\foo\example.com.exe".
fn lookExtensions(mut path: string, dir: string)!: string {
	if filepathlite::Base(path) == path {
		path = "." + string(PathSeparator) + path
	}
	exts := pathExt()
	mut ext := filepathlite::Ext(path)
	if ext != "" {
		for _, e in exts {
			if strings::EqualFold(ext, e) {
				// Assume that path has already been resolved.
				return path
			}
		}
	}
	if dir == "" {
		return _lookPath(path, exts)?
	}
	if filepathlite::VolumeName(path) != "" {
		return _lookPath(path, exts)?
	}
	if len(path) > 1 && filepathlite::IsPathSeparator(path[0]) {
		return _lookPath(path, exts)?
	}
	dirandpath := filepathlite::Join(dir, path)
	// We assume that LookPath will only add file extension.
	lp := _lookPath(dirandpath, exts)?
	ext = strings::TrimPrefix(lp, dirandpath)
	return path + ext
}

fn lookPath(file: string)!: string {
	return _lookPath(file, pathExt())?
}

// Implements lookPath for the given PATHEXT list.
fn _lookPath(file: string, exts: []string)!: string {
	if strings::ContainsAny(file, `:\/`) {
		return findExecutable(file, exts) else { throw &lookpathError{file, error} }
	}

	// On Windows, creating the NoDefaultCurrentDirectoryInExePath
	// environment variable (with any value or no value!) signals that
	// path lookups should skip the current directory.
	// In theory we are supposed to call NeedCurrentDirectoryForExePathW
	// "as the registry location of this environment variable can change"
	// but that seems exceedingly unlikely: it would break all users who
	// have configured their environment this way!
	// https://docs.microsoft.com/en-us/windows/win32/api/processenv/nf-processenv-needcurrentdirectoryforexepathw
	// See also go.dev/issue/43947.
	_, found := LookupEnv("NoDefaultCurrentDirectoryInExePath")
	if !found {
		f := findExecutable(filepathlite::Join(".", file), exts) else { use "><" }
		if f != "><" {
			return f
		}
	}

	mut dotf := ""
	mut dotErr := any(nil)
	path := Getenv("path")
	for _, dir in filepathlite::SplitList(path) {
		if dir == "" {
			// Skip empty entries, consistent with what PowerShell does.
			// (See https://go.dev/issue/61493#issuecomment-1649724826.)
			continue
		}

		f := findExecutable(filepathlite::Join(dir, file), exts) else { continue }
		if dotErr != nil {
			// https://go.dev/issue/53536: if we resolved a relative path implicitly,
			// and it is the same executable that would be resolved from the explicit %PATH%,
			// prefer the explicit name for the executable (and, likely, no error) instead
			// of the equivalent implicit name with errDot.
			//
			// Otherwise, return the errDot for the implicit path as soon as we find
			// out that the explicit one doesn't match.
			dotfi := Lstat(dotf) else {
				if dotErr != nil {
					unsafe throw dotErr
				}
				return dotf
			}
			fi := Lstat(f) else {
				if dotErr != nil {
					unsafe throw dotErr
				}
				return dotf
			}
			if !dotfi.SameFile(fi) {
				if dotErr != nil {
					unsafe throw dotErr
				}
				return dotf
			}
		}

		if !filepathlite::IsAbs(f) {
			// If this is the same relative path that we already found,
			// dotErr is non-nil and we already checked it above.
			// Otherwise, record this path as the one to which we must resolve,
			// with or without a dotErr.
			if dotErr == nil {
				dotf, dotErr = f, &lookpathError{file, errDot}
			}
			continue
		}
		return f
	}

	if dotErr != nil {
		unsafe throw dotErr
	}
	throw &lookpathError{file, errNotFound}
}