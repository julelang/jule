use "std/integ"
use "std/internal/poll"
use "std/mem"
use "std/sys"

const devNull = "NUL"

// File descriptors for the standard out, standard error and standard input.
let mut stdin = newFile(u64(sys::STDIN), poll::File)
let mut stdout = newFile(u64(sys::STDOUT), poll::File)
let mut stderr = newFile(u64(sys::STDERR), poll::File)

fn openFile(mut path: string, flag: int, mut perm: FileMode)!: &File {
	path = fixLongPath(path)
	h := sys::Open(path, flag|sys::O_CLOEXEC, u32(perm))?
	return newFile(u64(h), poll::File)
}

fn newFile(h: u64, mut flags: int): &File {
	if flags&poll::File != 0 {
		t, err := unsafe { sys::GetFileType(sys::Handle(h)) }
		if err || t == sys::FILE_TYPE_CHAR {
			mut m := u32(0)
			if unsafe { sys::GetConsoleMode(sys::Handle(h), &m) } {
				flags &= ^poll::File
				flags |= poll::Console
			}
		} else if t == sys::FILE_TYPE_PIPE {
			flags &= ^poll::File
			flags |= poll::Pipe
		}
	}
	mut fd := &poll::FD{
		File:          h,
		Flags:         flags,
		IsStream:      true,
		ZeroReadIsEOF: true,
	}
	// Ignore initialization errors.
	// Assume any problems will show up in later I/O.
	fd.Init(false) else {}
	return &File{fd: fd}
}

fn remove(path: string)! {
	utf16Path := integ::UTF16FromString(fixLongPath(path))
	if unsafe { !sys::DeleteFile(&utf16Path[0]) } {
		throw sys::GetLastErrno()
	}
}