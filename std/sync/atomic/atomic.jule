// Atomically stores new into p and returns the previous value.
fn Swap[T: ~int | ~uint | ~i8 | ~i16 | ~i32 | ~i64 | ~u8 | ~u16 | ~u32 | ~u64 | ~uintptr](mut &p: *T, new: T, order: memoryOrder): (old: T) {
	return atomic::Swap(p, new, order)
}

// Performs an atomic compare-and-swap (CAS) operation on a memory location.
//
// Compares the value at p with old. If equal, replaces it with new and returns true.
// If unequal, writes the current value at p into old and returns false.
fn CompareAndSwap[T: ~int | ~uint | ~i8 | ~i16 | ~i32 | ~i64 | ~u8 | ~u16 | ~u32 | ~u64 | ~uintptr](mut &p: *T, mut &old: *T, new: T, succ: memoryOrder, fail: memoryOrder): (swapped: bool) {
	return atomic::CompareAndSwap(p, old, new, succ, fail)
}

// Performs an atomic compare-and-swap (CAS) operation on a memory location.
//
// Compares the value at p with old. If equal, replaces it with new and returns true.
// If unequal, writes the current value at p into old and returns false.
fn CompareAndSwapWeak[T: ~int | ~uint | ~i8 | ~i16 | ~i32 | ~i64 | ~u8 | ~u16 | ~u32 | ~u64 | ~uintptr](mut &p: *T, mut &old: *T, new: T, succ: memoryOrder, fail: memoryOrder): (swapped: bool) {
	return atomic::CompareAndSwapWeak(p, old, new, succ, fail)
}

// Atomically adds delta to p and returns the new value.
// Only integer types are supported.
fn Add[T: ~int | ~uint | ~i8 | ~i16 | ~i32 | ~i64 | ~u8 | ~u16 | ~u32 | ~u64 | ~uintptr](mut &p: *T, delta: T, order: memoryOrder): (new: T) {
	return atomic::Add(p, delta, order)
}

// Atomically loads p.
fn Load[T: ~int | ~uint | ~i8 | ~i16 | ~i32 | ~i64 | ~u8 | ~u16 | ~u32 | ~u64 | ~uintptr](&p: *T, order: memoryOrder): T {
	return atomic::Load(p, order)
}

// Atomically stores val into p.
fn Store[T: ~int | ~uint | ~i8 | ~i16 | ~i32 | ~i64 | ~u8 | ~u16 | ~u32 | ~u64 | ~uintptr](mut &p: *T, val: T, order: memoryOrder) {
	atomic::Store(p, val, order)
}

// Fences create synchronization between themselves and
// atomic operations or fences in other threads.
// It can be helpful to think of a fence as preventing the compiler and
// CPU from reordering certain types of memory operations around it,
// but that is a simplified model which fails to capture some of the nuances.
fn Fence(order: memoryOrder) {
	atomic::Fence(order)
}