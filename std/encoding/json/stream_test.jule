use "std/io"
use "std/strings"
use "std/testing"

struct scanTest {
	input: string
	n:     int
	err:   bool // Last read must be error.
}

let scanTests: []scanTest = [
	{
		input: ``,
		n:     1,
		err:   true, // EOF
	},
	{
		input: `123`,
		n:     1,
		err:   false,
	},
	{
		input: `"hello world"`,
		n:     1,
		err:   false,
	},
	{
		input: `"hello world",`,
		n:     2,
		err:   true,
	},
	{
		input: `"hello world","hello world"`,
		n:     2,
		err:   true,
	},
	{
		input: `["hello world","hello world"]`,
		n:     2,
		err:   true, // EOF
	},
	{
		input: `["hello world","hello world"`,
		n:     1,
		err:   true,
	},
	{
		input: `{`,
		n:     1,
		err:   true,
	},
	{
		input: `{}`,
		n:     1,
		err:   false,
	},
	{
		input: `{`,
		n:     1,
		err:   true,
	},
	{
		input: `[]`,
		n:     1,
		err:   false,
	},
	{
		input: `{"foo": 123, "bar": false, "baz": null}`,
		n:     1,
		err:   false,
	},
	{
		input: `{"foo": 123, "bar" false, "baz": null}`,
		n:     1,
		err:   true,
	},
	{
		input: `{"foo": 123, "bar": false, "baz": null} {"foo": 456, "bar": true, "baz": null}`,
		n:     2,
		err:   false,
	},
	{
		input: `{"foo": 123, "bar": false, "baz": null} {"foo" 123, "bar": false, "baz": null}`,
		n:     2,
		err:   true,
	},
	{
		input: `null123true"foobarbaz"{}[]`,
		n:     6,
		err:   false,
	},
]

#test
fn testDecoderDecode(t: &testing::T) {
	let mut v: Value
	for i, test in scanTests {
		mut r := strings::Reader.New(test.input)
		dec := Decoder.New(r)
		mut n := test.n
		for n > 0; n-- {
			let mut err: any
			dec.Decode(&v) else { err = error }
			if n > 1 && err != nil {
				t.Errorf("#{} unexpected error: {}", i, err)
				break
			}
			if n == 1 && (err != nil) != test.err {
				t.Errorf("#{} unexpected error: {}", i, err)
				break
			}
		}
		if !test.err {
			dec.Decode(&v) else {
				if error == io::EOF {
					continue
				}
				t.Errorf("#{} expected EOF, found: {}", i, error)
				continue
			}
			t.Errorf("#{} expected EOF, but decoded", i)
		}
	}
}

struct enctestobj {
	Foo: int `json:"foo"`
	Bar: int `json:"bar"`
}

struct encoderTest {
	encode: fn(enc: &Encoder)!
	out:    string
}

let encoderTests: []encoderTest = [
	{
		encode: fn|enc| enc.Encode(123)?,
		out:    "123\n",
	},
	{
		encode: fn|enc| enc.Encode(123.456)?,
		out:    "123.456\n",
	},
	{
		encode: fn|enc| enc.Encode("hello world")?,
		out:    "\"hello world\"\n",
	},
	{
		encode: fn|enc| enc.Encode((&int)(nil))?,
		out:    "null\n",
	},
	{
		encode: fn|enc| enc.Encode([1, 2, 3, 4, 5])?,
		out:    "[1,2,3,4,5]\n",
	},
	{
		encode: fn|enc| enc.Encode(enctestobj{Foo: 123, Bar: 456})?,
		out:    "{\"foo\":123,\"bar\":456}\n",
	},
	{
		encode: fn|enc| {
			enc.Encode(enctestobj{Foo: 123, Bar: 456})?
			enc.Encode(enctestobj{Foo: 123, Bar: 456})?
		},
		out: "{\"foo\":123,\"bar\":456}\n{\"foo\":123,\"bar\":456}\n",
	},
	{
		encode: fn|enc| {
			enc.Encode(enctestobj{Foo: 123, Bar: 456})?
			enc.Encode(enctestobj{Foo: 123, Bar: 456})?
			enc.Encode((&int)(nil))?
			enc.Encode([1, 2, 3, 4, 5])?
		},
		out: "{\"foo\":123,\"bar\":456}\n{\"foo\":123,\"bar\":456}\nnull\n[1,2,3,4,5]\n",
	},
]

#test
fn testEncoderEncode(t: &testing::T) {
	for i, test in encoderTests {
		mut w := new(strings::Builder)
		enc := Encoder.New(w)
		test.encode(enc) else {
			t.Errorf("#{} unexpected error: {}", i, error)
			continue
		}
		s := w.String()
		if s != test.out {
			println(s)
			t.Errorf("#{} unexpected output", i)
			continue
		}
	}
}

struct testobj {
	Foo: int
}

#test
fn testDisallowUnknownFields(t: &testing::T) {
	let mut v: testobj
	s := `{"Foo": 120}{"Foo": 123, "bar": "baz"}`
	dec := Decoder.New(strings::Reader.New(s))
	dec.DisallowUnknownFields()
	dec.Decode(&v) else {
		t.Errorf("unexpected error at first read")
		return
	}
	dec.Decode(&v) else {
		return
	}
	t.Errorf("expected error at second read")
}