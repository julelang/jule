	| 8:
		z = (z << 3) + (z << 1) + u64(b[0]-'0')
		z = (z << 3) + (z << 1) + u64(b[1]-'0')
		z = (z << 3) + (z << 1) + u64(b[2]-'0')
		z = (z << 3) + (z << 1) + u64(b[3]-'0')
		z = (z << 3) + (z << 1) + u64(b[4]-'0')
		z = (z << 3) + (z << 1) + u64(b[5]-'0')
		z = (z << 3) + (z << 1) + u64(b[6]-'0')
		z = (z << 3) + (z << 1) + u64(b[7]-'0')
	| 7:
		z = (z << 3) + (z << 1) + u64(b[0]-'0')
		z = (z << 3) + (z << 1) + u64(b[1]-'0')
		z = (z << 3) + (z << 1) + u64(b[2]-'0')
		z = (z << 3) + (z << 1) + u64(b[3]-'0')
		z = (z << 3) + (z << 1) + u64(b[4]-'0')
		z = (z << 3) + (z << 1) + u64(b[5]-'0')
		z = (z << 3) + (z << 1) + u64(b[6]-'0')
	| 6:
		z = (z << 3) + (z << 1) + u64(b[0]-'0')
		z = (z << 3) + (z << 1) + u64(b[1]-'0')
		z = (z << 3) + (z << 1) + u64(b[2]-'0')
		z = (z << 3) + (z << 1) + u64(b[3]-'0')
		z = (z << 3) + (z << 1) + u64(b[4]-'0')
		z = (z << 3) + (z << 1) + u64(b[5]-'0')
	| 5:
		z = (z << 3) + (z << 1) + u64(b[0]-'0')
		z = (z << 3) + (z << 1) + u64(b[1]-'0')
		z = (z << 3) + (z << 1) + u64(b[2]-'0')
		z = (z << 3) + (z << 1) + u64(b[3]-'0')
		z = (z << 3) + (z << 1) + u64(b[4]-'0')
	| 4:
		z = (z << 3) + (z << 1) + u64(b[0]-'0')
		z = (z << 3) + (z << 1) + u64(b[1]-'0')
		z = (z << 3) + (z << 1) + u64(b[2]-'0')
		z = (z << 3) + (z << 1) + u64(b[3]-'0')
	| 3:
		z = (z << 3) + (z << 1) + u64(b[0]-'0')
		z = (z << 3) + (z << 1) + u64(b[1]-'0')
		z = (z << 3) + (z << 1) + u64(b[2]-'0')
	| 2:
		z = (z << 3) + (z << 1) + u64(b[0]-'0')
		z = (z << 3) + (z << 1) + u64(b[1]-'0')
	| 1:
		z = (z << 3) + (z << 1) + u64(b[0]-'0')
	}

	const unsafeWidth = 20
	match {
	| (b[0] == '0' && len(b) != 1):
		return 0, false
	| len(b) >= unsafeWidth && (b[0] != '1' || z < 1e19 || len(b) > unsafeWidth):
		return u64.Max, false
	}

	return z, true
}

#disable nilptr boundary
fn decodeUInt[T](mut &v: *T, b: []byte)! {
	const t = comptime::Typeof(T)

	// Negative value for unsigned type.
	if intrinsic::Unlikely(b[0] == '-') {
		throw errors::New("json: invalid value for type " + t.String() + ": " + unsafe::BytesString(b))
	}

	z, ok := decodeUintRaw(b)
	if intrinsic::Unlikely(!ok) {
		if z != u64.Max {
			throw errors::New("json: invalid value for type " + t.String() + ": " + unsafe::BytesString(b))
		}
		throw errors::New("json: value overflows type " + t.String() + ": " + unsafe::BytesString(b))
	}
	const maxUint = u64(1)<<t.Bits() - 1
	if intrinsic::Unlikely(z > maxUint) {
		throw errors::New("json: value overflows type " + t.String() + ": " + unsafe::BytesString(b))
	}

	*v = T(z)
}

#disable nilptr boundary
fn decodeInt[T](mut &v: *T, b: []byte)! {
	const t = comptime::Typeof(T)
	const Max = 1 << (t.Bits() - 1)
	if b[0] == '-' {
		z, ok := decodeUintRaw(b[1:])
		if intrinsic::Unlikely(!ok) {
			if z != u64.Max {
				throw errors::New("json: invalid value for type " + t.String() + ": " + unsafe::BytesString(b))
			}
			throw errors::New("json: value overflows type " + t.String() + ": " + unsafe::BytesString(b))
		}
		if intrinsic::Unlikely(z > Max) {
			throw errors::New("json: value overflows type " + t.String() + ": " + unsafe::BytesString(b))
		}
		*v = -T(z)
	} else {
		z, ok := decodeUintRaw(b)
		if intrinsic::Unlikely(!ok) {
			if z != u64.Max {
				throw errors::New("json: invalid value for type " + t.String() + ": " + unsafe::BytesString(b))
			}
			throw errors::New("json: value overflows type " + t.String() + ": " + unsafe::BytesString(b))
		}
		if intrinsic::Unlikely(z >= Max) {
			throw errors::New("json: value overflows type " + t.String() + ": " + unsafe::BytesString(b))
		}
		*v = T(z)
	}
}

#disable nilptr
fn decodeFloat[T](mut &v: *T, b: []byte)! {
	// Use [unsafe::BytesString] instead of casting.
	// The byte buffer will not change, so it's safe and efficient.
	const t = comptime::Typeof(T)
	n := conv::ParseFloat(unsafe::BytesString(b), t.Bits()) catch {
		numErr, ok := error.(&conv::NumError)
		if ok && numErr.Err == conv::ErrRange {
			throw errors::New("json: value overflows type " + t.String() + ": " + unsafe::BytesString(b))
		}
		throw errors::New("json: invalid value for type " + t.String() + ": " + unsafe::BytesString(b))
	}
	*v = (T)(n)
}

// Unquotes the JSON string literal s.
// Returns nil if failed.
// This function implements the JSON strings grammar.
// See https://tools.ietf.org/html/rfc7159#section-7
// and https://www.json.org/img/string.png
//
// We use "#disable boundary" with slices.
// However, [ubuf::Ubuf] was ~25% faster on a 64-bit MacBook Pro.
fn unquoteBytes(s: []byte): ([]byte, escape: bool) {
	ss := ubuf::Ubuf{}
	ss.SetData(s)
	if ss.Len() < 2 || ss.Get(0) != '"' || ss.Get(ss.Len()-1) != '"' {
		return nil, false
	}
	// Empty literal.
	if ss.Len() == 2 {
		return make([]byte, 0), false
	}
	ss.SetLen2(1, ss.Len()-1)

	// Check for unusual characters. If there are none,
	// then no unquoting is needed, so return a slice of the
	// original bytes.
	mut r := 0
	for r < ss.Len() {
		c := ss.Get(r)
		if c == '\\' || c == '"' || c < ' ' {
			break
		}
		if c < utf8::RuneSelf {
			r++
			continue
		}
		rr, size := utf8::DecodeRune(ss.Slice1(r))
		if rr == utf8::RuneError && size == 1 {
			break
		}
		r += size
	}
	if r == ss.Len() {
		// GC must be remain for the allocation.
		// For memory efficiency, new allocation might be used as result or etc.
		// Therefore avoid making allocation zero-reference and deallocation.
		return ss.GetData(), false
	}

	b := ubuf::Ubuf{}
	b.SetData(make([]byte, ss.Len()+2*utf8::UTFMax))
	mut w := copy(b.Slice1(0), ss.Slice3(r))
	for r < ss.Len() {
		// Out of room? Can only happen if s is full of
		// malformed UTF-8 and we're replacing each
		// byte with RuneError.
		if w >= b.Len()-utf8::UTFMax*2 {
			mut nb := make([]byte, (b.Len()+utf8::UTFMax)*2)
			copy(nb, b.Slice3(w))
			b.SetData(nb)
		}
		c := ss.Get(r)
		match {
		| c == '\\':
			r++
			if r >= ss.Len() {
				return nil, false
			}
			match ss.Get(r) {
			| '\\':
				escape = true
				fall
			| '"' | '/' | '\'':
				b.Set(w, ss.Get(r))
				r++
				w++
			| 'b':
				b.Set(w, '\b')
				r++
				w++
			| 'f':
				b.Set(w, '\f')
				r++
				w++
			| 'n':
				b.Set(w, '\n')
				r++
				w++
			| 'r':
				b.Set(w, '\r')
				r++
				w++
			| 't':
				b.Set(w, '\t')
				r++
				w++
			| 'u':
				r--
				mut rr := getu4(ss.Slice1(r))
				if rr < 0 {
					return nil, false
				}
				r += 6
				if utf16::IsSurrogate(rr) {
					rr1 := getu4(ss.Slice1(r))
					dec := utf16::DecodeRune(rr, rr1)
					if dec != unicode::ReplacementChar {
						// A valid pair; consume.
						r += 6
						w += utf8::EncodeRune(b.Slice1(w), dec)
						break
					}
					// Invalid surrogate; fall back to replacement rune.
					rr = unicode::ReplacementChar
				}
				w += utf8::EncodeRune(b.Slice1(w), rr)
			|:
				return nil, false
			}
		| c == '"' | c < ' ':
			// Quote, control characters are invalid.
			return nil, false
		| c < utf8::RuneSelf:
			// ASCII
			b.Set(w, c)
			r++
			w++
		|:
			// Coerce to well-formed UTF-8.
			rr, size := utf8::DecodeRune(ss.Slice1(r))
			r += size
			w += utf8::EncodeRune(b.Slice1(w), rr)
		}
	}
	// GC must be remain for the allocation, do not use b.Slice3 to slice.
	// For memory efficiency, new allocation might be used as result or etc.
	// Therefore avoid making allocation zero-reference and deallocation.
	return b.GetData()[0:w], escape
}

#disable nilptr boundary
fn decodeString(scanFlags: int, mut &s: *string, mut lit: []byte): (ok: bool) {
	let mut s2: []byte
	if scanFlags&unquoteMask != 0 {
		s2, _ = unquoteBytes(lit)
		if intrinsic::Unlikely(s2 == nil) {
			return false
		}
	} else {
		s2 = lit[1 : len(lit)-1]
	}
	if len(s2) == 0 {
		*s = ""
		return true
	}
	if &lit[1] == &s2[0] {
		// Returned mutable slice from self.data slice.
		// We should to cast string to make new allocation.
		*s = string(s2)
	} else {
		// Returned slice from new allocation.
		// First element always will point to head element of allocation.
		// So we can return as string directly without making new allocation.
		*s = unsafe::StringFromBytes(s2)
	}
	return true
}