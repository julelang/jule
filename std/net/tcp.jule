use "std/internal/conv"

// Represents the address of a TCP end point.
struct TCPAddr {
	IP:   IP
	Port: int
	Zone: string // IPv6 scoped addressing zone.
}

impl Addr for TCPAddr {
	// Returns the address's network name.
	fn Network(*self): string {
		return "tcp"
	}

	// Returns string form of address.
	fn String(*self): string {
		ip := self.IP.ipEmptyString()
		if self.Zone != "" {
			return JoinHostPort(ip+"%"+self.Zone, conv::Itoa(self.Port))
		}
		return JoinHostPort(ip, conv::Itoa(self.Port))
	}
}

impl addr for TCPAddr {
	fn ip(mut *self): IP { return self.IP }
	fn port(*self): int { return self.Port }
}

impl TCPAddr {
	// Returns an address of TCP end point.
	// The network must be a TCP network name.
	//
	// If the host in the address parameter is not a literal IP address or
	// the port is not a literal port number, it resolves the
	// address to an address of TCP end point.
	// Otherwise, it parses the address as a pair of literal IP address
	// and port number.
	// The address parameter can use a host name, but this is not
	// recommended, because it will return at most one of the host name's
	// IP addresses.
	//
	// See the [Dial] function for a description of the network and address parameters.
	fn Resolve(mut network: Network, address: string)!: &TCPAddr {
		match network {
		| TCP | TCP4 | TCP6:
			mut addrs := resolveInternetAddrList(network, address)?
			return addrs.forResolve(network, address).(&TCPAddr)
		|:
			throw &AddrError{Err: "invalid network: " + string(network)}
		}
	}
}