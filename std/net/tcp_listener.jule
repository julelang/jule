use "std/internal/poll"
use "std/mem"
use "std/sys"
use "std/time"

// TCP listener.
// In most cases, represents TCP server.
struct TCPListener {
	addr:   &TCPAddr
	ipv:    int // 4 for IPv4, 6 for IPv6
	mut fd: &netFD
}

impl Listener for TCPListener {}

impl TCPListener {
	// Binds new TCP listener and starts listening given address.
	// Returns relevant created &TCPListener if success.
	// If addr is not a valid address, it will forward relevant parse error.
	// In addition, any bind and listening error will be thrown as error.
	//
	// See the [Dial] function for a description of the addr parameter.
	fn Bind(addr: string)!: &TCPListener {
		return tcpBind(Network.TCP, addr)?
	}

	// Accepts incoming connection, returns &TCPConn.
	// Panics if connection is closed.
	fn Accept(*self)!: Conn {
		if self.fd == nil {
			panic("net: TCPListener.Accept: connection is not open")
		}
		mut fd, mut addr := self.fd.accept(self.ipv)?
		return newTCPConn(&TCPConn{fd: fd, Addr: addr})
	}

	// Returns network name which is listening.
	// If connection closed, returns Network.TCP as a general network.
	fn Network(*self): Network {
		match {
		| self.fd == nil:
			return Network.TCP
		| self.ipv == 4:
			return Network.TCP4
		| self.ipv == 6:
			return Network.TCP6
		|:
			return Network.TCP
		}
	}

	// Closes connection.
	fn Close(mut *self)! {
		if self.fd == nil {
			return
		}
		self.fd.Close()?
		self.fd = nil
		self.ipv = 0
	}
}

fn tcpBind(network: Network, addr: string)!: &TCPListener {
	mut tcpAddr := TCPAddr.Resolve(network, addr)?
	mut fd := (&netFD)(nil)
	let mut ipv: int
	if tcpAddr.IP.Empty() {
		match network {
		| TCP | TCP4:
			ipv = 4
			mut sockaddr := sys::RawSockaddrInet4{}
			fd = socketipv4(false, uintptr(&sockaddr), tcpAddr, sys::SOCK_STREAM, 0)?
		| TCP6:
			ipv = 6
			mut sockaddr := sys::RawSockaddrInet6{}
			fd = socketipv6(false, uintptr(&sockaddr), tcpAddr, sys::SOCK_STREAM, 0)?
		|:
			throw &AddrError{Err: "invalid network: " + string(network)}
		}
	} else {
		mut ipv4 := tcpAddr.IP.To4()
		if ipv4.Empty() {
			if network == Network.TCP4 {
				throw &AddrError{Err: "expected IPv4 address but found IPv6", Addr: addr}
			}
			ipv = 6
			mut sockaddr := sys::RawSockaddrInet6{}
			fd = socketipv6(false, uintptr(&sockaddr), tcpAddr, sys::SOCK_STREAM, 0)?
		} else {
			if network == Network.TCP6 {
				throw &AddrError{Err: "expected IPv6 address but found IPv4", Addr: addr}
			}
			ipv = 4
			tcpAddr.IP = ipv4
			mut sockaddr := sys::RawSockaddrInet4{}
			fd = socketipv4(false, uintptr(&sockaddr), tcpAddr, sys::SOCK_STREAM, 0)?
		}
	}
	return &TCPListener{
		ipv:  ipv,
		addr: tcpAddr,
		fd:   fd,
	}
}