use "std/internal/poll"
use "std/mem"
use "std/sys"
use "std/time"

impl netFD {
	#disable nilptr
	fn connect(mut *self, ipv: int, sockaddr: uintptr, socksize: sys::Socklen, timeout: time::Duration)! {
		h := self.Handle()
		if timeout == 0 {
			sys::Connect(h, sockaddr, socksize)?
			return
		}
		mut tv, ok := timevalFromDuration(timeout)
		if !ok {
			throw ErrInvalidTimeout
		}
		if tv.Sec == 0 && tv.Usec == 0 {
			sys::Connect(h, sockaddr, socksize)?
			return
		}
		closeSocketBlockingMode(h)?
		sys::Connect(h, sockaddr, socksize) else {
			if error != sys::WSAEWOULDBLOCK {
				openSocketBlockingMode(h)?
				throw error
			}
			mut fdW := sys::FdSet{}
			mut fdE := sys::FdSet{}
			fdW.Zero()
			fdW.Set(h)
			fdE.Zero()
			fdE.Set(h)
			res := sys::Select(0, nil, &fdW, &fdE, &tv) else {
				openSocketBlockingMode(h)?
				throw error
			}
			if res == 0 {
				// Timeout.
				openSocketBlockingMode(h)?
				throw ErrTimeout
			}
			if fdE.IsSet(h) {
				mut opt := 0
				mut optLen := sys::Socklen(mem::Sizeof(opt))
				sys::Getsockopt(h, sys::SOL_SOCKET, sys::SO_ERROR, uintptr(&opt), optLen)!
				openSocketBlockingMode(h)?
				throw int(opt)
			}
		}
		openSocketBlockingMode(h)?
		// Refresh socket properties.
		sys::Setsockopt(h, sys::SOL_SOCKET, sys::SO_UPDATE_CONNECT_CONTEXT, 0, 0)?
	}

	#disable nilptr
	fn accept(mut *self, ipv: int)!: (fd: &netFD, addr: &TCPAddr) {
		let mut h: poll::NetHandle
		let mut ip: IP
		let mut port: int
		match ipv {
		| 4:
			mut sockaddr := sys::RawSockaddrInet4{}
			mut sockaddrlen := sys::Socklen(mem::Sizeof(sockaddr))
			h = self.pfd.Accept(uintptr(&sockaddr), &sockaddrlen)?
			// Address will be handled by poll::FD.
			ip = make(IP, IPv4Len)
			copy(ip, IP(sockaddr.Addr[:]))
			port = int(ntohs(int(sockaddr.Port)))
		| 6:
			mut sockaddr := sys::RawSockaddrInet6{}
			mut sockaddrlen := sys::Socklen(mem::Sizeof(sockaddr))
			h = self.pfd.Accept(uintptr(&sockaddr), &sockaddrlen)?
			// Address will be handled by poll::FD.
			ip = make(IP, IPv6Len)
			copy(ip, IP(sockaddr.Addr[:]))
			port = int(ntohs(int(sockaddr.Port)))
		|:
			panic("unreachable")
		}
		addr = &TCPAddr{IP: ip, Port: port}
		fd = newFD(h, poll::Socket, sys::SOCK_STREAM)
		fd.init() else {
			fd.Close() else {}
			throw error
		}
		return
	}
}