use "std/internal/poll"
use "std/mem"
use "std/sys"
use "std/time"

impl netFD {
	#disable nilptr
	fn connect(mut *self, ipv: int, sockaddr: uintptr, socksize: sys::Socklen, timeout: time::Duration)! {
		fd := self.Handle()
		if timeout == 0 {
			sys::Connect(fd, sockaddr, socksize)?
			return
		}
		mut tv, ok := timevalFromDuration(timeout)
		if !ok {
			throw ErrInvalidTimeout
		}
		if tv.Sec == 0 && tv.Usec == 0 {
			sys::Connect(fd, sockaddr, socksize)?
			return
		}

		sys::SetNonblock(fd, true)?
		defer { sys::SetNonblock(fd, false) else {} }
		sys::Connect(fd, sockaddr, socksize) else {
			if error == sys::EISCONN {
				return
			}
			if error != sys::EINPROGRESS {
				throw error
			}
			mut fds := sys::FdSet{}
			fds.Zero()
			fds.Set(fd)
			for {
				res := sys::Select(fd+1, nil, &fds, nil, &tv) else {
					if error != sys::EINTR {
						throw error
					}
					use 0
				}
				if res > 0 {
					len2 := sys::Socklen(mem::Sizeof(int))
					opt := 0
					sys::Getsockopt(fd, sys::SOL_SOCKET, sys::SO_ERROR, uintptr(&opt), len2)?
					if opt != 0 {
						err := sys::Errno(opt)
						if err == sys::EISCONN {
							return
						}
						throw err
					}
					break
				} else {
					// Timeout.
					throw ErrTimeout
				}
			}
		}
		return
	}

	#disable nilptr
	fn accept(mut *self, ipv: int)!: (fd: &netFD, addr: &TCPAddr) {
		let mut h: poll::NetHandle
		let mut ip: IP
		let mut port: int
		match ipv {
		| 4:
			mut sockaddr := sys::RawSockaddrInet4{}
			mut sockaddrlen := sys::Socklen(mem::Sizeof(sockaddr))
			h = self.pfd.Accept(uintptr(&sockaddr), &sockaddrlen)?
			getSocketAddr(h, uintptr(&sockaddr), sockaddrlen)?
			ip = make(IP, IPv4Len)
			copy(ip, IP(sockaddr.Addr[:]))
			port = int(ntohs(int(sockaddr.Port)))
		| 6:
			mut sockaddr := sys::RawSockaddrInet6{}
			mut sockaddrlen := sys::Socklen(mem::Sizeof(sockaddr))
			h = self.pfd.Accept(uintptr(&sockaddr), &sockaddrlen)?
			getSocketAddr(h, uintptr(&sockaddr), sockaddrlen)?
			ip = make(IP, IPv6Len)
			copy(ip, IP(sockaddr.Addr[:]))
			port = int(ntohs(int(sockaddr.Port)))
		|:
			panic("unreachable")
		}
		addr = &TCPAddr{IP: ip, Port: port}
		fd = newFD(h, poll::Socket, sys::SOCK_STREAM)
		fd.init() else {
			fd.Close() else {}
			throw error
		}
		return
	}
}