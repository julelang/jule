use "std/integ/c"
use "std/internal/poll"
use "std/internal/sys/windows"
use "std/mem"
use "std/sys"
use "std/time"

fn syssocket(domain: int, typ: int, proto: int)!: poll::NetHandle {
	sock := sys::WSASocket(domain, typ, proto, nil, 0, windows::WSA_FLAG_OVERLAPPED|windows::WSA_FLAG_NO_HANDLE_INHERIT)?
	return poll::NetHandle(sock)
}

fn setSocketBlockingMode(handle: poll::NetHandle, mode: c::UnsignedLong)! {
	FIONBIO := 0x80000000 | (unsafe { (c::Long)(mem::Sizeof(c::UnsignedLong) & 0x7F) } << 16) | ('f' << 8) | 126
	size := u32(mem::Sizeof(u32))
	r := u32(0)
	unsafe {
		if sys::WSAIoctl(sys::Handle(handle), u32(FIONBIO), (*byte)(&mode), size, nil, 0, &r) == sys::SOCKET_ERROR {
			throw sys::Errno(sys::WSAGetLastError())
		}
	}
}

fn closeSocketBlockingMode(handle: poll::NetHandle)! {
	setSocketBlockingMode(handle, 1)?
}

fn openSocketBlockingMode(handle: poll::NetHandle)! {
	setSocketBlockingMode(handle, 0)?
}

fn maxListenerBacklog(): int {
	// When the socket backlog is SOMAXCONN, Windows will set the backlog to
	// "a reasonable maximum value".
	// See: https://learn.microsoft.com/en-us/windows/win32/api/winsock2/nf-winsock2-listen
	return sys::SOMAXCONN
}

fn setDefaultSockopts(handle: poll::NetHandle)! {
	// On Windows, overlapped mode is non-blocking.
	// Created sockets use WSA_FLAG_NO_HANDLE_INHERIT,
	// which is equals to CloseOnExec on UNIX.
	closeSocketBlockingMode(handle)?
}

fn setDefaultListenerSockopts(handle: poll::NetHandle)! {
	// Windows will reuse recently-used addresses by default.
	// SO_REUSEADDR should not be used here, as it allows
	// a socket to forcibly bind to a port in use by another socket.
	// This could lead to a non-deterministic behavior, where
	// connection requests over the port cannot be guaranteed
	// to be handled by the correct socket.
}

fn setSocketTimeout(handle: poll::NetHandle, scope: int, timeout: time::Duration)! {
	mut dwordTimeout := u32(timeout / time::Millisecond)
	sys::Setsockopt(handle, sys::SOL_SOCKET, scope, uintptr(&dwordTimeout), 4)?
}

fn init() {
	poll::InitWSA()
}