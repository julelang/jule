use "std/encoding/binary"
use "std/errors"
use "std/io"
use "std/math/rand"
use "std/runtime"
use "std/strings"
use "std/time"
use "std/unsafe"

// Contains minimal mappings between services names and port
// numbers for platforms that don't have a complete list of port numbers.
//
// See https://www.iana.org/assignments/service-names-port-numbers
//
// On Unix, this map is augmented by readServices via lookupPort.
let mut services = map[string]map[string]int{
	"udp": {
		"domain": 53,
	},
	"tcp": {
		"ftp":         21,
		"ftps":        990,
		"http":        80,
		"https":       443,
		"imap2":       143,
		"imap3":       220,
		"imaps":       993,
		"pop3":        110,
		"pop3s":       995,
		"smtp":        25,
		"submissions": 465,
		"ssh":         22,
		"telnet":      23,
	},
}

struct dnsHeader {
	ID:      u16
	Flags:   u16
	QDCount: u16
	ANCount: u16
	NSCount: u16
	ARCount: u16
}

let dnsrand = rand::New(rand::NewPCG(u64(runtime::nanotime()), u64(runtime::nanotime())))

const bigEndianU16Size = 2

// DNS qtype
const (
	_QTYPE_A     = 1
	_QTYPE_AAAA  = 28
	_QTYPE_MX    = 15
	_QTYPE_CNAME = 5
	_QTYPE_NS    = 2
	_QTYPE_TXT   = 16
	_QTYPE_SRV   = 33
	_QTYPE_PTR   = 12
	_QTYPE_SOA   = 6
	_QTYPE_ANY   = 255
)

struct dnsQuestion {
	QName:  []byte
	QType:  u16
	QClass: u16
}

// Encodes a domain like "www.example.com" to DNS wire format.
fn encodeDomainName(mut &buf: *[]byte, mut domain: string)! {
	handleLabel := fn(mut &buf: *[]byte, label: string)! {
		if len(label) > 63 {
			throw errors::New("label too long")
		}
		*buf = append(*buf, byte(len(label)))
		*buf = append(*buf, label...)
	}
	for {
		m := strings::IndexByte(domain, '.')
		if m < 0 {
			handleLabel(buf, domain)?
			break
		}
		handleLabel(buf, domain[:m])?
		domain = domain[m+1:]
	}
	*buf = append(*buf, 0) // terminator
}

// Maximum DNS packet size for UDP.
// Value taken from https://dnsflagday.net/2020/.
const maxDNSPacketSize = 1232

fn getDNSId(): u16 {
	return u16(dnsrand.IntN(65536))
}

// Builds a DNS query with EDNS and optional AD flag.
fn buildQuery(mut &buf: *[]byte, domain: string, mut &idPos: *int, mut &qtypePos: *int, trustAD: bool)! {
	if cap(*buf) == 0 {
		*buf = make([]byte, 0, maxDNSPacketSize)
	} else {
		*buf = (*buf)[:0]
	}
	*idPos = len(*buf)
	*buf = binary::BigEndian.AppendU16(*buf, 0) // ID
	mut flags := u16(0x0100)                    // standard query
	if trustAD {
		flags |= 0x0020 // set AD flag
	}
	*buf = binary::BigEndian.AppendU16(*buf, flags)
	*buf = binary::BigEndian.AppendU16(*buf, 1) // QDCOUNT
	*buf = binary::BigEndian.AppendU16(*buf, 0) // ANCOUNT
	*buf = binary::BigEndian.AppendU16(*buf, 0) // NSCOUNT
	*buf = binary::BigEndian.AppendU16(*buf, 1) // ARCOUNT (for EDNS)

	encodeDomainName(buf, domain)?
	*qtypePos = len(*buf)
	*buf = binary::BigEndian.AppendU16(*buf, 0) // QTYPE
	*buf = binary::BigEndian.AppendU16(*buf, 1) // QCLASS IN

	// OPT record for EDNS
	*buf = append(*buf, 0)                                     // name root
	*buf = binary::BigEndian.AppendU16(*buf, 41)               // TYPE: OPT
	*buf = binary::BigEndian.AppendU16(*buf, maxDNSPacketSize) // UDP payload size
	*buf = append(*buf, 0)                                     // extended RCODE
	*buf = append(*buf, 0)                                     // EDNS version
	*buf = binary::BigEndian.AppendU16(*buf, 0)                // Z
	*buf = binary::BigEndian.AppendU16(*buf, 0)                // RDLENGTH
}

// Handles DNS name parsing with label compression support.
fn parseName(msg: []byte, mut offset: int)!: (string, int) {
	let mut labels: []string
	mut original := offset
	mut jumped := false

	for {
		if offset >= len(msg) {
			throw errors::New("offset out of range")
		}
		b := msg[offset]
		if b == 0 {
			offset++
			break
		}

		if b&0xC0 == 0xC0 {
			if offset+1 >= len(msg) {
				throw errors::New("pointer out of range")
			}
			ptr := int(binary::BigEndian.DecodeU16(msg[offset:offset+bigEndianU16Size]) & 0x3FFF)
			if !jumped {
				original = offset + bigEndianU16Size
				jumped = true
			}
			offset = ptr
			continue
		}

		length := int(b)
		offset++
		if offset+length > len(msg) {
			throw errors::New("label out of range")
		}

		labels = append(labels, string(msg[offset:offset+length]))
		offset += length
	}

	name := strings::Join(labels, ".")
	if !jumped {
		return name, offset
	}
	return name, original
}

// Skips a (potentially compressed) DNS name starting at position pos
// and returns the offset immediately following the name in the original stream.
// Zero-allocation; includes safeguards against pointer loops and excessively long names.
#disable boundary
fn skipName(msg: []byte, pos: int): (next: int, ok: bool) {
	if pos < 0 || pos >= len(msg) {
		return 0, false
	}

	mut p := pos
	mut end := -1
	mut jumps := 0
	mut consumed := 0

	const maxJumps = 32
	const maxNameLen = 255

	for {
		if p >= len(msg) {
			return 0, false
		}
		ln := msg[p]

		if ln&0xC0 == 0xC0 {
			if p+1 >= len(msg) {
				return 0, false
			}
			if end == -1 {
				end = p + 2
			}
			jumps++
			if jumps > maxJumps {
				return 0, false
			}
			ptr := (int(ln&0x3F) << 8) | int(msg[p+1])
			if ptr >= len(msg) {
				return 0, false
			}
			p = ptr
			continue
		}

		if ln&0xC0 != 0 {
			return 0, false
		}

		if ln == 0 {
			p++
			if end == -1 {
				end = p
			}
			break
		}

		consumed += int(ln) + 1
		if consumed > maxNameLen {
			return 0, false
		}
		p++
		if p+int(ln) > len(msg) {
			return 0, false
		}
		p += int(ln)
	}

	return end, true
}

// Returns the transaction ID from the message header and verifies
// that it is actually a response packet (QR=1). If the QR bit is not set, the packet
// is rejected as non-response data (e.g., a query, stale, or spoofed response).
#disable boundary
fn parseResponseHead(msg: []byte): (id: u16, ok: bool) {
	if len(msg) < 12 {
		// Short response.
		return 0, false
	}
	id = binary::BigEndian.DecodeU16(msg[0:bigEndianU16Size])
	flags := binary::BigEndian.DecodeU16(msg[2 : 2+bigEndianU16Size])
	if flags&0x8000 == 0 {
		// QR bit is not set: this is a query, not a response.
		return id, false
	}
	return id, true
}

// Parses the DNS response and returns an IPAddr list with zone info if applicable.
// Only records matching the target query type (A or AAAA) are accepted. This prevents
// returning an address from the wrong family if a server/relay incorrectly responds
// to an AAAA query with an A record.
#disable boundary
fn parseResponseBody(msg: []byte): (addrs: []IPAddr, ok: bool) {
	if len(msg) < 12 {
		return nil, false
	}

	qdCount := binary::BigEndian.DecodeU16(msg[4 : 4+bigEndianU16Size])

	mut pos := 12

	// Skip Question section.
	mut i := 0
	for i < int(qdCount); i++ {
		next, nok := skipName(msg, pos)
		if !nok {
			return nil, false
		}
		pos = next
		if pos+4 > len(msg) {
			return nil, false
		}
		pos += 4
	}

	// Scan Answer + Authority + Additional sections
	// Do NOT rely on header count fields (ANCOUNT/NSCOUNT/ARCOUNT); some servers
	// or relays misreport these numbers (e.g., EDNS0 OPT records appearing in
	// answer position and distorting ANCOUNT). Instead, continue scanning RRs
	// until the buffer ends. An iteration cap prevents infinite loops on malformed
	// or malicious data.
	const maxRR = 64
	i = 0
	for i < maxRR && pos < len(msg); i++ {
		next, nok := skipName(msg, pos)
		if !nok {
			break
		}
		pos = next
		if pos+10 > len(msg) {
			// Invalid RR.
			break
		}

		typ := binary::BigEndian.DecodeU16(msg[pos : pos+bigEndianU16Size])
		class := binary::BigEndian.DecodeU16(msg[pos+2 : pos+2+bigEndianU16Size])
		rdlen := binary::BigEndian.DecodeU16(msg[pos+8 : pos+8+bigEndianU16Size])
		pos += 10

		if pos+int(rdlen) > len(msg) {
			// Invalid RDLENGTH.
			break
		}

		rdata := msg[pos : pos+int(rdlen)]
		pos += int(rdlen)

		if class != 1 {
			// Non-IN class (e.g., OPT payload-size field): skip.
			continue
		}

		match typ {
		| _QTYPE_A:
			if rdlen == IPv4Len {
				mut ip := IPv4(rdata[0], rdata[1], rdata[2], rdata[3])
				addrs = append(addrs, IPAddr{IP: ip})
			}
		| _QTYPE_AAAA:
			if rdlen == IPv6Len {
				// If link-local, return with empty zone and let caller decide what to do.
				mut ip := make(IP, IPv6Len)
				copy(ip, rdata)
				addrs = append(addrs, IPAddr{IP: ip, Zone: ""})
			}
		}
	}

	return addrs, len(addrs) > 0
}

// Looks up the addresses and the canonical name for the given host from static host.
fn lookupStaticHost(mut host: string): (ips: []string, canonical: string) {
	hosts.mu.lock()
	readHosts()
	if len(hosts.byName) != 0 {
		if hasUpperCase(host) {
			mut lowerHost := []byte(host)
			lowerASCIIBytes(lowerHost)
			host = unsafe::StringFromBytes(lowerHost)
		}
		byName, ok := hosts.byName[absDomainName(host)]
		if ok {
			ips = make([]string, len(byName.addrs))
			copy(ips, byName.addrs)
			canonical = byName.canonicalName
		}
	}
	hosts.mu.unlock()
	return
}

// lookup entries from static host
fn lookupIPFiles(name: string): (addrs: []IPAddr, canonical: string) {
	addr, canonical := lookupStaticHost(name)
	for (_, mut haddr) in addr {
		haddr, zone := splitHostZone(haddr)
		mut ip := ParseIP(haddr)
		if ip != nil {
			addrs = append(addrs, IPAddr{IP: ip, Zone: zone})
		}
	}
	return addrs, canonical
}

fn lookupParallel(mut &buf: *[]byte, mut conn: Conn, idPos: int, qtype1: u16, qtype2: u16, qtypePos: int): (results: []IPAddr, ok: bool) {
	id1 := getDNSId()
	mut id2 := id1
	for id2 == id1 {
		id2 = getDNSId()
	}

	write := fn(mut &buf: *[]byte, id: u16, qtype: u16): (ok: bool) {
		binary::BigEndian.PutU16((*buf)[idPos:], id)       // Write id to buf.
		binary::BigEndian.PutU16((*buf)[qtypePos:], qtype) // Write current qtype to buf.
		conn.Write(*buf) catch { return false }
		return true
	}

	read := fn(mut &buf: *[]byte, mut &results: *[]IPAddr): (id: u16, ok: bool) {
		let mut n: int
		if conf.useTCP {
			n = io::ReadFull(conn, (*buf)[:bigEndianU16Size]) catch { use 0 }
			if n > 0 {
				ln := binary::BigEndian.DecodeU16((*buf)[:bigEndianU16Size])
				growBuffer(buf, int(ln))
				n = io::ReadFull(conn, *buf) catch { use 0 }
			}
		} else {
			for {
				n = conn.Read((*buf)[:maxDNSPacketSize]) catch { use 0 }
				break
			}
		}
		if n <= 0 {
			return 0, false
		}

		payload := (*buf)[:n]
		id, ok = parseResponseHead(payload)
		if ok {
			mut res, (ok) := parseResponseBody(payload)
			if ok {
				if len(*results) == 0 {
					*results = res
				} else {
					*results = append(*results, res...)
				}
			}
		}
		return
	}

	mut write1, mut write2 := false, false
	mut read1, mut read2 := false, false
	mut attempt := 0
	for attempt < conf.attempts; attempt++ {
		if !write1 && write(buf, id1, qtype1) {
			write1 = true
		}
		if !write2 && write(buf, id2, qtype2) {
			write2 = true
		}

		// No query sent yet.
		if !write1 && !write2 {
			continue
		}

		// All queries responded.
		if read1 && read2 {
			break
		}

		id, readOk := read(buf, &results)
		if !readOk {
			continue
		}

		match id {
		| id1:
			read1 = true
		| id2:
			read2 = true
		}
	}

	ok = read1 || read2
	return
}

fn lookupSingle(mut &buf: *[]byte, mut conn: Conn, idPos: int, qtype: u16, qtypePos: int): (results: []IPAddr, ok: bool) {
	id := getDNSId()

	// Write id to buf.
	binary::BigEndian.PutU16((*buf)[idPos:], id)

	// Write current qtype to buf.
	binary::BigEndian.PutU16((*buf)[qtypePos:], qtype)

	mut attempt := 0
	for attempt < conf.attempts; attempt++ {
		conn.Write(*buf) catch { continue }

		let mut n: int
		if conf.useTCP {
			n = io::ReadFull(conn, (*buf)[:bigEndianU16Size]) catch { use 0 }
			if n > 0 {
				ln := binary::BigEndian.DecodeU16((*buf)[:bigEndianU16Size])
				growBuffer(buf, int(ln))
				n = io::ReadFull(conn, *buf) catch { use 0 }
			}
		} else {
			n = conn.Read((*buf)[:maxDNSPacketSize]) catch { use 0 }
		}
		if n <= 0 {
			continue
		}

		payload := (*buf)[:n]
		_, ok = parseResponseHead(payload)
		if ok {
			results, ok = parseResponseBody(payload)
			if ok {
				return
			}
		}
	}
	return nil, false
}

fn lookupQuery(mut &buf: *[]byte, mut conn: Conn, network: Network, query: string)!: (results: []IPAddr, ok: bool) {
	let mut idPos: int
	let mut qtypePos: int
	buildQuery(buf, query, &idPos, &qtypePos, conf.trustAD)?

	// Send length-prefixed message for TCP.
	if conf.useTCP {
		idPos += bigEndianU16Size
		qtypePos += bigEndianU16Size
		if cap(*buf) >= len(*buf)+bigEndianU16Size {
			*buf = (*buf)[:len(*buf)+bigEndianU16Size]
			copy((*buf)[bigEndianU16Size:], *buf)
		} else {
			mut newBuf := make([]byte, len(*buf)+bigEndianU16Size)
			copy(newBuf[bigEndianU16Size:], *buf)
			*buf = newBuf
		}
		binary::BigEndian.PutU16(*buf, u16(len(*buf)-bigEndianU16Size))
	}

	match network {
	| IP | TCP | UDP:
		// Lookup for IPv4 (A) and IPv6 (AAAA).
		if DefaultResolver.ForceParallel || !conf.singleRequest {
			return lookupParallel(buf, conn, idPos, _QTYPE_A, _QTYPE_AAAA, qtypePos)
		}
		// Lookup sequentially.
		mut results1, ok1 := lookupSingle(buf, conn, idPos, _QTYPE_A, qtypePos)
		mut results2, ok2 := lookupSingle(buf, conn, idPos, _QTYPE_AAAA, qtypePos)
		match {
		| ok1 && ok2:
			return append(results1, results2...), true
		| ok1:
			return results1, true
		| ok2:
			return results2, true
		}
	| IP4 | TCP4 | UDP4:
		// Lookup for IPv4.
		return lookupSingle(buf, conn, idPos, _QTYPE_A, qtypePos)
	| IP6 | TCP6 | UDP6:
		// Lookup for IPv6 (AAAA).
		return lookupSingle(buf, conn, idPos, _QTYPE_AAAA, qtypePos)
	}

	return nil, false
}

// Native implementation for the DNS lookup.
#disable boundary
fn juleLookupIP(net: Network, host: string)!: []IPAddr {
	// Lookup files first.
	{
		mut addrs, _ := lookupIPFiles(host)
		if len(addrs) > 0 {
			return addrs
		}
	}

	resolveConfig()

	dots := strings::Count(host, ".")
	isFQDN := strings::HasSuffix(host, ".")
	baseName := strings::TrimSuffix(host, ".")

	mut network := Network.UDP
	if conf.useTCP {
		network = Network.TCP
	}

	serverOffset := conf.serverOffset()
	serversLen := u32(len(conf.servers))

	let mut buf: []byte // will be allocated once and grow if needed
	mut i := u32(0)
	for i < serversLen; i++ {
		server := conf.servers[(serverOffset+i)%serversLen]

		// Get connection for the server.
		mut conn := DialTimeout(network, server, conf.timeout)?
		if conf.timeout > 0 {
			conn.SetReadTimeout(conf.timeout)?
			conn.SetWriteTimeout(conf.timeout)?
		}

		if isFQDN || dots >= conf.ndots {
			mut results, ok := lookupQuery(&buf, conn, net, host)?
			if ok {
				conn.Close() catch {}
				return results
			}
		}
		for _, suffix in conf.search {
			fqdn := baseName + "." + suffix
			mut results, ok := lookupQuery(&buf, conn, net, fqdn)?
			if ok {
				conn.Close() catch {}
				return results
			}
		}

		conn.Close() catch {}
	}

	throw errors::New("resolution failed for " + host)
}

// Looks up host using the local resolver and particular network.
// It returns a slice of that host's IPv4 and IPv6 addresses.
fn lookupIPAddr(net: Network, host: string)!: []IPAddr {
	// Make sure that no matter what we do later, host=="" is rejected.
	if host == "" {
		throw newDNSError("no such host", host, "")
	}

	// If parseAddr can parse host, it is a literal.
	mut ip := parseAddr(host) catch {
		// Host is not literal.
		// We need to lookup DNS and resolve the IP.
		if DefaultResolver.PreferJule {
			return juleLookupIP(net, host)?
		}
		return integLookupIP(net, host)?
	}
	ip.IP = ip.IP.To16()
	return [ip]
}

// The longest reasonable name of a service (non-numeric port).
// Currently the longest known IANA-unregistered name is
// "mobility-header", so we use that length, plus some slop in case
// something longer is added in the future.
const maxPortBufSize = len("mobility-header") + 10

// Native implementation for the port lookup.
fn juleLookupPortMap(network: Network, service: string)!: (port: int) {
	match network {
	| IP: // no hints
		return lookupPortMapWithNetwork(Network.TCP, Network.IP, service) catch {
			return lookupPortMapWithNetwork(Network.UDP, Network.IP, service)?
		}
	| TCP | TCP4 | TCP6:
		return lookupPortMapWithNetwork(Network.TCP, Network.TCP, service)?
	| UDP | UDP4 | UDP6:
		return lookupPortMapWithNetwork(Network.UDP, Network.UDP, service)?
	|:
		throw &DNSError{Err: "unknown network", Name: networkToStr(network) + "/" + service}
	}
}

fn lookupPortMapWithNetwork(network: Network, errNetwork: string, service: string)!: (port: int) {
	m, mut ok := services[network]
	if ok {
		let mut lowerService: [maxPortBufSize]byte
		n := copy(lowerService[:], service)
		lowerASCIIBytes(unsafe::Slice(&lowerService[0], n, n))
		port, ok = m[unsafe::String(&lowerService[0], n)]
		if ok && n == len(service) {
			return port
		}
		throw newDNSError("unknown port", errNetwork+"/"+service, "")
	}
	throw &DNSError{Err: "unknown network", Name: errNetwork + "/" + service}
}

fn lookupPort(net: Network, service: string)!: (port: int) {
	port, needsLookup := parsePort(service)
	if needsLookup {
		match net {
		| TCP | TCP4 | TCP6 | UDP | UDP4 | UDP6 | IP:
			break // no-op
		|:
			throw &AddrError{Err: "unknown network", Addr: net}
		}
		port = _lookupPort(net, service)?
	}
	if 0 > port || port > 65535 {
		throw &AddrError{Err: "invalid port", Addr: service}
	}
	return port
}

fn growBuffer(mut &buf: *[]byte, n: int) {
	if cap(*buf) >= n {
		*buf = (*buf)[:n]
	} else {
		*buf = make([]byte, n)
	}
}

// Looks up host using the local resolver.
// It returns a slice of that host's IPv4 and IPv6 addresses by network.
// Network must be IP, IP4 or IP6.
// Looks up for IPv4 addresses only, if network is IP4.
// Looks up for IPv6 addresses only, if network is IP6.
// Looks up for IPv4 and IPv6 addresses, if network is IP.
fn LookupIP(mut network: Network, address: string)!: []&IPAddr {
	match network {
	| IP | IP4 | IP6:
		mut addrs := resolveInternetAddrList(network, address)?
		return addrs.forResolveAll(network)
	|:
		throw &AddrError{Err: "invalid network: " + string(network)}
	}
}