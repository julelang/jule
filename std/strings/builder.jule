use "std/io"
use "std/unicode/utf8"
use "std/unsafe"

// String builder for efficient concatenation.
// Optimized for single string building not for repeated use.
//
// A Builder must not be copied after first use.
struct Builder {
	buf: []byte
}

impl Builder {
	// Writes bytes to buffer.
	// Never throws an error.
	fn Write(mut *self, b: []byte)!: (n: int) {
		self.buf = append(self.buf, b...)
		return len(b)
	}

	// Writes bytes to buffer.
	// Never throws an error.
	fn WriteString(mut *self, s: string)!: (n: int) {
		self.buf = append(self.buf, s...)
		return len(s)
	}

	// Writes byte to buffer.
	// Never throws an error.
	fn WriteByte(mut *self, b: byte)! {
		self.buf = append(self.buf, b)
	}

	// Writes rune into buffer.
	// Returns written byte count.
	// Never throws an error.
	fn WriteRune(mut *self, r: rune)!: (n: int) {
		if r < utf8::RuneSelf { // ASCII, fast way.
			self.buf = append(self.buf, byte(r))
			return 1
		}
		n = len(self.buf)
		self.buf = utf8::AppendRune(self.buf, r)
		n = len(self.buf) - n
		return
	}

	// Copies the buffer to a new, larger buffer so that there are at least n
	// bytes of capacity beyond len(self.buf).
	fn grow(mut *self, n: int) {
		mut buf := make([]byte, len(self.buf), 2*cap(self.buf)+n)
		copy(buf, self.buf)
		self.buf = buf
	}

	// Grows b's capacity, if necessary, to guarantee space for
	// another n bytes. After Grow(n), at least n bytes can be written to b
	// without another allocation. If n is negative, panics.
	fn Grow(mut *self, n: int) {
		if n < 0 {
			panic("std/strings: Builder.Grow: negative count")
		}
		if cap(self.buf)-len(self.buf) < n {
			self.grow(n)
		}
	}

	// Returns buffer as string. Will not reset the underlying content.
	fn String(*self): string {
		return unsafe::StringFromBytes(self.buf)
	}

	// Clears buffer.
	// After calling this function, write calls will allocate new buffer.
	fn Clear(mut *self) {
		self.buf = nil
	}

	// Returns length of buffer.
	fn Len(*self): int {
		return len(self.buf)
	}

	// Returns capacity of buffer.
	fn Cap(*self): int {
		return cap(self.buf)
	}

	// Returns mutable buffer for low-level interactions.
	unsafe fn Buf(mut *self): []byte {
		return self.buf
	}

	// Sets mutable internal buffer for low-level interactions.
	unsafe fn SetBuf(mut *self, mut buf: []byte) {
		self.buf = buf
	}

	// Returns async wrapper for the Builder.
	// Useful to satisfy behavior implemented `io` traits.
	fn Async(mut &self): asyncBuilder {
		return asyncBuilder(self)
	}
}

// A Builder is CPU-bound and sync, normally.
// But this type wraps the sync functions with async functions.
// Useful to satisfy `io` traits.
type asyncBuilder: &Builder

impl io::Writer for asyncBuilder {}
impl io::ByteWriter for asyncBuilder {}
impl io::RuneWriter for asyncBuilder {}
impl io::StringWriter for asyncBuilder {}

impl asyncBuilder {
	#ready
	fn ready_Write(mut *self, b: []byte)!: (n: int) {
		ready(true)
		return (&Builder)(*self).Write(b)?
	}

	// Implements the io::Writer trait.
	#future
	async fn Write(mut *self, b: []byte)!: (n: int) {
		future(self.ready_Write, self.Write)
	}

	#ready
	fn ready_WriteString(mut *self, s: string)!: (n: int) {
		ready(true)
		return (&Builder)(*self).WriteString(s)?
	}

	// Implements the io::StringWriter trait.
	#future
	async fn WriteString(mut *self, s: string)!: (n: int) {
		future(self.ready_WriteString, self.WriteString)
	}

	#ready
	fn ready_WriteByte(mut *self, b: byte)! {
		ready(true)
		(&Builder)(*self).WriteByte(b)?
	}

	// Implements the io::ByteWriter trait.
	#future
	async fn WriteByte(mut *self, b: byte)! {
		future(self.ready_WriteByte, self.WriteByte)
	}

	#ready
	fn ready_WriteRune(mut *self, r: rune)!: (n: int) {
		ready(true)
		return (&Builder)(*self).WriteRune(r)?
	}

	// Implements the io::RuneWriter trait.
	#future
	async fn WriteRune(mut *self, r: rune)!: (n: int) {
		future(self.ready_WriteRune, self.WriteRune)
	}
}