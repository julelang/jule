use "std/errors"
use "std/io"
use "std/unicode/utf8"

// Implements the io::Reader, io::ReaderAt, io::ByteReader, io::RuneReader,
// io::Seeker, and io::WriterTo traits by reading from a string.
// The zero value for Reader operates like a Reader of an empty string.
struct Reader {
	s:            string
	mut i:        i64 // current reading index
	mut prevRune: int // index of previous rune; or < 0
}

impl Reader {
	// Returns a new Reader reading from s.
	fn New(s: string): &Reader { return &Reader{s, 0, -1} }

	// Returns the number of bytes of the unread portion of the string.
	fn Len(*self): int {
		if self.i >= i64(len(self.s)) {
			return 0
		}
		return int(i64(len(self.s)) - self.i)
	}

	// Returns the original length of the underlying string.
	// Size is the number of bytes available for reading via ReadAt.
	// The returned value is always the same and is not affected by calls
	// to any other method.
	fn Size(*self): i64 { return i64(len(self.s)) }

	// Implements behavior the io::Reader trait.
	fn Read(*self, mut b: []byte)!: (n: int) {
		if self.i >= i64(len(self.s)) {
			throw io::EOF
		}
		self.prevRune = -1
		n = copy(b, self.s[self.i:])
		self.i += i64(n)
		return
	}

	// Implements behavior the io::ReaderAt trait.
	fn ReadAt(*self, mut b: []byte, off: i64)!: (n: int) {
		// cannot modify state - see io::ReaderAt
		if off < 0 {
			throw errors::New("strings::Reader.ReadAt: negative offset")
		}
		if off >= i64(len(self.s)) {
			throw io::EOF
		}
		n = copy(b, self.s[off:])
		return
	}

	// Implements behavior the io::ByteReader trait.
	fn ReadByte(mut *self)!: (byte, int) {
		self.prevRune = -1
		if self.i >= i64(len(self.s)) {
			throw io::EOF
		}
		b := self.s[self.i]
		self.i++
		return b, 1
	}

	// Implements behavior the io::ByteScanner trait.
	fn UnreadByte(*self)! {
		if self.i <= 0 {
			throw errors::New("strings::Reader.UnreadByte: at beginning of string")
		}
		self.prevRune = -1
		self.i--
	}

	// Implements behavior the io::RuneReader trait.
	fn ReadRune(*self)!: (ch: rune, size: int) {
		if self.i >= i64(len(self.s)) {
			self.prevRune = -1
			throw io::EOF
		}
		self.prevRune = int(self.i)
		c := self.s[self.i]
		if c < utf8::RuneSelf {
			self.i++
			return rune(c), 1
		}
		ch, size = utf8::DecodeRuneString(self.s[self.i:])
		self.i += i64(size)
		return
	}

	// Implements behavior the io::RuneScanner trait.
	fn UnreadRune(*self)! {
		if self.i <= 0 {
			throw errors::New("strings::Reader.UnreadRune: at beginning of string")
		}
		if self.prevRune < 0 {
			throw errors::New("strings::Reader.UnreadRune: previous operation was not ReadRune")
		}
		self.i = i64(self.prevRune)
		self.prevRune = -1
	}

	// Implements behavior of the io::Seeker trait.
	fn Seek(*self, offset: i64, whence: int)!: i64 {
		self.prevRune = -1
		let mut abs: i64
		match whence {
		| io::SeekStart:
			abs = offset
		| io::SeekCurrent:
			abs = self.i + offset
		| io::SeekEnd:
			abs = i64(len(self.s)) + offset
		|:
			throw errors::New("strings::Reader.Seek: invalid whence")
		}
		if abs < 0 {
			throw errors::New("strings::Reader.Seek: negative position")
		}
		self.i = abs
		return abs
	}

	// Implements behavior the io::WriterTo trait.
	fn WriteTo(*self, mut w: io::Writer)!: (n: i64) {
		self.prevRune = -1
		if self.i >= i64(len(self.s)) {
			throw io::EOF
		}
		s := self.s[self.i:]
		m := io::WriteString(w, s)?
		if m > len(s) {
			panic("strings::Reader.WriteTo: invalid WriteString count")
		}
		self.i += i64(m)
		n = i64(m)
		if m != len(s) {
			throw io::ErrShortWrite
		}
		return
	}

	// Resets the Reader to be reading from s.
	fn Reset(mut *self, s: string) {
		self.s = s
		self.i = 0
		self.prevRune = -1
	}
}