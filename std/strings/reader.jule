use "std/errors"
use "std/io"
use "std/unicode/utf8"

// Implements the io::Reader, io::ReaderAt, io::ByteReader, io::RuneReader,
// io::Seeker, and io::WriterTo traits by reading from a string.
// The zero value for Reader operates like a Reader of an empty string.
struct Reader {
	s:            string
	mut i:        i64 // current reading index
	mut prevRune: int // index of previous rune; or < 0
}

impl Reader {
	// Returns a new Reader reading from s.
	fn New(s: string): &Reader { return &Reader{s, 0, -1} }

	// Returns the number of bytes of the unread portion of the string.
	fn Len(*self): int {
		if self.i >= i64(len(self.s)) {
			return 0
		}
		return int(i64(len(self.s)) - self.i)
	}

	// Returns the original length of the underlying string.
	// Size is the number of bytes available for reading via ReadAt.
	// The returned value is always the same and is not affected by calls
	// to any other method.
	fn Size(*self): i64 { return i64(len(self.s)) }

	// Implements behavior the io::Reader trait.
	fn Read(*self, mut b: []byte)!: (n: int) {
		if self.i >= i64(len(self.s)) {
			throw io::EOF
		}
		self.prevRune = -1
		n = copy(b, self.s[self.i:])
		self.i += i64(n)
		return
	}

	// Implements behavior the io::ReaderAt trait.
	fn ReadAt(*self, mut b: []byte, off: i64)!: (n: int) {
		// cannot modify state - see io::ReaderAt
		if off < 0 {
			throw errors::New("strings::Reader.ReadAt: negative offset")
		}
		if off >= i64(len(self.s)) {
			throw io::EOF
		}
		n = copy(b, self.s[off:])
		return
	}

	// Implements behavior the io::ByteReader trait.
	fn ReadByte(mut *self)!: (byte, int) {
		self.prevRune = -1
		if self.i >= i64(len(self.s)) {
			throw io::EOF
		}
		b := self.s[self.i]
		self.i++
		return b, 1
	}

	// Implements behavior the io::ByteScanner trait.
	fn UnreadByte(*self)! {
		if self.i <= 0 {
			throw errors::New("strings::Reader.UnreadByte: at beginning of string")
		}
		self.prevRune = -1
		self.i--
	}

	// Implements behavior the io::RuneReader trait.
	fn ReadRune(*self)!: (ch: rune, size: int) {
		if self.i >= i64(len(self.s)) {
			self.prevRune = -1
			throw io::EOF
		}
		self.prevRune = int(self.i)
		c := self.s[self.i]
		if c < utf8::RuneSelf {
			self.i++
			return rune(c), 1
		}
		ch, size = utf8::DecodeRuneString(self.s[self.i:])
		self.i += i64(size)
		return
	}

	// Implements behavior the io::RuneScanner trait.
	fn UnreadRune(*self)! {
		if self.i <= 0 {
			throw errors::New("strings::Reader.UnreadRune: at beginning of string")
		}
		if self.prevRune < 0 {
			throw errors::New("strings::Reader.UnreadRune: previous operation was not ReadRune")
		}
		self.i = i64(self.prevRune)
		self.prevRune = -1
	}

	// Implements behavior of the io::Seeker trait.
	fn Seek(*self, offset: i64, whence: int)!: i64 {
		self.prevRune = -1
		let mut abs: i64
		match whence {
		| io::SeekStart:
			abs = offset
		| io::SeekCurrent:
			abs = self.i + offset
		| io::SeekEnd:
			abs = i64(len(self.s)) + offset
		|:
			throw errors::New("strings::Reader.Seek: invalid whence")
		}
		if abs < 0 {
			throw errors::New("strings::Reader.Seek: negative position")
		}
		self.i = abs
		return abs
	}

	// Implements behavior the io::WriterTo trait.
	async fn WriteTo(*self, mut w: io::Writer)!: (n: i64) {
		self.prevRune = -1
		if self.i >= i64(len(self.s)) {
			throw io::EOF
		}
		s := self.s[self.i:]
		m := io::WriteString(w, s).await?
		if m > len(s) {
			panic("strings::Reader.WriteTo: invalid WriteString count")
		}
		self.i += i64(m)
		n = i64(m)
		if m != len(s) {
			throw io::ErrShortWrite
		}
		return
	}

	// Resets the Reader to be reading from s.
	fn Reset(mut *self, s: string) {
		self.s = s
		self.i = 0
		self.prevRune = -1
	}

	// Returns async wrapper for the Reader.
	// Useful to satisfy behavior implemented `io` traits.
	fn Async(mut &self): asyncReader {
		return asyncReader(self)
	}
}

// A Reader is CPU-bound and sync, normally.
// But this type wraps the sync functions with async functions.
// Useful to satisfy `io` traits.
type asyncReader: &Reader

impl io::Reader for asyncReader {}
impl io::ReaderAt for asyncReader {}
impl io::ByteReader for asyncReader {}
impl io::RuneReader for asyncReader {}
impl io::Seeker for asyncReader {}
impl io::WriterTo for asyncReader {}

impl asyncReader {
	#ready
	fn ready_Read(*self, mut b: []byte)!: (n: int) {
		ready(true)
		return (&Reader)(*self).Read(b)?
	}

	// Implements the io::Reader trait.
	#future
	async fn Read(*self, mut b: []byte)!: (n: int) {
		future(self.ready_Read, self.Read)
	}

	#ready
	fn ready_ReadAt(*self, mut b: []byte, off: i64)!: (n: int) {
		ready(true)
		return (&Reader)(*self).ReadAt(b, off)?
	}

	// Implements the io::ReaderAt trait.
	#future
	async fn ReadAt(*self, mut b: []byte, off: i64)!: (n: int) {
		future(self.ready_ReadAt, self.ReadAt)
	}

	#ready
	fn ready_ReadByte(mut *self)!: (byte, int) {
		ready(true)
		return (&Reader)(*self).ReadByte()?
	}

	// Implements the io::ByteReader trait.
	#future
	async fn ReadByte(mut *self)!: (byte, int) {
		future(self.ready_ReadByte, self.ReadByte)
	}

	#ready
	fn ready_UnreadByte(*self)! {
		ready(true)
		(&Reader)(*self).UnreadByte()?
	}

	// Implements the io::ByteScanner trait.
	#future
	async fn UnreadByte(*self)! {
		future(self.ready_UnreadByte, self.UnreadByte)
	}

	#ready
	fn ready_ReadRune(*self)!: (ch: rune, size: int) {
		ready(true)
		return (&Reader)(*self).ReadRune()?
	}

	// Implements the io::RuneReader trait.
	#future
	async fn ReadRune(*self)!: (ch: rune, size: int) {
		future(self.ready_ReadRune, self.ReadRune)
	}

	#ready
	fn ready_UnreadRune(*self)! {
		ready(true)
		(&Reader)(*self).UnreadRune()?
	}

	// Implements the io::RuneScanner trait.
	#future
	async fn UnreadRune(*self)! {
		future(self.ready_UnreadRune, self.UnreadRune)
	}

	#ready
	fn ready_Seek(*self, offset: i64, whence: int)!: i64 {
		ready(true)
		return (&Reader)(*self).Seek(offset, whence)?
	}

	// Implements the io::Seeker trait.
	#future
	async fn Seek(*self, offset: i64, whence: int)!: i64 {
		future(self.ready_Seek, self.Seek)
	}

	// Implements the io::WriterTo trait.
	async fn WriteTo(*self, mut w: io::Writer)!: (n: i64) {
		return (&Reader)(*self).WriteTo(w).await?
	}
}