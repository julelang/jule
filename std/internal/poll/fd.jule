use "std/mem"
use "std/sys"

// FD flags. Kind flags should not be combined like File|Console|Socket.
const (
	File         = 1 << iota // Standard file descriptor.
	Socket                   // Socket file descriptor, not connectionless, such as TCP.
	SocketNoConn             // Like Socket kind, but connectionless, such as UDP.
	Console                  // Console file descriptor.
	Pipe                     // Pipe.
)

impl FD {
	// Returns new FD by file and kind.
	fn New(file: u64, flags: int)!: &FD {
		mut f := &FD{
			File:  file,
			Flags: flags,
		}
		f.Init()?
		return f
	}

	// Reports whether the FD kind is file.
	fn isFile(*self): bool {
		return self.Flags&(File|Pipe) != 0
	}

	// Reports whether n is EOF.
	fn isEOF(*self, n: int): bool {
		return n == 0 && self.ZeroReadIsEOF
	}

	// Like Read, but wraps the recvfrom syscall.
	fn ReadV4(mut *self, mut buf: []byte, addr: sys::RawSockaddrInet4)!: (n: int) {
		addrLen := mem::Sizeof(addr)
		return self.ReadV(buf, uintptr(&addr), sys::Socklen(addrLen))?
	}

	// Like Read, but wraps the recvfrom syscall.
	fn ReadV6(mut *self, mut buf: []byte, addr: sys::RawSockaddrInet6)!: (n: int) {
		addrLen := mem::Sizeof(addr)
		return self.ReadV(buf, uintptr(&addr), sys::Socklen(addrLen))?
	}

	// Like Write, but wraps the sendto syscall.
	fn WriteV4(mut *self, buf: []byte, addr: sys::RawSockaddrInet4)!: (n: int) {
		addrLen := mem::Sizeof(addr)
		return self.WriteV(buf, uintptr(&addr), sys::Socklen(addrLen))?
	}

	// Like Write, but wraps the sendo syscall.
	fn WriteV6(mut *self, buf: []byte, addr: sys::RawSockaddrInet6)!: (n: int) {
		addrLen := mem::Sizeof(addr)
		return self.WriteV(buf, uintptr(&addr), sys::Socklen(addrLen))?
	}
}