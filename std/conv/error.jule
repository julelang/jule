type Error: int

const (
	_: Error = iota
	ErrRange
	ErrSyntax
	ErrBase
	ErrBitSize
)

impl Error {
	fn Error(*self): string {
		match *self {
		| ErrRange:
			return "value out of range"
		| ErrSyntax:
			return "invalid syntax"
		| ErrBase:
			return "invalid base"
		| ErrBitSize:
			return "invalid bit size"
		}
		return "unknown error"
	}
}