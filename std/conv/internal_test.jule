// export access to conv internals for tests

let BitSizeError = bitSizeError
let BaseError = baseError

const (
	Pow10Min = pow10Min
	Pow10Max = pow10Max
)

fn NewDecimal(i: u64): &decimal {
	mut d := new(decimal)
	d.Assign(i)
	return d
}

fn SetOptimize(b: bool): bool {
	old := optimize
	optimize = b
	return old
}

fn ParseFloatPrefix(s: string, bitSize: int): (f64, int, any) {
	return parseFloatPrefix(s, bitSize)
}

fn TrimZeros(x: u64): (u64, int) {
	return trimZeros(x)
}

fn MulLog10_2(x: int): int {
	return mulLog10_2(x)
}

fn MulLog2_10(x: int): int {
	return mulLog2_10(x)
}

fn DivisiblePow5(x: u64, p: int): bool {
	return divisiblePow5(x, p)
}

type U128 = u128

fn Umul192(x: u64, y: u128): (u64, u64, u64) {
	return umul192(x, y)
}

fn Pow10(e: int): (u128, int, bool) {
	return pow10(e)
}

let Div5Tab = div5Tab