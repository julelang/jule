// export access to conv internals for tests

const (
	Pow10Min = pow10Min
	Pow10Max = pow10Max
)

fn NewDecimal(i: u64): &decimal {
	mut d := new(decimal)
	d.Assign(i)
	return d
}

fn SetOptimize(b: bool): bool {
	old := optimize
	optimize = b
	return old
}

fn ParseFloatPrefix(s: string, bitSize: int): (f64, int, any) {
	return parseFloatPrefix(s, bitSize)
}

fn Log10Pow2(x: int): int {
	return log10Pow2(x)
}

fn Log2Pow10(x: int): int {
	return log2Pow10(x)
}