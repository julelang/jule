use "std/math/bits"
use "std/unsafe"

// Returns the string representation of i in the given base,
// for 2 <= base <= 36. The result uses the lower-case letters 'a' to 'z'
// for digit values >= 10.
fn FormatUint(i: u64, base: int): string {
	if base == 10 {
		if i < nSmalls {
			return small(int(i))
		}
		let mut a: [24]byte
		j := formatBase10(unsafe::Slice(&a[0], len(a), len(a)), i)
		return string(a[j:])
	}
	_, s := formatBits(nil, i, base, false, false)
	return s
}

// Returns the string representation of i in the given base,
// for 2 <= base <= 36. The result uses the lower-case letters 'a' to 'z'
// for digit values >= 10.
fn FormatInt(i: i64, base: int): string {
	if base == 10 {
		if 0 <= i && i < nSmalls {
			return small(int(i))
		}
		let mut a: [24]byte
		mut u := u64(i)
		if i < 0 {
			u = -u
		}
		mut j := formatBase10(unsafe::Slice(&a[0], len(a), len(a)), u)
		if i < 0 {
			j--
			a[j] = '-'
		}
		return string(a[j:])
	}
	_, s := formatBits(nil, u64(i), base, i < 0, false)
	return s
}

// Equivalent to [FormatInt](i64(i), 10).
fn Itoa(i: int): string {
	return FormatInt(i64(i), 10)
}

// Appends the string form of the integer i,
// as generated by [FormatInt], to dst and returns the extended buffer.
fn AppendInt(mut dst: []byte, i: i64, base: int): []byte {
	mut u := u64(i)
	if i < 0 {
		dst = append(dst, '-')
		u = -u
	}
	return AppendUint(dst, u, base)
}

// Appends the string form of the unsigned integer i,
// as generated by [FormatUint], to dst and returns the extended buffer.
fn AppendUint(mut dst: []byte, i: u64, base: int): []byte {
	if base == 10 {
		if i < nSmalls {
			return append(dst, small(int(i))...)
		}
		let mut a: [24]byte
		j := formatBase10(unsafe::Slice(&a[0], len(a), len(a)), i)
		return append(dst, a[j:]...)
	}
	dst, _ = formatBits(dst, i, base, false, true)
	return dst
}

const digits = "0123456789abcdefghijklmnopqrstuvwxyz"

// Computes the string representation of u in the given base.
// If neg is set, u is treated as negative i64 value. If append_ is
// set, the string is appended to dst and the resulting byte slice is
// returned as the first result value; otherwise the string is returned
// as the second result value.
// The caller is expected to have handled base 10 separately for speed.
#disable boundary
fn formatBits(mut dst: []byte, mut u: u64, base: int, neg: bool, append_: bool): (d: []byte, s: string) {
	if base < 2 || base == 10 || base > len(digits) {
		panic("conv: illegal AppendInt/FormatInt base")
	}
	// 2 <= base && base <= len(digits)

	let mut a: [64 + 1]byte // +1 for sign of 64bit value in base 2
	mut i := len(a)
	if neg {
		u = -u
	}

	// convert bits
	// We use uint values where we can because those will
	// fit into a single register even on a 32bit machine.
	if isPowerOfTwo(base) {
		// Use shifts and masks instead of / and %.
		shift := uint(bits::TrailingZeros(uint(base)))
		b := u64(base)
		m := uint(base) - 1 // == 1<<shift - 1
		for u >= b {
			i--
			a[i] = digits[uint(u)&m]
			u >>= shift
		}
		// u < base
		i--
		a[i] = digits[uint(u)]
	} else {
		// general case
		b := u64(base)
		for u >= b {
			i--
			// Avoid using r = a%b in addition to q = a/b
			// since 64bit division and modulo operations
			// are calculated by runtime functions on 32bit machines.
			q := u / b
			a[i] = digits[uint(u-q*b)]
			u = q
		}
		// u < base
		i--
		a[i] = digits[uint(u)]
	}

	// add sign, if any
	if neg {
		i--
		a[i] = '-'
	}

	if append_ {
		d = append(dst, a[i:]...)
		return
	}
	s = string(a[i:])
	return
}

fn isPowerOfTwo(x: int): bool {
	return x&(x-1) == 0
}

const nSmalls = 100

// smalls is the formatting of 00..99 concatenated.
// It is then padded out with 56 x's to 256 bytes,
// so that smalls[x&0xFF] has no bounds check.
const smalls = "00010203040506070809" +
	"10111213141516171819" +
	"20212223242526272829" +
	"30313233343536373839" +
	"40414243444546474849" +
	"50515253545556575859" +
	"60616263646566676869" +
	"70717273747576777879" +
	"80818283848586878889" +
	"90919293949596979899"

const host64bit = ^uint(0)>>32 != 0

// Returns the string for an i with 0 <= i < nSmalls.
#disable boundary
fn small(i: int): string {
	if i < 10 {
		return digits[i : i+1]
	}
	return smalls[i*2 : i*2+2]
}

// Formats the decimal representation of u into the tail of a
// and returns the offset of the first byte written to a. That is, after
//
//	i := formatBase10(a, u)
//
// the decimal representation is in a[i:].
#disable boundary nilptr
fn formatBase10(mut a: []byte, mut u: u64): int {
	// Split into 9-digit chunks that fit in u32s
	// and convert each chunk using u32 math instead of u64 math.
	// The obvious way to write the outer loop is "for u >= 1e9", but most numbers are small,
	// so the setup for the comparison u >= 1e9 is usually pure overhead.
	// Instead, we approximate it by u>>29 != 0, which is usually faster and good enough.
	mut i := len(a)
	for (host64bit && u>>29 != 0) || (!host64bit && u32(u)>>29|u32(u>>32) != 0) {
		let mut lo: u32
		u, lo = u/1e9, u32(u%1e9)

		// Convert 9 digits.
		mut j := 0
		for j < 4; j++ {
			let mut dd: u32
			lo, dd = lo/100, (lo%100)*2
			i -= 2
			a[i+0], a[i+1] = smalls[dd+0], smalls[dd+1]
		}
		i--
		a[i] = smalls[lo*2+1]

		// If we'd been using u >= 1e9 then we would be guaranteed that u/1e9 > 0,
		// but since we used u>>29 != 0, u/1e9 might be 0, so we might be done.
		// (If u is now 0, then at the start we had 2²⁹ ≤ u < 10⁹, so it was still correct
		// to write 9 digits; we have not accidentally written any leading zeros.)
		if u == 0 {
			return i
		}
	}

	// Convert final chunk, at most 8 digits.
	mut lo := u32(u)
	for lo >= 100 {
		let mut dd: u32
		lo, dd = lo/100, (lo%100)*2
		i -= 2
		a[i+0], a[i+1] = smalls[dd+0], smalls[dd+1]
	}
	i--
	dd := lo * 2
	a[i] = smalls[dd+1]
	if lo >= 10 {
		i--
		a[i] = smalls[dd+0]
	}
	return i
}