use "std/comptime"
use "std/math"
use "std/math/bits"

// Converts b to an integer: 1 for true, 0 for false.
fn bool2[T: ~int | ~u32 | ~u64](b: bool): T {
	if b {
		return 1
	}
	return 0
}

// Takes m, e and returns f = m * 2**e.
// It assumes the caller has provided a 53-bit mantissa m
// and an exponent that is in range for the mantissa.
fn pack64(m: u64, e: int): (f64, Error) {
	if m&(1<<52) == 0 {
		return math::F64frombits(m), 0
	}
	if e >= 0x7FF-1075 {
		return math::F64frombits(m&(1<<63) | 0x7ff<<52), ErrRange
	}
	return math::F64frombits(m&^(1<<52) | u64(1075+e)<<52), 0
}

// Takes m, e and returns f = m * 2**e.
// It assumes the caller has provided a 24-bit mantissa m
// and an exponent that is in range for the mantissa.
fn pack32(m: u32, e: int): (f32, Error) {
	if m&(1<<23) == 0 {
		return math::F32frombits(m), 0
	}
	if e >= 0xFF-150 {
		return math::F32frombits(m&(1<<31) | 0xff<<23), ErrRange
	}
	return math::F32frombits(m&^(1<<23) | u32(150+e)<<23), 0
}

// Represents an unrounded value.
type unrounded: u64

impl unrounded {
	#disable nilptr
	fn floor(*self): u64 { return u64((*self + 0) >> 2) }

	#disable nilptr
	fn roundHalfDown(*self): u64 { return u64((*self + 1) >> 2) }

	#disable nilptr
	fn round(*self): u64 { return u64((*self + 1 + (*self>>2)&1) >> 2) }

	#disable nilptr
	fn roundHalfUp(*self): u64 { return u64((*self + 2) >> 2) }

	#disable nilptr
	fn ceil(*self): u64 { return u64((*self + 3) >> 2) }

	#disable nilptr
	fn nudge(*self, δ: int): unrounded { return *self + unrounded(δ) }

	#disable nilptr
	fn div(*self, d: u64): unrounded {
		x := u64(*self)
		return unrounded(x/d) | *self&1 | bool2[unrounded](x%d != 0)
	}

	#disable nilptr
	fn rsh(*self, s: int): unrounded {
		return *self>>s | *self&1 | bool2[unrounded](*self&((1<<s)-1) != 0)
	}
}

// Returns ⌊log₁₀ 2**x⌋ = ⌊x * log₁₀ 2⌋.
fn log10Pow2(x: int): int {
	// log₁₀ 2 ≈ 0.30102999566 ≈ 78913 / 2^18
	return (x * 78913) >> 18
}

// Returns ⌊log₂ 10**x⌋ = ⌊x * log₂ 10⌋.
fn log2Pow10(x: int): int {
	// log₂ 10 ≈ 3.32192809489 ≈ 108853 / 2^15
	return (x * 108853) >> 15
}

// u64pow10[x] is 10**x.
let u64pow10: [...]u64 = [
	1, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9,
	1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19,
]

// Returns the n-digit decimal form of f = m * 2**e as d * 10**p.
// n can be at most 18.
// If fmt == 'f' then n is a conservative estimate of the number of digits,
// and digits are discarded to match prec.
#disable boundary
fn fixedWidthFloat(m: u64, e: int, n: int, prec: int, fmt: byte): (d: u64, p: int) {
	p = n - 1 - log10Pow2(e+63)
	let mut pre: scaler
	prescale(&pre, e, p, log2Pow10(p))
	mut u := uscale(m, &pre)
	if u >= unmin(u64pow10[n]) {
		u = u.div(10)
		p--
	}
	if fmt == 'f' {
		for p > prec {
			u = u.div(10)
			p--
		}
	}
	return u.round(), -p
}

// Rounds d * 10**p to the nearest f64 f.
// d can have at most 19 digits.
// It returns ErrRange if the result rounds to infinity.
fn parseF64(d: u64, p: int, sign: u64): (f64, Error) {
	b := bits::Len64(d)
	lp := log2Pow10(p)
	mut e := min(1074, 53-b-lp)
	let mut pre: scaler
	prescale(&pre, e-(64-b), p, lp)
	if pre.s >= 64 {
		return math::F64frombits(sign | 0), 0
	}
	mut u := uscale(d<<(64-b), &pre)

	// This block is branch-free code for:
	//	if u.round() >= 1<<53 {
	//		u = u.rsh(1)
	//		e = e - 1
	//	}
	s := bool2[int](u >= unmin(1<<53))
	u = u>>s | u&1
	e = e - s

	return pack64(sign|u.round(), -e)
}

// Rounds d * 10**p to the nearest f32 f.
// d can have at most 19 digits.
// It returns ErrRange if the result rounds to infinity.
fn parseF32(d: u64, p: int, sign: u32): (f32, Error) {
	b := bits::Len64(d)
	lp := log2Pow10(p)
	mut e := min(149, 24-b-lp)
	let mut pre: scaler
	prescale(&pre, e-(64-b), p, lp)
	if pre.s >= 64 {
		return math::F32frombits(sign | 0), 0
	}
	mut u := uscale(d<<(64-b), &pre)

	// This block is branch-free code for:
	//	if u.round() >= 1<<24 {
	//		u = u.rsh(1)
	//		e = e - 1
	//	}
	s := bool2[int](u >= unmin(1<<24))
	u = u>>s | u&1
	e = e - s

	return pack32(sign|u32(u.round()), -e)
}

// Returns the minimum unrounded that rounds to x.
fn unmin(x: u64): unrounded {
	return unrounded(x<<2 - 2)
}

// Computes the shortest formatting of f,
// using as few digits as possible that will still round trip
// back to the original float.
fn shortFloat[F: float](m: u64, e: int): (d: u64, p: int) {
	let mut mantBits: int
	let mut minExp: int // parameterized constants
	const match comptime::Typeof(F).Bits() {
	| 32:
		mantBits = f32MantBits
		minExp = f32MinExp
	| 64:
		mantBits = f64MantBits
		minExp = f64MinExp
	}

	// Note: these cases could be factored a little more,
	// but in the first two branches, z is a constant,
	// allowing the compiler to greatly simplify the code.
	let mut min: u64
	let mut max: u64
	let mut odd: int
	mut z := 63 - mantBits
	if m == 1<<63 && e > minExp {
		p = -skewed(e + z)
		min = m - 1<<(z-2) // min = m - 1/4 * 2**(e+z)
		max = m + 1<<(z-1) // max = m + 1/2 * 2**(e+z)
		odd = int(m>>z) & 1
	} else if e >= minExp {
		p = -log10Pow2(e + z)
		min = m - 1<<(z-1) // min = m - 1/2 * 2**(e+z)
		max = m + 1<<(z-1) // max = m + 1/2 * 2**(e+z)
		odd = int(m>>z) & 1
	} else {
		z = z + (minExp - e)
		p = -log10Pow2(e + z)
		min = m - 1<<(z-1) // min = m - 1/2 * 2**(e+z)
		max = m + 1<<(z-1) // max = m + 1/2 * 2**(e+z)
		odd = int(m>>z) & 1
	}

	let mut pre: scaler
	prescale(&pre, e, p, log2Pow10(p))
	dmin := uscale(min, &pre).nudge(+odd).ceil()
	dmax := uscale(max, &pre).nudge(-odd).floor()

	d = dmax / 10
	if d*10 >= dmin {
		return d, -(p - 1)
	}
	d = dmin
	if d < dmax {
		d = uscale(m, &pre).round()
	}
	return d, -p
}

// Computes the skewed footprint of m * 2**e,
// which is ⌊log₁₀ 3/4 * 2**e⌋ = ⌊e*(log₁₀ 2)-(log₁₀ 4/3)⌋.
fn skewed(e: int): int {
	return (e*631305 - 261663) >> 21
}

// Represents hi<<64 - lo.
struct pmHiLo {
	hi: u64
	lo: u64
}

// Holds derived scaling constants for a given e, p pair.
struct scaler {
	pmHi: u64
	pmLo: u64
	s:    int
}

// Returns the scaling constants for e, p.
// lp must be log2Pow10(p).
// The caller is responsible for either avoiding e, p pairs
// that cause pre.s < 0 or pre.s >= 64, or else handling
// those cases before passing the result to uscale.
// In practice, pre.s < 0 would indicate a buggy caller
// and pre.s >= 64 can only happen for parsing and is
// picked off at those call sites.
#disable boundary nilptr
fn prescale(mut &pre: *scaler, e: int, p: int, lp: int) {
	pre.pmHi = pow10Tab[p-pow10Min].hi
	pre.pmLo = pow10Tab[p-pow10Min].lo
	pre.s = -(e + lp + 3)
}

// Returns unround(x * 2**e * 10**p).
// The caller should pass &pre for prescale(&pre, e, p, log2Pow10(p))
// and should have left-justified x so its high bit is set.
// The caller is also responsible for checking that c.s < 64.
// For formatting, that's always true.
// For parsing, the caller needs to pick it off early and return a signed 0.
#disable nilptr
fn uscale(x: u64, &c: *scaler): unrounded {
	mut hi, mid := bits::Mul64(x, c.pmHi)
	s := c.s & 63 // make shifts cheaper
	if hi>>s<<s != hi {
		return unrounded(hi>>s | 1)
	}
	mid2, _ := bits::Mul64(x, c.pmLo)
	hi -= bool2[u64](mid < mid2)
	return unrounded(hi>>s | bool2[u64](mid-mid2 > 1))
}

// Sets digs to the nd digits described by d, p.
#disable boundary
fn setDigits(mut s: []byte, d: u64, p: int, mut nd: int): (dp: int, nzd: int) {
	// Note: nd <= len(s) is guaranteed by caller,
	// but writing it explicitly here lets the compiler know,
	// so that it can remove the bounds check in the loop.
	// (The slice s[:nd] not panicking only establishes nd <= cap(s).)
	if nd <= len(s) {
		formatBase10(s[:nd], d)
		dp = nd + p
		for nd > 0 && s[nd-1] == '0' {
			nd--
		}
	}
	return dp, nd
}

// Returns the number of decimal digits in d.
// It requires d ≥ 1.
#disable boundary
fn numDigits(d: u64): int {
	nd := log10Pow2(bits::Len64(d))
	return nd + bool2[int](d >= u64pow10[nd])
}