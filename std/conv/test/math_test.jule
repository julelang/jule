use "std/conv"
use "std/math"
use "std/testing"

struct pow10Test {
	exp10: int
	mant:  conv::U128
	exp2:  int
	ok:    bool
}

let pow10Tests: []pow10Test = [
	{-349, conv::U128{0, 0}, 0, false},
	{-348, conv::U128{0xFA8FD5A0081C0288, 0x1732C869CD60E453}, -1156, true},
	{0, conv::U128{0x8000000000000000, 0x0000000000000000}, 1, true},
	{347, conv::U128{0xD13EB46469447567, 0x4B7195F2D2D1A9FB}, 1153, true},
	{348, conv::U128{0, 0}, 0, false},
]

fn testPow10(t: &testing::T) {
	for _, tt in pow10Tests {
		mant, exp2, ok := conv::Pow10(tt.exp10)
		if mant != tt.mant || exp2 != tt.exp2 {
			t.Errorf("pow10({}) = {}, {}, {}, {} want {},{}, {}, {}",
				tt.exp10, mant.Hi, mant.Lo, exp2, ok,
				tt.mant.Hi, tt.mant.Lo, tt.exp2, tt.ok)
		}
	}

	mut p := conv::Pow10Min
	for p <= conv::Pow10Max; p++ {
		mant, exp2, ok := conv::Pow10(p)
		if !ok {
			t.Errorf("pow10(%d) not ok", p)
			continue
		}
		// Note: -64 instead of -128 because we only used mant.Hi, not all of mant.
		have := math::Ldexp(f64(mant.Hi), exp2-64)
		want := math::Pow(10, f64(p))
		if math::Abs(have-want)/want > 0.00001 {
			t.Errorf("pow10({}) = {}{}/2^128 * 2^{} = {} want ~{}", p, mant.Hi, mant.Lo, exp2, have, want)
		}
	}
}

fn u128(hi: u64, lo: u64): conv::U128 {
	return conv::U128{Hi: hi, Lo: lo}
}

struct umul192Test {
	x:   u64
	y:   conv::U128
	hi:  u64
	mid: u64
	lo:  u64
}

let umul192Tests: []umul192Test = [
	{0, u128(0, 0), 0, 0, 0},
	{^u64(0), u128(^u64(0), ^u64(0)), ^u64(1), ^u64(0), 1},
]

#test
fn testUmul192(t: &testing::T) {
	for _, tt in umul192Tests {
		hi, mid, lo := conv::Umul192(tt.x, tt.y)
		if hi != tt.hi || mid != tt.mid || lo != tt.lo {
			t.Errorf("umul192({}, {{},{}}) = {}, {}, {}, want {}, {}, {}",
				tt.x, tt.y.Hi, tt.y.Lo, hi, mid, lo, tt.hi, tt.mid, tt.lo)
		}
	}
}

#test
fn testMulLog10_2(t: &testing::T) {
	mut x := -1600
	for x <= +1600; x++ {
		iMath := conv::MulLog10_2(x)
		fMath := int(math::Floor(f64(x) * math::Ln2 / math::Ln10))
		if iMath != fMath {
			t.Errorf("mulLog10_2({}) failed: {} vs {}\n", x, iMath, fMath)
		}
	}
}

#test
fn testMulLog2_10(t: &testing::T) {
	mut x := -500
	for x <= +500; x++ {
		iMath := conv::MulLog2_10(x)
		fMath := int(math::Floor(f64(x) * math::Ln10 / math::Ln2))
		if iMath != fMath {
			t.Errorf("mulLog2_10({}) failed: {} vs {}\n", x, iMath, fMath)
		}
	}
}

fn pow5(mut p: int): u64 {
	mut x := u64(1)
	for p > 0; p-- {
		x *= 5
	}
	return x
}

fn testDivisiblePow5(t: &testing::T) {
	mut p := 1
	for p <= 22; p++ {
		x := pow5(p)
		if conv::DivisiblePow5(1, p) {
			t.Errorf("divisiblePow5(1, {}) = true, want, false", p)
		}
		if conv::DivisiblePow5(x-1, p) {
			t.Errorf("divisiblePow5({}, {}) = true, want false", x-1, p)
		}
		if conv::DivisiblePow5(x+1, p) {
			t.Errorf("divisiblePow5({}, {}) = true, want false", x-1, p)
		}
		if conv::DivisiblePow5(x/5, p) {
			t.Errorf("divisiblePow5({}, {}) = true, want false", x/5, p)
		}
		if !conv::DivisiblePow5(0, p) {
			t.Errorf("divisiblePow5(0, {}) = false, want true", p)
		}
		if !conv::DivisiblePow5(x, p) {
			t.Errorf("divisiblePow5({}, {}) = false, want true", x, p)
		}
		if 2*x > x && !conv::DivisiblePow5(2*x, p) {
			t.Errorf("divisiblePow5({}, {}) = false, want true", 2*x, p)
		}
	}
}

#test
fn testDiv5Tab(t: &testing::T) {
	mut p := 1
	for p <= 22; p++ {
		m := conv::Div5Tab[p-1][0]
		le := conv::Div5Tab[p-1][1]

		// See comment in math.go on div5Tab.
		// m needs to be multiplicative inverse of pow5(p).
		if m*pow5(p) != 1 {
			t.Errorf("pow5Tab[{}-1][0] = {}, but {} * (5**{}) = {}, want 1", p, m, m, p, m*pow5(p))
		}

		// le needs to be ⌊(1<<64 - 1) / 5^p⌋.
		want := (1<<64 - 1) / pow5(p)
		if le != want {
			t.Errorf("pow5Tab[{}-1][1] = {}, want {}", p, le, want)
		}
	}
}

#test
fn testTrimZeros(t: &testing::T) {
	for (_, mut x) in [u64(1), 2, 3, 4, 101, 123] {
		want := x
		mut p := 0
		for p < 20; p++ {
			haveX, haveP := conv::TrimZeros(x)
			if haveX != want || haveP != p {
				t.Errorf("trimZeros({}) = {}, {}, want {}, {}", x, haveX, haveP, want, p)
			}
			if x >= (1<<64-1)/10 {
				break
			}
			x *= 10
		}
	}
}