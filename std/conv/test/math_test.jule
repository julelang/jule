use "std/conv"
use "std/math"
use "std/testing"

#test
fn testLog10Pow2(t: &testing::T) {
	mut x := -1600
	for x <= +1600; x++ {
		iMath := conv::Log10Pow2(x)
		fMath := int(math::Floor(f64(x) * math::Ln2 / math::Ln10))
		if iMath != fMath {
			t.Errorf("Log10Pow2({}) failed: {} vs {}\n", x, iMath, fMath)
		}
	}
}

#test
fn testLog2Pow10(t: &testing::T) {
	mut x := -500
	for x <= +500; x++ {
		iMath := conv::Log2Pow10(x)
		fMath := int(math::Floor(f64(x) * math::Ln10 / math::Ln2))
		if iMath != fMath {
			t.Errorf("Log2Pow10({}) failed: {} vs {}\n", x, iMath, fMath)
		}
	}
}