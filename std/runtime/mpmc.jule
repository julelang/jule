use "std/internal/cpu"
use "std/internal/runtime/atomic"

const (
	// The top bit of enqueuePos is the "closed" mark (like crossbeam's mark bit).
	// Because it lives in the same word as the producer claim CAS,
	// a claim on a closed queue fails atomically.
	closedBit = u64(1) << 63
	posMask   = closedBit - 1
)

// Holds one slot's sequence and the value.
// Vyukov protocol:
//	- Initially: sequence == index (EMPTY for the first pass)
//	- Producer at position pos writes value, then sequence = pos+1 (FULL)
//	- Consumer at position pos reads value, then sequence = pos+capacity (EMPTY for next wrap)
struct mpmcCell[T] {
	seq: u64
	val: T
}

// Bounded, lock-free MPMC ring buffer.
// Primarily designed for channels.
// Implementation based on the Dmitry Vyukov's MPMC queue.
struct mpmcQueue[T] {
	// Read-mostly
	cap:     u64
	capmask: u64
	closed:  u32
	buf:     []mpmcCell[T]

	_pad0:      [cpu::CacheLinePadSize]byte
	enqueuePos: u64 // producers (+ closedBit)
	_pad1:      [cpu::CacheLinePadSize]byte
	dequeuePos: u64 // consumers
	_pad2:      [cpu::CacheLinePadSize]byte
}

impl mpmcQueue {
	#disable boundary
	fn new(mut cap: u64): (q: mpmcQueue[T]) {
		cap = nextPowerOfTwo(cap)
		if cap < 2 {
			cap = 2
		}
		q.cap = cap
		q.buf = make([]mpmcCell[T], q.cap)
		q.capmask = q.cap - 1

		// Initialize per-slot sequence numbers to their indices
		mut i := u64(0)
		for i < q.cap; i++ {
			q.buf[i].seq = i
		}
		return
	}

	#disable boundary nilptr
	fn enqueue(mut *self, mut &val: *T): (ok: bool, closed: bool) {
		mut iter := u32(0)
		for {
			mut pos := atomic::Load(&self.enqueuePos, atomic::Relaxed)
			if pos&closedBit != 0 {
				return false, true
			}

			mut &c := unsafe { &(*(&self.buf[pos&self.capmask])) }
			seq := atomic::Load(&c.seq, atomic::Acquire)
			dif := i64(seq - pos)

			if dif == 0 {
				// Try to claim slot. Fails if another producer advanced
				// enqueuePos or if close() set the closed bit meanwhile.
				if atomic::CompareAndSwapWeak(&self.enqueuePos, &pos, pos+1, atomic::AcqRel, atomic::Relaxed) {
					c.val = *val
					atomic::Store(&c.seq, pos+1, atomic::Release)
					return true, false
				}
				continue
			}

			if dif < 0 {
				// Slot not ready — MAY be full, confirm via cursors.
				// Signed compare: pos may be stale (deq can be ahead of pos).
				deq := atomic::Load(&self.dequeuePos, atomic::Acquire)
				if i64(pos-deq) >= i64(self.cap) {
					return false, false // FULL
				}
				// Not guaranteed full → retry
				waitSpin(&iter)
				continue
			}

			// dif > 0 → another producer ahead
			waitSpin(&iter)
		}
	}

	// Attempts to pop one element; returns (false, closed) if empty.
	// Non-blocking; uses polite backoff on contention.
	#disable boundary nilptr
	fn dequeue(mut *self, mut &val: *T): (ok: bool, closed: bool) {
		mut iter := u32(0)
		for {
			mut pos := atomic::Load(&self.dequeuePos, atomic::Relaxed)
			mut &c := unsafe { &(*(&self.buf[pos&self.capmask])) }
			seq := atomic::Load(&c.seq, atomic::Acquire)
			dif := i64(seq - (pos + 1))

			if dif == 0 {
				// slot is FULL for this consumer position: try to claim it
				if atomic::CompareAndSwapWeak(&self.dequeuePos, &pos, pos+1, atomic::AcqRel, atomic::Relaxed) {
					// exclusive access to this slot
					*val = c.val
					// help GC: clear the slot's value
					let mut zero: T
					c.val = zero
					// mark EMPTY for the next wrap-around pass
					atomic::Store(&c.seq, pos+self.cap, atomic::Release)
					closed = atomic::Load(&self.closed, atomic::Relaxed) != 0
					return true, closed
				}
				// lost race → retry
			} else if dif < 0 {
				// seq < pos+1 ⇒ producer hasn't published (or claimed) yet.
				closed = atomic::Load(&self.closed, atomic::Acquire) != 0
				if !closed {
					return false, false // EMPTY
				}
				// Closed: the queue is really empty only if no producer
				// claimed a slot that is still being written.
				tail := atomic::Load(&self.enqueuePos, atomic::Acquire)
				if tail&posMask == pos {
					return false, true // EMPTY and closed
				}
				// In-flight element: wait for its publication so it is not lost.
				waitSpin(&iter)
			} else {
				// another consumer is ahead / not our turn yet → polite backoff
				waitSpin(&iter)
			}
		}
	}

	#disable nilptr
	fn close(mut *self) {
		// Set the mark bit in enqueuePos first (linearizes with producer claims),
		// then publish the flag that consumers read cheaply.
		mut pos := atomic::Load(&self.enqueuePos, atomic::Relaxed)
		for pos&closedBit == 0 {
			if atomic::CompareAndSwapWeak(&self.enqueuePos, &pos, pos|closedBit, atomic::AcqRel, atomic::Relaxed) {
				break
			}
		}
		atomic::Store(&self.closed, 1, atomic::Release)
	}
}