#build x32

// The number of bits stored in the numeric tag of a taggedPointer
const tagBits = 32

impl taggedPointer {
	// Created a taggedPointer from a pointer and a tag.
	// Tag bits that don't fit in the result are discarded.
	fn pack(ptr: *unsafe, tag: uintptr): taggedPointer {
		return taggedPointer(uintptr(ptr))<<tagBits | taggedPointer(tag)
	}

	// Pointer returns the pointer from a taggedPointer.
	fn pointer(*self): *unsafe {
		return unsafe { (*unsafe)(uintptr(*self >> tagBits)) }
	}

	// Tag returns the tag from a taggedPointer.
	fn tag(*self): uintptr {
		return uintptr(*self)
	}
}