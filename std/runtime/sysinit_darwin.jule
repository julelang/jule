use "std/sys"
use "std/unsafe"

extern fn getpagesize(): int

fn setnumcpu() {
	// NOTE:
	// Do not allocate slice here, instead use an array and handle it like a slice.
	// Because thread and memory allocator si not initialized yet.
	// Since slice literal triggers memory allocation, it may lead to crash.
	const HW_NCPU = 3
	let mut mib: [2]i32 = [sys::CTL_HW, HW_NCPU]
	mut smib := unsafe::Slice(&mib[0], len(mib), len(mib))
	mut ncpu := i32(0)
	let SizeOfNCPU: uint = 4 // 32-bit
	sys::Sysctl(smib, uintptr(&ncpu), uintptr(&SizeOfNCPU), 0, 0)!
	numcpu = int(ncpu)
	if numcpu == 0 {
		numcpu = 1
	}
}

fn setGlobalPageSize() {
	globalPageSize = uintptr(extern.getpagesize())
}

fn sysinit() {
	setGlobalPageSize()
	setnumcpu()
}