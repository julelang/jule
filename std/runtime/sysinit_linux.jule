use "std/sys"

extern fn getpagesize(): int

fn setnumcpu() {
	let mut set: sys::CPUSet
	set.Zero()
	sys::SchedGetaffinity(0, &set)!
	numcpu = set.Count()
	if numcpu == 0 {
		numcpu = 1
	}
}

fn setGlobalPageSize() {
	globalPageSize = uintptr(extern.getpagesize())
}

fn sysinit() {
	setGlobalPageSize()
	setnumcpu()
}