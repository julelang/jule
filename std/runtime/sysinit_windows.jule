fn sysinit() {
	let mut sysinfo: systeminfo
	_GetSystemInfo(&sysinfo)

	// Set numcpu.
	numcpu = int(sysinfo.dwnumberofprocessors)
	if numcpu == 0 {
		numcpu = 1
	}

	// Set global page size.
	globalPageSize = uintptr(sysinfo.dwpagesize)
}