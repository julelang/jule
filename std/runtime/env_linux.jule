use "std/sys"
use "std/unsafe"

fn executable(): string {
	mut buf := make([]byte, sys::PATH_MAX)
	n := sys::Readlink("/proc/self/exe", buf) catch {
		panic("runtime: executable path read error")
	}
	buf = buf[:n]
	return unsafe::StringFromBytes(buf)
}