use "std/intrinsic"

// A thread pool job.
struct threadpoolJob {
	job:  fn()
	link: &threadpoolJob
}

// Environment for the thread pool.
// Implements a worker thread pool for tasks.
// See "Thread synchronization" comment of the scheduler.
//
// This is also an ordinary thread pool.
// Sync or async programs may use this for thread-based concurrency.
struct threadpool {
	maxWorkers: i32 // Constant once initialized.

	mu:    mutex
	head:  &threadpoolJob
	tail:  &threadpoolJob
	nw:    i32     // Count of the created worker threads.
	widle: *thread // Parkers of the idle workers waiting for work.
}

impl threadpool {
	// Gets a job from queues.
	#disable nilptr boundary
	fn getjob(mut *self, mut &job: *&threadpoolJob) {
		self.mu.lock()
		if self.head != nil {
			*job = self.head
			self.head = (*job).link
			(*job).link = nil
		}
		self.mu.unlock()
		return
	}

	// Wakes a worker thread, if needed.
	// The `threadpool.mu` must be locked and will not be releases before return.
	#disable nilptr
	fn wakew(mut *self) {
		// We have a cached worker thread. Notify it.
		if self.widle != nil {
			mut w := self.widle
			unsafe {
				self.widle = w.link
				w.link = nil
				w.parker.unpark()
			}
			return
		}
		// Spawn a new one, if possible.
		if self.nw < self.maxWorkers {
			self.nw++
			ok := unsafe { threadSpawn((*unsafe)(uintptr(threadpoolWorker)), nil) }
			if !ok {
				panic("runtime: thead pool worker thread creation failed")
			}
		}
	}
}

// Initialized by the runtime.
#noinit
let mut globalThreadPool: threadpool

// A thread pool worker.
//
// The operating system thread API passes a pointer to the function when calling it.
// In the final stage, this function's signature fits with the OS thread API.
//
// Since this function never returns, there should be no risk about return value.
#disable nilptr
fn threadpoolWorker(_: *unsafe) {
	// Set thread-local data before start.
	// Do not allocate a thread instance on heap,
	// stack allocation is efficient and enough here.
	let mut w: thread
	// Use `sett` to set thread-local &thread data for the thread.
	// The following thread instance initialization will use it.
	mut wp := unsafe { (&thread)(&w) }
	sett(wp)
	initThread(&w, roleThreadPoolWorker)

	const MaxSpin = 4
	mut tried := 0
	for {
		let mut job: &threadpoolJob
		globalThreadPool.getjob(&job)
		if job == nil {
			// No job to run.
			// Under high contention, new job may be available since last lookup.
			// Try again if reasonable.
			if tried < MaxSpin {
				tried++
				continue
			}
			globalThreadPool.mu.lock()
			// A job is enqueued, try again.
			if globalThreadPool.head != nil {
				globalThreadPool.mu.unlock()
				continue
			}
			// Park the thread and continue it will be continue to run when notified.
			tried = 0
			w.link = globalThreadPool.widle
			globalThreadPool.widle = &w
			globalThreadPool.mu.unlock()
			w.parker.park()
			continue
		}
		tried = 0
		job.job()
	}
}

fn threadpoolinit() {
	globalThreadPool = threadpool{}
	globalThreadPool.maxWorkers = i32(NumCPU())
}

// Designed for CPU-bound work, where each task is executed on a thread pool.
// It is designed to enable synchronous programs to perform concurrent
// computations for CPU-bound tasks without thread management concerns.
// Uses a common thread pool for all jobs.
#disable nilptr
fn Task(job: fn()) {
	// We need this compiler hint for sync programs.
	// Because compiler does not know this function introduces concurrency.
	// Therefore, it may use non-atomic reference counting for memory management,
	// and non-atomic reference counting may cause issues like double-free
	// with concurrent execution.
	intrinsic::Concurrent()

	// We will use heap allocation because this is not a blocking call.
	// Therefore, we need heap allocation to avoid deallocation when scope ends.
	mut bj := &threadpoolJob{job: job}
	globalThreadPool.mu.lock()
	if globalThreadPool.head == nil {
		globalThreadPool.head = bj
		globalThreadPool.tail = globalThreadPool.head
	} else {
		globalThreadPool.tail.link = bj
		globalThreadPool.tail = bj
	}
	globalThreadPool.wakew()
	globalThreadPool.mu.unlock()
}