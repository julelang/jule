extern let mut __jule_ct: *thread

const (
	// Thread roles.
	roleProgram        = 1 << iota // The main thread of the program.
	roleM                          // A machine (M) thread.
	roleBlockingWorker             // A worker thread for the blocking thread pool.
)

// A thread instance is represents a spawned thread.
// Used by the Jule runtime to manage threads.
#export "__jule_thread"
struct thread {
	// Parker of the thread.
	parker: &parker

	// Role of the thread for runtime.
	role: int

	// The P owned by the thread.
	pp: &p

	// Current coroutine of the thread.
	c: c

	// Local random state.
	rand:      randmach
	cheaprand: u64

	// Actively searching for runnable coroutines instead of sleeping.
	spinning: bool

	// Link to the next thread.
	link: &thread

	// Local thread heap.
	heap: *heap
}

// Returns the current thread.
// Uses the thread-local data.
fn gett(): &thread {
	return unsafe { (&thread)(extern.__jule_ct) }
}

// Sets the current thread as t.
// Writes to the thread-local data.
fn sett(mut t: &thread) {
	extern.__jule_ct = (*thread)(t)
}

// Value of the main M, the main program thread.
#noinit
let mut mainm: thread

// Stores total number of logical threads.
#noinit
let mut numcpu: int

// Returns the number of logical CPUs usable by the current process.
//
// The set of available CPUs is checked by querying the operating system
// at process startup. Changes to operating system CPU allocation after
// process startup are not reflected.
fn NumCPU(): int { return numcpu }

// Initializes thread t and sets state as running.
#disable nilptr
fn initThread(mut &t: *thread, role: int) {
	t.role = role

	// Initialize allocator for thread.
	// Do it immediately, because thread performs memory allocation in
	// following statements.
	mallocThreadInit(t)

	// Initialized once and never deallocated if thread waiting for reuse.
	t.parker = new(parker)
	t.parker.init()

	if role == roleProgram || role == roleM {
		// Initialize local random state.
		trandinit(t)
	}
}

// Allocates a new thread and sets state as running.
#disable nilptr
fn newThread(role: int): &thread {
	mut t := new(thread)
	initThread(&*t, role)
	return t
}

// Releases thread t, releases parker and drops references.
#disable nilptr
fn releaseThread(mut &t: *thread) {
	t.pp = nil
	t.role = 0
	t.parker.release()
	mallocThreadFinalize(t)
}

fn threadinit() {
	// Program started by the main thread.
	// Use `sett(mainm)` to set thread-local &thread data for the main thread.
	sett(unsafe { (&thread)(&mainm) })
	// Initialize the main program thread.
	initThread(&mainm, roleProgram)
}

// Number of cheap CPU-pause spins before
// escalates to a real runtime/OS scheduler yield.
const spinThreshold = 100

// Does active spinning.
fn doSpin() { panic("compiler-implemented") }

// Increases iter and checks for whether spinning makes sense at the moment.
// If so, performs cheap CPU-pause, otherwise OS scheduler yield.
// This works at M level, not C level.
#disable nilptr
fn waitSpin(mut &iter: *u32) {
	*iter++
	if *iter < spinThreshold {
		doSpin()
	} else {
		osyield()
	}
}