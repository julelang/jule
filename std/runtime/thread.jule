use "std/internal/runtime"

extern let mut __jule_ct: *thread

const (
	// Thread roles.
	roleProgram          = 1 << iota // The main thread of the program.
	roleSpawn                        // A user thread.
	roleThreadPoolWorker             // A worker thread for the thread pool.

	// State flags of threads.
	threadRunning = 1 << iota
	threadSuspended
	threadClosed

	// State flags of threads for suspend reason.
	reasonNA          = 0
	reasonRecv        = 1 << iota // Channel-recv.
	reasonSend                    // Channel-send.
	reasonWaitGroup               // WaitGroup.
	reasonMutex                   // Mutex.
	reasonCond                    // Condition variable.
	reasonSelect                  // Header group specifier of select statement.
	reasonSelectEmpty             // Empty select statement state. Use like reasonSelect&reasonSelectEmpty.
	reasonSleep                   // Sleep.
	reasonIOWait                  // Waits for a pollable I/O.

	reasonMask = reasonRecv | reasonSend | reasonWaitGroup | reasonMutex |
		reasonCond | reasonSelect | reasonSelectEmpty
)

// A thread instance is represents a spawned thread.
// Used by the Jule runtime to manage threads.
#export "__jule_thread"
struct thread {
	// Role of the thread for runtime.
	role: int
	// Thread state and suspend reasons if thread is suspended.
	// The reasons may be not zeroed after thread closed or woken.
	state: u32
	// Local thread heap.
	heap: *heap
	// Parker of the thread.
	parker: &parker
	// Local random state.
	rand:      randmach
	cheaprand: u64
	// Link to the next thread.
	link: &thread
}

// Returns the current thread.
// Uses the thread-local data.
fn gett(): &thread {
	return unsafe { (&thread)(extern.__jule_ct) }
}

// Sets the current thread as t.
// Writes to the thread-local data.
fn sett(mut t: &thread) {
	extern.__jule_ct = (*thread)(t)
}

// Value of the main M, the main program thread.
#noinit
let mut mainm: thread

// Stores total number of logical threads.
#noinit
let mut numcpu: int

// Returns the number of logical CPUs usable by the current process.
//
// The set of available CPUs is checked by querying the operating system
// at process startup. Changes to operating system CPU allocation after
// process startup are not reflected.
fn NumCPU(): int { return numcpu }

// Initializes thread t and sets state as running.
#disable nilptr
fn initThread(mut &t: *thread, role: int) {
	t.role = role

	// Initialize allocator for thread.
	// Do it immediately, because thread performs memory allocation in
	// following statements.
	mallocThreadInit(t)

	// Initialized once and never deallocated if thread waiting for reuse.
	t.parker = new(parker)
	t.parker.init()

	if role == roleProgram || role == roleSpawn || role == roleThreadPoolWorker {
		// Initialize local random state.
		trandinit(t)
	}
}

// Allocates a new thread and sets state as running.
#disable nilptr
fn newThread(role: int): &thread {
	mut t := new(thread)
	initThread(&*t, role)
	return t
}

// Allocates a new thread for a new thread-spawn and sets state as running.
// The returned pointer have no GC integration and it must be freed manually.
fn newSpawnThread(role: int): &thread {
	mut t := newThread(role)
	unsafe {
		// Must be in non-GC memory because can be referenced
		// from any runtime system during program lifetime.
		// Remove RC pointer and disable GC for allocation.
		// Allocated threads are never will be deallocated, usually.
		// Some tools like Valgrind may detect as memory leak,
		// but this was done on purpose.
		//
		// However, if the thread will be deallocated, we still have to disable
		// GC integration because thread allocation may go out of scope after spawn;
		// since this will trigger deallocation (we cannot pass smartptr to threads),
		// allocator and other runtime data will be invalid but the thread still
		// may be running and may or may not use the allocation, which is UB.
		mut tptr := (*runtime::Smartptr[thread])(&t)
		_RCFree(tptr.Ref)
		tptr.Ref = nil
	}
	return t
}

// Releases thread t, releases parker and drops references.
#disable nilptr
fn releaseThread(mut &t: *thread) {
	t.role = 0
	t.state = 0
	t.parker.release()
	t.parker = nil
	t.link = nil
	mallocThreadFinalize(t)
}

// This routine is called by the runtime before start execution of the thread.
// Usually invoked for "spawn" threads.
#disable nilptr
fn beginThread(mut &t: *thread) {
	// Use `sett` to set thread-local &thread data for the thread.
	sett(unsafe { (&thread)(t) })
	initThread(t, roleSpawn)
}

// This routine is called by the runtime before return (destroy) from the thread.
// Usually invoked for "spawn" threads.
#disable nilptr
fn closeThread(mut &t: *thread) {
	releaseThread(t)
	t.state = threadClosed
}

fn threadinit() {
	// Program started by the main thread.
	// Use `sett(mainm)` to set thread-local &thread data for the main thread.
	sett(unsafe { (&thread)(&mainm) })
	// Initialize the main program thread.
	initThread(&mainm, roleProgram)
}

// Suspends the current thread and yields the CPU.
// If the mu is not zero, assumes it already locked and releases before yield.
// If reason is related with a sema, will not handle mu as a mutex.
// If the parker is not nil, parks suspended thread.
// The thread can be made runnable again by calling [parker.unpark].
#disable nilptr
fn tpark(mut &parker: *parker, mu: uintptr, mut reason: u32) {
	mut t := gett()
	tpark2(&*t, parker, u64(mu), reason)
}

// Suspends the thread t and yields the CPU.
// If the mu is not zero, assumes it already locked and releases before yield.
// If reason is related with a sema, will not handle mu as a mutex.
// If the parker is not nil, parks suspended thread.
// The thread can be made runnable again by calling [parker.unpark].
// The thread-mutex must be acquired, this function will release it.
#disable nilptr
fn tpark2(mut &t: *thread, mut &parker: *parker, mu: u64, mut reason: u32) {
	t.state &= ^(threadRunning | threadClosed)
	t.state |= threadSuspended | reason
	mutexunlock(mu)
	// Park the thread and yield the CPU until to be unparked by the another thread.
	parker.park()
	t.state &= ^(threadSuspended | reason)
	t.state |= threadRunning
}

// Number of cheap CPU-pause spins before
// escalates to a real runtime/OS scheduler yield.
const spinThreshold = 100

// Does active spinning.
fn doSpin() { panic("compiler-implemented") }

// Increases iter and checks for whether spinning makes sense at the moment.
// If so, performs cheap CPU-pause, otherwise OS scheduler yield.
// This works at M level, not C level.
#disable nilptr
fn waitSpin(mut &iter: *u32) {
	*iter++
	if *iter < spinThreshold {
		doSpin()
	} else {
		osyield()
	}
}