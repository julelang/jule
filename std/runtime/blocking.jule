// A blocking job.
struct blockingJob {
	job:  fn()
	cp:   &c
	link: &blockingJob
}

// Environment for the blocking thread pool.
// Implements a worker thread pool for blocking tasks.
// See "Thread synchronization" comment of the scheduler.
//
// This is also an ordinary thread pool.
// Sync or async programs may use this for thread-based concurrency.
struct blockingenv {
	maxWorkers: i32 // Constant once initialized.

	mu:    mutex
	head:  &blockingJob
	tail:  &blockingJob
	nw:    i32     // Count of the created worker threads.
	widle: &thread // Parkers of the idle workers waiting for work.
}

impl blockingenv {
	// Gets a job from queues.
	#disable nilptr boundary
	fn getjob(mut *self, mut &job: *&blockingJob) {
		self.mu.lock()
		if self.head != nil {
			*job = self.head
			self.head = (*job).link
			(*job).link = nil
		}
		self.mu.unlock()
		return
	}

	// Wakes a worker thread, if needed.
	// The `blocking.mu` must be locked and it will not release it before return.
	#disable nilptr
	fn wakew(mut *self) {
		// We have a cached worker thread. Notify it.
		if self.widle != nil {
			mut w := self.widle
			self.widle = w.link
			w.link = nil
			w.parker.unpark()
			return
		}
		// Spawn a new one, if possible.
		if self.nw < self.maxWorkers {
			self.nw++
			ok := unsafe { threadSpawn((*unsafe)(uintptr(blockingWorker)), nil) }
			if !ok {
				panic("runtime: blocking worker thread creation failed")
			}
		}
	}
}

// Initialized by the runtime.
let mut blocking = blockingenv{}

// A blocking thread pool worker.
//
// The operating system thread API passes a pointer to the function when calling it.
// In the final stage, this function's signature fits with the OS thread API.
//
// Since this function never returns, there should be no risk about return value.
#disable nilptr
fn blockingWorker(_: *unsafe) {
	mut w := newThread(roleBlockingWorker)
	sett(w)

	const MaxSpin = 4
	mut tried := 0
	for {
		let mut job: &blockingJob
		blocking.getjob(&job)
		if job == nil {
			// No job to run.
			// Under high contention, new job may be available since last lookup.
			// Try again if reasonable.
			if tried < MaxSpin && (!asynctime || sched.ncrunning() > 0) {
				tried++
				continue
			}
			blocking.mu.lock()
			// A job is enqueued, try again.
			if blocking.head != nil {
				blocking.mu.unlock()
				continue
			}
			// Park the thread and continue it will be continue to run when notified.
			tried = 0
			w.link = blocking.widle
			blocking.widle = w
			blocking.mu.unlock()
			w.parker.park()
			continue
		}
		tried = 0
		// Do job and unpark the coroutine (if exist), it is ready to go.
		job.job()
		if job.cp != nil {
			unpark(&(*job.cp))
		}
	}
}

fn blockinginit() {
	blocking = blockingenv{}
	blocking.maxWorkers = i32(NumCPU())
}

// Executes the given job on the blocking thread pool,
// isolating a potentially blocking operation from the scheduler.
//
// The scheduler does NOT automatically detect or offload blocking operations.
// If a blocking call (e.g. file I/O or FFI) is executed directly,
// the underlying scheduler thread (M) will block.
//
// Use this function when you want to explicitly prevent
// a blocking operation from stalling scheduler progress.
//
// This function is opt-in and never used implicitly by the runtime.
#disable nilptr
async fn Blocking(job: fn()) {
	mut m := gett()
	mc := m.c
	mut bj := blockingJob{job: job, cp: unsafe { (&c)(&mc) }}
	mut bjp := unsafe { (&blockingJob)(&bj) }
	blocking.mu.lock()
	if blocking.head == nil {
		blocking.head = bjp
		blocking.tail = blocking.head
	} else {
		blocking.tail.link = bjp
		blocking.tail = bjp
	}
	// We use the tagged pointer to call `blocking.wakew` after adding
	// a new job to the queue. It is done by mutex-unlock algorithm.
	// The `blocking.mu` will be released after park due to `mutexunlockJobAdd`.
	tp := taggedPointerPack(nil, mutexunlockJobAdd)
	sched.enterblock()
	park2(&(*bj.cp), tp, reasonBlocking).await
	sched.exitblock()
}

// Designed for CPU-bound work, where each task is executed on a thread pool.
// This thread pool may be shared with the pool used by the [Blocking].
// It is designed to enable synchronous programs to perform concurrent
// computations for CPU-bound tasks without thread management concerns.
#disable nilptr
fn Task(job: fn()) {
	// We need this compiler hint for sync programs.
	// Because compiler does not know this function introduces concurrency.
	// Therefore, it may use non-atomic reference counting for memory management,
	// and non-atomic reference counting may cause issues like double-free
	// with concurrent execution.
	unsafe { Hint(H_CONCURRENT) }

	// We will use heap allocation because this is not a blocking call.
	// Therefore, we need heap allocation to avoid deallocation when scope ends.
	mut bj := &blockingJob{job: job}
	blocking.mu.lock()
	if blocking.head == nil {
		blocking.head = bj
		blocking.tail = blocking.head
	} else {
		blocking.tail.link = bj
		blocking.tail = bj
	}
	// We use the tagged pointer to call `blocking.wakew` after adding
	// a new job to the queue. It is done by mutex-unlock algorithm.
	// The `blocking.mu` will be released due to `mutexunlockJobAdd`.
	tp := taggedPointerPack(nil, mutexunlockJobAdd)
	mutexunlock(u64(tp))
}