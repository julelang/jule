// A pointer with a numeric tag.
// The size of the numeric tag is arch-dependent,
// currently at least 15 bits.
type taggedPointer: u64

const (
	// Minimum number of tag bits that we expect.
	minTagBits = 15

	// The number of bits stored in the numeric tag of a taggedPointer.
	taggedPointerBits = tagBits
)