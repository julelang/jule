use "std/comptime"
use "std/internal/runtime"
use "std/unsafe"

// Reports whether pointer allocations are points to same address.
#export "__jule_ptrEqual"
fn ptrEqual(a: *unsafe, b: *unsafe): bool {
	return a == b
}

// Returns string based on b, the parameter b means first byte of string.
// The returned string uses n as length.
// Will not perform garbage collection.
#export "__jule_stringBytePtr"
unsafe fn stringBytePtr(b: *byte, n: int): string {
	mut s := ""
	mut sb := (*runtime::String)(&s)
	sb.Buffer.Ptr = *(&b)
	sb.Buffer.Ref = nil
	sb.Slice = sb.Buffer.Ptr
	sb.Len = n
	return s
}

// Equals to sliceBytePtr(&s[0], len(s), len(s)) call.
// Returns nil slice for empty string.
#export "__jule_stringAsSlice"
fn stringAsSlice(s: string): []byte {
	if len(s) == 0 {
		return nil
	}
	return unsafe::Slice(&s[0], len(s), len(s))
}

// Returns slice based on b, the parameter b means first element of slice.
// Will not perform garbage collection.
#export "__jule_sliceBytePtr"
fn sliceBytePtr(mut b: *byte, len: int, cap: int): []byte {
	return unsafe::Slice(b, len, cap)
}

// Returns byte slice as string.
// Equals to stringBytePtr(&b[0], len(b)) call.
// Returns empty string if len(b) == 0.
#export "__jule_sliceAsString"
fn sliceAsString(b: []byte): string {
	if len(b) == 0 {
		return ""
	}
	return unsafe { stringBytePtr(&b[0], len(b)) }
}

// Fills the first n bytes of the pointer p with the constant byte b.
unsafe fn memset(mut p: *unsafe, b: byte, mut n: uint) {
	if p == nil {
		return
	}
	mut bp := (*byte)(p)
	for n > 0; n-- {
		*bp = b
		bp++
	}
}

// Adds n offset to p in bytes.
fn add(p: *unsafe, n: uintptr): *unsafe {
	return unsafe { (*unsafe)(uintptr(p) + n) }
}

// Note: Perform the read with a native endianness.
#disable boundary
unsafe fn readUnaligned32(p: *unsafe): u32 {
	q := (*byte)(p) // *[4]byte
	if BigEndian {
		return u32(q[3]) | u32(q[2])<<8 | u32(q[1])<<16 | u32(q[0])<<24
	}
	return u32(q[0]) | u32(q[1])<<8 | u32(q[2])<<16 | u32(q[3])<<24
}

// Note: Perform the read with a native endianness.
#disable boundary
unsafe fn readUnaligned64(p: *unsafe): u64 {
	q := (*byte)(p) // *[8]byte
	if BigEndian {
		return u64(q[7]) | u64(q[6])<<8 | u64(q[5])<<16 | u64(q[4])<<24 |
			u64(q[3])<<32 | u64(q[2])<<40 | u64(q[1])<<48 | u64(q[0])<<56
	}
	return u64(q[0]) | u64(q[1])<<8 | u64(q[2])<<16 | u64(q[3])<<24 |
		u64(q[4])<<32 | u64(q[5])<<40 | u64(q[6])<<48 | u64(q[7])<<56
}

// Compiler optimized function calls for `fastmemcopy` function.
// For C++ backend, they will be optimized to `std::copy` and `std::copy_backward`.
// Parameters will not be casted to `*unsafe`, which is equals to `void*` in C.
// Compiler will generate function call with the original pointer types,
// so C++ template can be instantiated properly.
fn fastmemcopy_forward(first: *unsafe, last: *unsafe, result: *unsafe) { panic("compiler-implemented") }
fn fastmemcopy_backward(first: *unsafe, last: *unsafe, result: *unsafe) { panic("compiler-implemented") }

// The runtime implementation of the built-in copy function.
// But possibly faster than the Pure Jule implementation `memcopy`.
// Because compiler will use optimized copy functions under the hood.
// Formerly this function will be used only for trivially copyable types.
// However, it is identical to `memcopy` and can be safely used for all types now
// because it relies to C++ compatible functions instead of `memmove`.
// So compiler will use this implementation anyway.
// There is no need to instantiate the `memcopy` function.
//
// We use C++ compatible copt functions instead of `memmove`, because
// brief tests shows C++ compilers can optimize copy functions good enough.
unsafe fn fastmemcopy[Dest, Src](mut dest: Dest, mut src: Src): (n: int) {
	n = len(src)
	if n > len(dest) {
		n = len(dest)
	}
	if n == 0 {
		return
	}
	// fastmemcopy may have string type for Src but it is safe to
	// handle them as slice. According to Jule memory model,
	// slice memory model can represent a string memory model.
	// And this implementation does not need to slice-specific data.
	comptime::TypeAlias(E, comptime::Typeof(Dest).Value())
	mut d := (*runtime::Slice[E])(&dest).Slice
	mut s := (*runtime::Slice[E])(&src).Slice
	if d > s && u64(d-s) < u64(n) {
		// to overlaps with from
		// <from...>
		//        <to...>
		// use backward copy, to avoid overwriting from
		fastmemcopy_backward(s, s+n, d+n)
	} else {
		// to overlaps with from
		//      <from...>
		// <to...>
		// use forward copy, to avoid overwriting from
		fastmemcopy_forward(s, s+n, d)
	}
	return
}

// The runtime implementation of the built-in copy function.
// This is a Pure Jule implementation.
// But compiler may optimize it to a more efficient variant, fastmemcopy.
// To enable optimizations, even in this package, use the built-copy function
// instead of direct call to the memcopy function.
fn memcopy[Dest, Src](mut dest: Dest, mut src: Src): (n: int) {
	n = len(src)
	if n > len(dest) {
		n = len(dest)
	}
	if n == 0 {
		return
	}
	// Use pointers to skip boundary checking cost and fast access.
	unsafe {
		// memcopy may have string type for Src but it is safe to
		// handle them as slice. According to Jule memory model,
		// slice memory model can represent a string memory model.
		// And this implementation does not need to slice-specific data.
		comptime::TypeAlias(E, comptime::Typeof(Dest).Value())
		mut d := (*runtime::Slice[E])(&dest).Slice
		mut s := (*runtime::Slice[E])(&src).Slice
		if d > s && u64(d-s) < u64(n) {
			// to overlaps with from
			// <from...>
			//        <to...>
			// use backward copy, to avoid overwriting from
			f := s
			i := n - 1
			d += i
			s += i
			for f <= s {
				*d = *s
				d--
				s--
			}
		} else {
			// to overlaps with from
			//      <from...>
			// <to...>
			// use forward copy, to avoid overwriting from
			end := s + n
			for s < end {
				*d = *s
				d++
				s++
			}
		}
	}
	return
}

// Returns the next capacity for a growing slice.
fn nextslicecap(newLen: int, oldCap: int): int {
	// Various approaches were tested here, such as Go's transition algorithm
	// (from 2x down to 1.25x). However, these led to increased memory consumption in practice.
	// While the exact cause remains unclear, they appeared to be incompatible with the
	// C/C++ allocator. A 1.5x growth factor provided the best balance.

	// Grows by 1.5x to stay below the golden ratio (1.618), enabling
	// allocator reuse of previously freed blocks and reducing heap fragmentation.
	// Falls back to newLen if 1.5x is insufficient or overflows.
	newcap := oldCap + oldCap>>1 // 1.5x
	// Check newcap >= newLen and overflow simultaneously:
	// if newcap overflows to negative, uint(newcap) wraps to a large value,
	// which still satisfies the comparison since newLen is guaranteed > 0.
	if uint(newcap) >= uint(newLen) {
		return newcap
	}
	return newLen
}

// Prepreation phase of memory append.
// If the slice s have not enough capacity for newItems, allocates a new slice for s.
fn prememappend[Slice](mut &s: *Slice, newItems: int) {
	if cap(*s)-len(*s) >= newItems {
		return
	}
	mut ns := make(Slice, len(*s), nextslicecap(len(*s)+newItems, cap(*s)))
	copy(ns, *s)
	*s = ns
}

// The runtime implementation of the built-in append function.
#disable boundary
fn memappend[Dest, Src](mut dest: Dest, mut src: Src): Dest {
	if len(src) == 0 {
		return dest
	}
	prememappend(&dest, len(src))
	n := len(dest)
	dest = dest[:len(dest)+len(src)]
	copy(dest[n:], src)
	return dest
}

// TODO: consider better linking
extern fn __jule_panicString(m: string)

// Checks whether the reference pointer is nil, panics if so.
// Returns the pointer p.
// Intended to allow inline safety checks.
// For example: *(*int)(checkNilRef(myRef, "msg")) = 20
fn checkNilRef(mut p: *unsafe, msg: string): *unsafe {
	if p == nil {
		extern.__jule_panicString(msg)
	}
	return p
}