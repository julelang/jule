use "std/integ"
use "std/sys"
use "std/unicode/utf8"
use "std/unsafe"

fn write1(fd: uintptr, buf: []byte): int {
	mut isASCII := false
	for _, x in buf {
		if x >= utf8::RuneSelf {
			isASCII = false
			break
		}
	}

	handle := sys::Handle(fd)
	if !isASCII {
		let mut mode: u32
		isConsole := unsafe { sys::GetConsoleMode(handle, &mode) }
		if isConsole {
			// If this is a console output, various non-unicode code pages can be in use.
			// Use the dedicated WriteConsole call to ensure unicode is printed correctly.
			return writeConsole(handle, buf)
		}
	}
	return sys::WriteFile(handle, buf) else { use -1 }
}

fn writeConsole(handle: sys::Handle, buf: []byte): int {
	if len(buf) == 0 {
		return 0
	}
	str := unsafe::StringFromBytes(buf)
	utf16 := integ::UTF16FromString(str)
	let mut written: u32
	unsafe {
		sys::WriteConsole(
			handle,
			&utf16[0], u32(len(utf16)),
			&written,
			nil) else { return -1 }
	}
	return int(written)
}