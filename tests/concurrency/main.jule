use "std/runtime"
use "std/sync"
use "std/sync/atomic"

let mut n = atomic::Int(0)

fn addToN(mut wg: &sync::WaitGroup) {
	n.Add(1, atomic::Relaxed)
	wg.Done()
}

fn main() {
	mut wg := sync::WaitGroup.New()
	const Total = 1_000_000
	mut j := 0
	for j < Total; j++ {
		wg.Add(1)
		runtime::Task(fn|| addToN(wg))
	}
	wg.Wait()
	println(n.Load(atomic::Relaxed))
}