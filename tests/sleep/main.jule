use "std/runtime"
use "std/sync/atomic"
use "std/time"

fn checkTiming() {
	mut x := new(int)
	runtime::Task(fn() {
		time::Sleep(1 * time::Millisecond)
		atomic::Store(&*x, 1, atomic::Release)
	})
	time::Sleep(2 * time::Millisecond)
	if atomic::Load(&*x, atomic::Acquire) != 1 {
		panic("thread runs before earlier timer")
	}
}

fn checkDuration() {
	timestamp := time::Instant.Now()
	time::Sleep(10 * time::Nanosecond)
	elapsed := timestamp.Since()
	if elapsed < 10*time::Nanosecond {
		panic("sleep timer fired earlier than expected")
	}
}

fn main() {
	checkTiming()
	checkDuration()
}