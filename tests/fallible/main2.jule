fn single(x: int)!: int {
	if x < 0 {
		throw "foo"
	}
	return x
}

fn singleRetTest()!: int {
	return single(89)!
}

fn singleRetTest1()!: int {
	return single(89) catch { throw error }
}
fn singleRetTest1F()!: int {
	return single(89)?
}

fn singleRetTest2()!: int {
	return single(-1) catch { throw error }
}
fn singleRetTest2F()!: int {
	return single(-1)?
}

fn singleRetTest3()!: int {
	return single(-1) catch { use 90 }
}

fn singleRetTest4()!: int {
	return single(-1) catch { return 34 }
}

fn singleRetTest5()!: int {
	return single(-1) catch {
		use single(-1) catch {
			use single(28)!
		}
	}
}

fn singleRetTest6()!: int {
	return single(-1) catch {
		return single(-1) catch {
			return single(28)!
		}
	}
}

fn init() {
	{
		x := singleRetTest() catch {
			panic("singleRetTest throws error")
		}
		if x != 89 {
			panic("x != 89")
		}
	}
	{
		x := singleRetTest1() catch {
			panic("singleRetTest1 throws error")
		}
		if x != 89 {
			panic("x != 89")
		}
	}
	{
		x := singleRetTest1F() catch {
			panic("singleRetTest1F throws error")
		}
		if x != 89 {
			panic("x != 89")
		}
	}
	{
		singleRetTest2() catch {
			goto SRT2
		}
		panic("singleRetTest2 returns without error, expected error")
	SRT2:
	}
	{
		singleRetTest2F() catch {
			goto SRT2F
		}
		panic("singleRetTest2F returns without error, expected error")
	SRT2F:
	}
	{
		x := singleRetTest3() catch {
			panic("singleRetTest3 throws error")
		}
		if x != 90 {
			panic("x != 90")
		}
	}
	{
		x := singleRetTest4() catch {
			panic("singleRetTest4 throws error")
		}
		if x != 34 {
			panic("x != 34")
		}
	}
	{
		x := singleRetTest5() catch {
			panic("singleRetTest5 throws error")
		}
		if x != 28 {
			panic("x != 28")
		}
	}
	{
		x := singleRetTest6() catch {
			panic("singleRetTest6 throws error")
		}
		if x != 28 {
			panic("x != 28")
		}
	}
	{
		mut x := single(923)!
		if x != 923 {
			panic("x != 923")
		}
		x = single(920)!
		if x != 920 {
			panic("x != 920")
		}
	}
	{
		mut x := single(-1) catch {
			use 10
		}
		if x != 10 {
			panic("x != 10")
		}
		x = single(-1) catch {
			use 20
		}
		if x != 20 {
			panic("x != 20")
		}
	}
	{
		mut x := single(14)!
		if x != 14 {
			panic("x != 14")
		}
		x += single(6)!
		if x != 20 {
			panic("x != 20")
		}
		x <<= single(1) catch {
			use 2
		}
		if x != 40 {
			panic("x != 40")
		}
		x <<= single(-1) catch {
			use 2
		}
		if x != 160 {
			panic("x != 160")
		}
		x <<= single(-1) catch {
			use 64
		}
		if x != 0 {
			panic("x != 0")
		}
	}
}

fn multi(x: int, y: int)!: (int, int) {
	if x < 0 || y < 0 {
		throw "foo"
	}
	return x, y
}

fn multiRetTest()!: (int, int) {
	return multi(98, 89)!
}

fn multiRetTest1()!: (int, int) {
	return multi(98, 89) catch { throw error }
}

fn multiRetTest2()!: (int, int) {
	return multi(-1, -1) catch { throw error }
}

fn multiRetTest3()!: (int, int) {
	return multi(-1, -1) catch { use 90, 20 }
}

fn multiRetTest4()!: (int, int) {
	return multi(-1, -1) catch { return 34, 43 }
}

fn multiRetTest5()!: (int, int) {
	return multi(-1, -1) catch {
		use multi(-1, -1) catch {
			use multi(82, 28)!
		}
	}
}

fn multiRetTest6()!: (int, int) {
	return multi(-1, -1) catch {
		return multi(-1, -1) catch {
			return multi(82, 28)!
		}
	}
}

fn init() {
	{
		x, y := multiRetTest() catch {
			panic("multiRetTest throws error")
		}
		if x != 98 {
			panic("x != 98")
		}
		if y != 89 {
			panic("y != 89")
		}
	}
	{
		x, y := multiRetTest1() catch {
			panic("multiRetTest1 throws error")
		}
		if x != 98 {
			panic("x != 98")
		}
		if y != 89 {
			panic("y != 89")
		}
	}
	{
		multiRetTest2() catch {
			goto MRT2
		}
		panic("multiRetTest2 returns without error, expected error")
	MRT2:
	}
	{
		x, y := multiRetTest3() catch {
			panic("multiRetTest3 throws error")
		}
		if x != 90 {
			panic("x != 90")
		}
		if y != 20 {
			panic("x != 20")
		}
	}
	{
		x, y := multiRetTest4() catch {
			panic("multiRetTest4 throws error")
		}
		if x != 34 {
			panic("x != 34")
		}
		if y != 43 {
			panic("y != 43")
		}
	}
	{
		x, y := multiRetTest5() catch {
			panic("multiRetTest5 throws error")
		}
		if x != 82 {
			panic("x != 82")
		}
		if y != 28 {
			panic("y != 28")
		}
	}
	{
		x, y := multiRetTest6() catch {
			panic("multiRetTest6 throws error")
		}
		if x != 82 {
			panic("x != 82")
		}
		if y != 28 {
			panic("y != 28")
		}
	}
	{
		mut x, mut y := multi(923, 89)!
		if x != 923 {
			panic("x != 923")
		}
		if y != 89 {
			panic("y != 89")
		}
		x, y = multi(920, 98)!
		if x != 920 {
			panic("x != 920")
		}
		if y != 98 {
			panic("y != 98")
		}
	}
	{
		mut x, mut y := multi(-1, -1) catch {
			use 10, 20
		}
		if x != 10 {
			panic("x != 10")
		}
		if y != 20 {
			panic("x != 20")
		}
		x, y = multi(-1, -1) catch {
			use 50, 100
		}
		if x != 50 {
			panic("x != 50")
		}
		if y != 100 {
			panic("x != 100")
		}
	}
}