use "std/math"

fn successVoid()! {
	println("success void")
}

fn failVoid()! {
	throw "not implemented"
}

fn successRet()!: int {
	return 20
}

fn failRet()!: int {
	throw "not implemented"
}

fn successRet1()!: (a: int) {
	a = 40
	return
}

fn failRet1()!: (a: f64) {
	throw "not implemented"
}

fn successRet2()!: (a: int, b: int) {
	a = 40
	b = 50
	return
}

fn failRet2()!: (a: int, b: int) {
	throw "not implemented"
}

fn err()! { throw "bar" }

fn anonForward()! {
	fn()! {
		err()?
	}()?
}

fn anonForward1()! {
	fn()! {
		err() catch { throw error }
	}()?
}

fn closureForward()! {
	fn()! {
		err()?
	}() catch {
		fn()! {
			throw error
		}()?
	}
}

fn closureForward1()! {
	fn()! {
		throw "cf1"
	}() catch {
		fn()! {
			err() catch {
				throw error
			}
		}()?
	}
}

fn closureForward2()! {
	fn()! {
		throw "cf2"
	}() catch {
		fn()! {
			throw error
		}()?
	}
}

let mut deferWorks = false

fn deferTestForwarding()!: (x: int) {
	defer {
		deferWorks = true
	}
	return fn()!: int {
		throw "arbitrary error"
	}() catch {
		throw error
	}
}

fn init() {
	deferTestForwarding() catch {}
	if !deferWorks {
		panic("deferred call did not executed")
	}

	// Test dynamic-type handling.
	let mut x: any
	x = successRet()!
	x = failRet() catch {
		use 20
	}

	// Test integer arithmetic assignment.
	let mut z: int = 30
	z += failRet() catch { use 20 }
	if z != 50 {
		panic("expected 50")
	}

	// Test float arithmetic assignment.
	let mut k: f64 = 30
	k /= failRet1() catch { use 0 }
	if k != math::Inf(+1) {
		panic("expected +Inf")
	}
}

fn main() {
	successVoid() catch {
		panic("successVoid failed, should be success")
	}
	failVoid() catch {
		println("handled error of failVoid")
	}

	successRet() catch {
		panic("successRet failed, should be success")
	}
	failRet() catch {
		println("handled error of failRet")
	}

	successRet1() catch {
		panic("successRet1 failed, should be success")
	}
	failRet1() catch {
		println("handled error of failRet1")
	}

	successRet2() catch {
		panic("success_ret2 failed, should be success")
	}
	failRet2() catch {
		println("handled error of failRet2")
	}

	anonForward() catch {
		if error != "bar" {
			panic("expected \"bar\"")
		}
		goto AF
	}
	panic("expected error for anonForward")
AF:
	anonForward1() catch {
		if error != "bar" {
			panic("expected \"bar\"")
		}
		goto AF1
	}
	panic("expected error for anonForward1")
AF1:
	closureForward() catch {
		if error != "bar" {
			panic("expected \"bar\"")
		}
		goto CF
	}
	panic("expected error for closureForward")
CF:
	closureForward1() catch {
		if error != "bar" {
			panic("expected \"bar\"")
		}
		goto CF1
	}
	panic("expected error for closureForward1")
CF1:
	closureForward2() catch {
		if error != "cf2" {
			panic("expected \"bar\"")
		}
		goto CF2
	}
	panic("expected error for closureForward2")
CF2:
}